def train_model_on_traffic(
    model_name,
    traffic_type
):

    print("\n" + "=" * 78)

    print(
        f"TRAINING MODEL: {model_name} | "
        f"TRAFFIC TYPE: {traffic_type}"
    )

    print("=" * 78)


    # --------------------------------------------------------
    # Establish an experiment-specific seed.
    # --------------------------------------------------------

    model_index = MODELS.index(model_name)

    experiment_seed = (

        SEED

        + 1000 * traffic_type

        + 100 * model_index

    )

    set_experiment_seed(
        experiment_seed
    )


    # --------------------------------------------------------
    # Create independent environment.
    # --------------------------------------------------------

    environment = create_training_environment(

        traffic_type=traffic_type,

        experiment_seed=experiment_seed

    )


    # --------------------------------------------------------
    # Create an independent DDQN agent.
    # --------------------------------------------------------

    agent = DDQNAgent(

        model_name=model_name,

        state_dim=STATE_DIM,

        num_actions=NUM_ACTIONS,

        learning_rate=LEARNING_RATE,

        gamma=GAMMA,

        batch_size=BATCH_SIZE,

        target_update_frequency=TARGET_UPDATE_FREQUENCY,

        epsilon_start=EPSILON_START,

        epsilon_end=EPSILON_END,

        epsilon_decay=EPSILON_DECAY,

        device=DEVICE

    )


    # --------------------------------------------------------
    # Episode history.
    # --------------------------------------------------------

    experiment_history = []


    # --------------------------------------------------------
    # Execute training episodes.
    # --------------------------------------------------------

    for episode in range(

        1,

        NUM_EPISODES + 1

    ):


        episode_result = train_one_episode(

            agent=agent,

            environment=environment,

            episode_number=episode

        )


        # Attach experiment identifiers.

        episode_result["model"] = model_name

        episode_result["traffic_type"] = traffic_type


        # Save episode history.

        experiment_history.append(
            episode_result
        )


        # ----------------------------------------------------
        # Decay epsilon once per episode.
        # ----------------------------------------------------

        agent.decay_epsilon()


        # ----------------------------------------------------
        # Display training progress.
        # ----------------------------------------------------

        if (

            episode == 1

