import numpy as np
import pandas as pd

from dataclasses import dataclass


# ------------------------------------------------------------
# 5.2: TRAFFIC-SPECIFIC QoS CONFIGURATION
# ------------------------------------------------------------

# Traffic demands and latency limits are simulation
# requirements, not measured dataset throughput values.

TRAFFIC_REQUIREMENTS = {

    1: {
        "demand_mbps": 2.0,
        "latency_limit_ms": 50.0
    },

    2: {
        "demand_mbps": 5.0,
        "latency_limit_ms": 20.0
    },

    3: {
        "demand_mbps": 10.0,
        "latency_limit_ms": 10.0
    }

}


# ------------------------------------------------------------
# 5.3: ENVIRONMENT FEATURE CONFIGURATION
# ------------------------------------------------------------

NOISE_FLOOR_DBM = -100.0

MIN_SIGNAL_DBM = -120.0

MAX_SIGNAL_DBM = -60.0

MIN_PACKET_LOSS = 0.0

MAX_PACKET_LOSS = 100.0

MAX_NETWORK_UTILIZATION = 100.0

MAX_EPISODE_STEPS = 100

MAX_LATENCY_MS = 100.0

MAX_THROUGHPUT_MULTIPLIER = 2.0


# ------------------------------------------------------------
# 5.4: ENVIRONMENT RESULT STRUCTURE
# ------------------------------------------------------------

@dataclass
class StepResult:

    next_state: np.ndarray

    reward: float

    done: bool

    info: dict


# ------------------------------------------------------------
# 5.5: RADIO RESOURCE ENVIRONMENT
# ------------------------------------------------------------

class RadioResourceEnvironment:

    def __init__(
        self,
        traffic_type,
        dataset,
        seed=SEED
    ):

        # ----------------------------------------------------
        # Validate traffic type.
        # ----------------------------------------------------

        if traffic_type not in TRAFFIC_TYPES:

            raise ValueError(
                f"Unsupported traffic type: {traffic_type}"
            )


        if dataset is None or len(dataset) == 0:

            raise ValueError(
                f"Empty dataset for traffic type {traffic_type}"
            )


        self.traffic_type = traffic_type

        self.dataset = dataset.reset_index(
            drop=True
        ).copy()


        self.rng = np.random.default_rng(
            seed + traffic_type
        )


        # Traffic-specific requirements.

        self.requirements = TRAFFIC_REQUIREMENTS[
            traffic_type
        ]

        self.demand_mbps = self.requirements[
            "demand_mbps"
        ]

        self.latency_limit_ms = self.requirements[
            "latency_limit_ms"
        ]


        # Radio configuration.

        self.total_rbs = TOTAL_RBS

        self.total_power = TOTAL_POWER_BUDGET

        self.rb_bandwidth_mhz = (

            SUBCARRIERS_PER_RB
            * SUBCARRIER_SPACING_KHZ
            / 1000.0

        )


        # Episode configuration.

        self.max_steps = MAX_EPISODE_STEPS

        self.state_dim = STATE_DIM

        self.num_actions = NUM_ACTIONS


        # Required dataset columns.

        self.required_columns = [

            "Traffic Load (bps)",

            "Network Utilization (%)",

            "Latency (ms)",

            "Packet Loss Rate (%)",

            "Signal Strength (dBm)"

        ]


        missing_columns = [

            column

            for column in self.required_columns

            if column not in self.dataset.columns

        ]


        if missing_columns:

            raise KeyError(
                f"Missing environment columns: {missing_columns}"
            )


        # Internal episode variables.

        self.current_step = 0

        self.current_row = None

        self.remaining_rbs = self.total_rbs

        self.last_throughput_mbps = 0.0

        self.last_latency_ms = 0.0

        self.episode_reward = 0.0

        self.episode_throughput = []

        self.episode_latency = []


    # --------------------------------------------------------
    # 5.5.1: SAFE NUMERIC CONVERSION
    # --------------------------------------------------------

    @staticmethod
    def safe_numeric(value, default=0.0):

        try:

            result = float(value)

            if not np.isfinite(result):

                return float(default)

            return result

        except (TypeError, ValueError):

            return float(default)


    # --------------------------------------------------------
    # 5.5.2: NORMALIZE ENVIRONMENT FEATURES
    # --------------------------------------------------------

    def get_environment_features(self, row):

        signal_dbm = self.safe_numeric(
            row["Signal Strength (dBm)"],
            default=-100.0
        )

        network_utilization = self.safe_numeric(
            row["Network Utilization (%)"],
            default=0.0
        )

        packet_loss = self.safe_numeric(
            row["Packet Loss Rate (%)"],
            default=0.0
        )

        measured_latency = self.safe_numeric(
            row["Latency (ms)"],
            default=0.0
        )

        traffic_load = self.safe_numeric(
            row["Traffic Load (bps)"],
            default=0.0
        )


        # Channel quality: normalized to [0, 1].

        channel_quality = np.clip(

            (
                signal_dbm - MIN_SIGNAL_DBM
            ) / (
                MAX_SIGNAL_DBM - MIN_SIGNAL_DBM
            ),

            0.0,

            1.0

        )


        # Background network utilization.

        background_load = np.clip(

            network_utilization
            / MAX_NETWORK_UTILIZATION,

            0.0,

            1.0

        )


        # Packet-loss factor.

        packet_loss_factor = np.clip(

            packet_loss
            / MAX_PACKET_LOSS,

            0.0,

            1.0

        )


        # Normalize observed latency for state representation.

        latency_pressure = np.clip(

            measured_latency
            / self.latency_limit_ms,

            0.0,

            MAX_LATENCY_MS
            / self.latency_limit_ms

        )


        # Dataset traffic load is used to characterize
        # the background traffic environment.

        normalized_load = np.clip(

            traffic_load / 1e9,

            0.0,

            1.0

        )


        return {

            "channel_quality": float(channel_quality),

            "background_load": float(background_load),

            "packet_loss_factor": float(packet_loss_factor),

            "latency_pressure": float(latency_pressure),

            "normalized_load": float(normalized_load)

        }


    # --------------------------------------------------------
    # 5.5.3: CONSTRUCT THE 12-DIMENSIONAL STATE
    # --------------------------------------------------------

    def get_state(self):

        if self.current_row is None:

            raise RuntimeError(
                "Environment must be reset before obtaining state."
            )


        features = self.get_environment_features(
            self.current_row
        )


        # Traffic-type one-hot representation.

        traffic_one_hot = [

            1.0 if self.traffic_type == traffic else 0.0

            for traffic in TRAFFIC_TYPES

        ]


        # Normalized traffic demand.

        normalized_demand = (

            self.demand_mbps / 10.0

        )


        # Normalized latency requirement.

        normalized_latency_limit = (

            self.latency_limit_ms / 50.0

        )


        # Remaining RB and bandwidth fractions.

        remaining_rb_fraction = (

            self.remaining_rbs / self.total_rbs

        )


        remaining_bandwidth_fraction = (

            remaining_rb_fraction

        )


        # Power availability per transmission decision.
        # Power is constrained independently in each
        # 1-ms transmission interval.

        remaining_power_fraction = 1.0


        state = np.array(

            traffic_one_hot

            + [

                features["channel_quality"],

                normalized_demand,

                normalized_latency_limit,

                features["background_load"],

                features["packet_loss_factor"],

                features["latency_pressure"],

                remaining_rb_fraction,

                remaining_power_fraction,

                remaining_bandwidth_fraction

            ],

            dtype=np.float32

        )


        if state.shape != (STATE_DIM,):

            raise ValueError(

                f"Invalid state shape: {state.shape}. "

                f"Expected ({STATE_DIM},)."

            )


        if not np.isfinite(state).all():

            raise ValueError(
                "State contains non-finite values."
            )


        return state


    # --------------------------------------------------------
    # 5.5.4: CALCULATE SIMULATED RADIO THROUGHPUT
    # --------------------------------------------------------

    def calculate_throughput(
        self,
        allocated_rbs,
        allocated_power
    ):

        features = self.get_environment_features(
            self.current_row
        )


        signal_dbm = self.safe_numeric(

            self.current_row["Signal Strength (dBm)"],

            default=-100.0

        )


        # Effective SNR in dB.
        #
        # The power adjustment is referenced to 4 W.

        power_adjustment_db = (

            10.0 * np.log10(
                max(allocated_power, 1e-8) / 4.0
            )

        )


        snr_db = (

            signal_dbm
            - NOISE_FLOOR_DBM
            + power_adjustment_db

        )


        # Convert SNR into linear scale.

        snr_linear = 10.0 ** (

            np.clip(snr_db, -20.0, 40.0)
            / 10.0

        )


        # Shannon spectral efficiency.

        spectral_efficiency = np.log2(

            1.0 + snr_linear

        )


        # Apply channel-quality-dependent efficiency.

        effective_efficiency = (

            spectral_efficiency
            * features["channel_quality"]

        )


        # Allocated bandwidth in MHz.

        allocated_bandwidth_mhz = (

            allocated_rbs
            * self.rb_bandwidth_mhz

        )


        # Simulated throughput in Mbps.

        throughput_mbps = (

            allocated_bandwidth_mhz
            * effective_efficiency

            * (1.0 - features["packet_loss_factor"])

        )


        return max(

            0.0,

            float(throughput_mbps)

        )


    # --------------------------------------------------------
    # 5.5.5: CALCULATE SIMULATED LATENCY
    # --------------------------------------------------------

    def calculate_latency(
        self,
        allocated_rbs,
        throughput_mbps
    ):

        features = self.get_environment_features(
            self.current_row
        )


        # Transmission and processing latency.

        transmission_latency = (

            1.0
            + 2.0 * (1.0 - features["channel_quality"])

        )


        # Queueing pressure due to background load.

        queueing_latency = (

            5.0
            * features["background_load"]
            / max(
                allocated_rbs / self.total_rbs,
                0.01
            )

        )


        # Insufficient service capacity increases latency.

        service_ratio = (

            throughput_mbps
            / max(self.demand_mbps, 1e-8)

        )


        service_penalty = (

            5.0
            * max(
                0.0,
                1.0 - service_ratio
            )

        )


        latency_ms = (

            transmission_latency
            + queueing_latency
            + service_penalty

        )


        return float(

            np.clip(
                latency_ms,
                0.1,
                MAX_LATENCY_MS
            )

        )


    # --------------------------------------------------------
    # 5.5.6: CALCULATE REWARD
    # --------------------------------------------------------

    def calculate_reward(
        self,
        throughput_mbps,
        allocated_rbs,
        allocated_power,
        latency_ms
    ):

        # Throughput satisfaction.

        throughput_satisfaction = np.clip(

            throughput_mbps
            / max(self.demand_mbps, 1e-8),

            0.0,

            1.0

        )


        # Normalized RB consumption.

        rb_cost = (

            allocated_rbs / 16.0

        )


        # Normalized transmission power consumption.

        power_cost = (

            allocated_power / 8.0

        )


        # Latency violation.

        latency_violation = max(

            0.0,

            latency_ms / self.latency_limit_ms - 1.0

        )


        # Established reward function.

        reward = (

            2.0 * throughput_satisfaction

            - 0.25 * rb_cost

            - 0.20 * power_cost

            - 0.50 * latency_violation

        )


        return float(reward)


    # --------------------------------------------------------
    # 5.5.7: RESET ENVIRONMENT
    # --------------------------------------------------------

    def reset(self):

        self.current_step = 0

        self.remaining_rbs = self.total_rbs

        self.last_throughput_mbps = 0.0

        self.last_latency_ms = 0.0

        self.episode_reward = 0.0

        self.episode_throughput = []

        self.episode_latency = []


        # Randomize the starting position of the
        # traffic-type-specific dataset.

        self.row_order = self.rng.permutation(
            len(self.dataset)
        )


        self.current_row = self.dataset.iloc[
            self.row_order[0]
        ]


        return self.get_state()


    # --------------------------------------------------------
    # 5.5.8: EXECUTE ONE RADIO RESOURCE ALLOCATION
    # --------------------------------------------------------

    def step(self, action_index):

        if not 0 <= action_index < self.num_actions:

            raise ValueError(
                f"Invalid action index: {action_index}"
            )


        # Decode action.

        allocated_rbs, allocated_power = ACTIONS[
            action_index
        ]


        # Advance the environment step.

        self.current_step += 1


        # ----------------------------------------------------
        # Invalid allocation handling.
        # ----------------------------------------------------

        if (

            allocated_rbs > self.remaining_rbs

            or allocated_power > self.total_power

        ):

            reward = -0.5

            throughput_mbps = 0.0

            latency_ms = MAX_LATENCY_MS

            success = False


        else:

            # Calculate simulated throughput.

            throughput_mbps = self.calculate_throughput(

                allocated_rbs,

                allocated_power

            )


            # Calculate simulated latency.

            latency_ms = self.calculate_latency(

                allocated_rbs,

                throughput_mbps

            )


            # Calculate reward.

            reward = self.calculate_reward(

                throughput_mbps,

                allocated_rbs,

                allocated_power,

                latency_ms

            )


            # Update RB budget.

            self.remaining_rbs -= allocated_rbs


            # Determine whether allocation satisfies QoS.

            success = (

                throughput_mbps >= self.demand_mbps

                and latency_ms <= self.latency_limit_ms

            )


        # ----------------------------------------------------
        # Update episode statistics.
        # ----------------------------------------------------

        self.last_throughput_mbps = throughput_mbps

        self.last_latency_ms = latency_ms

        self.episode_reward += reward

        self.episode_throughput.append(
            throughput_mbps
        )

        self.episode_latency.append(
            latency_ms
        )


        # ----------------------------------------------------
        # Select the next dataset record.
        # ----------------------------------------------------

        next_position = (

            self.current_step
            % len(self.dataset)

        )

        self.current_row = self.dataset.iloc[

            self.row_order[next_position]

        ]


        # ----------------------------------------------------
        # Determine episode termination.
        # ----------------------------------------------------

        done = (

            self.remaining_rbs <= 0

            or self.current_step >= self.max_steps

        )


        next_state = self.get_state()


        # ----------------------------------------------------
        # Return environment information.
        # ----------------------------------------------------

        info = {

            "traffic_type": self.traffic_type,

            "allocated_rbs": allocated_rbs,

            "allocated_power_w": allocated_power,

            "throughput_mbps": throughput_mbps,

            "latency_ms": latency_ms,

            "throughput_satisfaction": (

                min(
                    throughput_mbps
                    / max(self.demand_mbps, 1e-8),
                    1.0
                )

            ),

            "qos_success": success,

            "remaining_rbs": self.remaining_rbs,

            "reward": reward

        }


        return StepResult(

            next_state=next_state,

            reward=reward,

            done=done,

            info=info

        )


