# ------------------------------------------------------------
# 3.1: RADIAL BASIS FUNCTION (RBF)-DDQN
# ------------------------------------------------------------

class RBFQNetwork(nn.Module):

    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        num_centers=RBF_CENTERS,
        hidden_dim=HIDDEN_DIM
    ):

        super().__init__()

        # Fixed RBF centers.
        self.register_buffer(
            "centers",
            torch.randn(num_centers, state_dim)
        )

        # Learnable RBF width parameter.
        self.log_gamma = nn.Parameter(
            torch.tensor(4.0)
        )

        # Fully connected Q-value prediction layers.
        self.fc1 = nn.Linear(
            num_centers,
            128
        )

        self.fc2 = nn.Linear(
            128,
            hidden_dim
        )

        self.fc3 = nn.Linear(
            hidden_dim,
            num_actions
        )


    def forward(self, state):

        # Ensure state has shape:
        # [batch_size, state_dim]

        if state.dim() == 1:

            state = state.unsqueeze(0)


        # Calculate squared Euclidean distances
        # between states and RBF centers.

        distances = torch.sum(
            (
                state.unsqueeze(1)
                - self.centers.unsqueeze(0)
            ) ** 2,
            dim=2
        )


        # Positive gamma ensures a valid RBF width.

        gamma = (
            F.softplus(self.log_gamma)
            + 1e-8
        )


        # Generate RBF feature representations.

        rbf_features = torch.exp(
            -gamma * distances
        )


        # Estimate Q-values.

        x = F.relu(
            self.fc1(rbf_features)
        )

        x = F.relu(
            self.fc2(x)
        )

        q_values = self.fc3(x)

        return q_values


# ------------------------------------------------------------
# 3.2: CONVENTIONAL DDQN
# ------------------------------------------------------------

class DDQNQNetwork(nn.Module):

    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS
    ):

        super().__init__()

        self.fc1 = nn.Linear(
            state_dim,
            128
        )

        self.fc2 = nn.Linear(
            128,
            128
        )

        self.fc3 = nn.Linear(
            128,
            64
        )

        self.fc4 = nn.Linear(
            64,
            num_actions
        )


    def forward(self, state):

        if state.dim() == 1:

            state = state.unsqueeze(0)


        x = F.relu(
            self.fc1(state)
        )

        x = F.relu(
            self.fc2(x)
        )

        x = F.relu(
            self.fc3(x)
        )


        # Output one Q-value for every available action.

        q_values = self.fc4(x)

        return q_values


# ------------------------------------------------------------
# 3.3: GRAPH GENERATIVE NETWORK (GGN)-DDQN
# ------------------------------------------------------------

class GGNQNetwork(nn.Module):

    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM
    ):

        super().__init__()


        # Encode each state feature as a graph node.

        self.node_encoder = nn.Linear(
            1,
            hidden_dim
        )


        # Combine node representations with
        # aggregated neighboring representations.

        self.message_layer = nn.Linear(
            hidden_dim * 2,
            hidden_dim
        )


        # Graph-level Q-value prediction head.

        self.q_head = nn.Sequential(

            nn.Linear(
                hidden_dim,
                128
            ),

            nn.ReLU(),

            nn.Linear(
                128,
                num_actions
            )
        )


        # ----------------------------------------------------
        # Construct a deterministic chain graph.
        #
        # Each state feature is represented as one node.
        # Neighboring nodes are connected.
        # Self-connections are included.
        # ----------------------------------------------------

        adjacency = torch.eye(
            state_dim
        )


        for i in range(state_dim - 1):

            adjacency[i, i + 1] = 1.0

            adjacency[i + 1, i] = 1.0


        # Symmetric degree normalization.

        degree = adjacency.sum(
            dim=1
        ).clamp(min=1.0)


        inv_sqrt_degree = degree.pow(
            -0.5
        )


        normalized_adjacency = (

            inv_sqrt_degree.unsqueeze(1)

            * adjacency

            * inv_sqrt_degree.unsqueeze(0)

        )


        self.register_buffer(
            "adjacency",
            normalized_adjacency
        )


    def forward(self, state):

        if state.dim() == 1:

            state = state.unsqueeze(0)


        # Each state feature becomes a graph node.

        nodes = state.unsqueeze(-1)


        # Initial node representations.

        embeddings = F.relu(
            self.node_encoder(nodes)
        )


        # Aggregate neighboring node representations.

        neighbors = torch.matmul(
            self.adjacency,
            embeddings
        )


        # Message passing.

        updated = torch.cat(
            [
                embeddings,
                neighbors
            ],
            dim=-1
        )


        updated = F.relu(
            self.message_layer(updated)
        )


        # Mean graph pooling.

        graph_embedding = updated.mean(
            dim=1
        )


        # Estimate action values.

        q_values = self.q_head(
            graph_embedding
        )

        return q_values


# ------------------------------------------------------------
# 3.4: GRAPH CONVOLUTIONAL NETWORK (GCN)-DDQN
# ------------------------------------------------------------

class GCNQNetwork(nn.Module):

    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM
    ):

        super().__init__()


        # Project each scalar state feature
        # into a hidden-dimensional node representation.

        self.input_projection = nn.Linear(
            1,
            hidden_dim
        )


        # Two graph convolution layers.

        self.gcn1 = nn.Linear(
            hidden_dim,
            hidden_dim
        )

        self.gcn2 = nn.Linear(
            hidden_dim,
            hidden_dim
        )


        # Q-value prediction head.

        self.q_head = nn.Sequential(

            nn.Linear(
                hidden_dim,
                128
            ),

            nn.ReLU(),

            nn.Linear(
                128,
                num_actions
            )
        )


        # ----------------------------------------------------
        # Construct the same normalized chain graph
        # used by GGN-DDQN.
        # ----------------------------------------------------

        adjacency = torch.eye(
            state_dim
        )


        for i in range(state_dim - 1):

            adjacency[i, i + 1] = 1.0

            adjacency[i + 1, i] = 1.0


        degree = adjacency.sum(
            dim=1
        ).clamp(min=1.0)


        inv_sqrt_degree = degree.pow(
            -0.5
        )


        normalized_adjacency = (

            inv_sqrt_degree.unsqueeze(1)

            * adjacency

            * inv_sqrt_degree.unsqueeze(0)

        )


        self.register_buffer(
            "adjacency",
            normalized_adjacency
        )


    def forward(self, state):

        if state.dim() == 1:

            state = state.unsqueeze(0)


        # Convert each state feature into a graph node.

        nodes = state.unsqueeze(-1)


        # Initial node projection.

        x = F.relu(
            self.input_projection(nodes)
        )


        # First graph convolution.

        x = torch.matmul(
            self.adjacency,
            x
        )

        x = F.relu(
            self.gcn1(x)
        )


        # Second graph convolution.

        x = torch.matmul(
            self.adjacency,
            x
        )

        x = F.relu(
            self.gcn2(x)
        )


        # Mean graph pooling.

        graph_embedding = x.mean(
            dim=1
        )


        # Estimate Q-values.

        q_values = self.q_head(
            graph_embedding
        )

        return q_values


# ------------------------------------------------------------
# 3.5: NETWORK FACTORY
# ------------------------------------------------------------

# The factory allows Block 4 to create the correct
# architecture using only the model name.

NETWORK_FACTORIES = {

    "RBF-DDQN": lambda: RBFQNetwork(),

    "DDQN": lambda: DDQNQNetwork(),

