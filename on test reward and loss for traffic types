                f"Loss: "
                f"{episode_result['episode_loss']:.6f} | "

                f"Updates: "
                f"{episode_result['optimization_updates']:4d} | "

                f"Epsilon: "
                f"{agent.epsilon:.4f}"

            )


    # --------------------------------------------------------
    # Convert experiment history to DataFrame.
    # --------------------------------------------------------

    history_df = pd.DataFrame(
