# ------------------------------------------------------------
# 8.2. Plot configuration
# ------------------------------------------------------------

LOSS_SMOOTHING_WINDOW = 10
EPISODE_TICK_INTERVAL = 20
MARKER_INTERVAL = 20

plt.rcParams.update({
    "font.family": "Times New Roman",
    "font.size": 16,
    "axes.labelsize": 17,
    "xtick.labelsize": 15,
    "ytick.labelsize": 15,
    "legend.fontsize": 17,
    "lines.linewidth": 2.2,
    "axes.linewidth": 1.2,
    "savefig.dpi": 600,
    "ps.fonttype": 42,
    "pdf.fonttype": 42,
})

MODEL_STYLES = {
    "RBF-DDQN": {"linestyle": "-", "marker": "o"},
    "DDQN": {"linestyle": "--", "marker": "s"},
    "GGN-DDQN": {"linestyle": "-.", "marker": "^"},
    "GCN-DDQN": {"linestyle": ":", "marker": "D"},
}

# ------------------------------------------------------------
# 8.3. Verify experiment availability
# ------------------------------------------------------------

expected_experiments = {
    (model, traffic)
    for traffic in TRAFFIC_TYPES
    for model in MODELS
}

missing_experiments = (
    expected_experiments - set(training_histories.keys())
)

if missing_experiments:
    raise RuntimeError(
        f"Missing training experiments: {sorted(missing_experiments)}"
    )

print("All 12 training experiments are available.")

# ------------------------------------------------------------
# 8.4. Prepare output directories
# ------------------------------------------------------------

LOSS_FIGURE_DIR = FIGURE_DIR / "Training_Loss"
LOSS_CSV_DIR = CSV_DIR / "Training_Loss"

LOSS_FIGURE_DIR.mkdir(parents=True, exist_ok=True)
LOSS_CSV_DIR.mkdir(parents=True, exist_ok=True)

# ------------------------------------------------------------
# 8.5. Extract and smooth actual optimization losses
# ------------------------------------------------------------

loss_plot_data = []

for traffic_type in TRAFFIC_TYPES:

    for model_name in MODELS:

        history_df = pd.DataFrame(
            training_histories[(model_name, traffic_type)]
        )

        required_columns = [
            "episode",
            "episode_loss",
            "optimization_updates"
        ]

        missing = [
            col for col in required_columns
            if col not in history_df.columns
        ]

        if missing:
            raise KeyError(
                f"{model_name}, traffic {traffic_type}: "
                f"Missing columns {missing}"
            )

        history_df = (
            history_df.sort_values("episode")
            .reset_index(drop=True)
        )

        loss = pd.to_numeric(
            history_df["episode_loss"],
            errors="coerce"
        )

        valid_loss = loss.dropna()

        if valid_loss.empty:
            raise ValueError(
                f"No valid optimization losses for "
                f"{model_name}, traffic {traffic_type}."
            )

        if not np.isfinite(valid_loss).all():
            raise ValueError(
                f"Non-finite loss values for "
                f"{model_name}, traffic {traffic_type}."
            )

        if (valid_loss < 0).any():
            raise ValueError(
                f"Negative loss values for "
                f"{model_name}, traffic {traffic_type}."
            )

        # Moving average ignores episodes without updates.
        smoothed_loss = loss.rolling(
            window=LOSS_SMOOTHING_WINDOW,
            min_periods=1
        ).mean()

        for i in range(len(history_df)):

            current_loss = loss.iloc[i]
            current_smoothed_loss = smoothed_loss.iloc[i]

            loss_plot_data.append({
                "traffic_type": traffic_type,
                "model": model_name,
                "model_label": MODEL_LABELS[model_name],
                "episode": int(history_df.loc[i, "episode"]),
                "episode_loss": (
                    float(current_loss)
                    if pd.notna(current_loss)
                    else np.nan
                ),
                "smoothed_episode_loss": (
                    float(current_smoothed_loss)
                    if pd.notna(current_smoothed_loss)
                    else np.nan
                ),
                "optimization_updates": int(
                    history_df.loc[i, "optimization_updates"]
                )
            })

loss_plot_df = pd.DataFrame(loss_plot_data)

# Save loss data.
loss_data_path = (
    LOSS_CSV_DIR /
    "all_models_all_traffic_types_loss_data.csv"
)

loss_plot_df.to_csv(loss_data_path, index=False)

print("Loss data saved:", loss_data_path)

# ------------------------------------------------------------
# 8.6. Plot loss for each traffic type
# ------------------------------------------------------------

for traffic_type in TRAFFIC_TYPES:

    fig, ax = plt.subplots(figsize=(9, 5.8))

    traffic_df = loss_plot_df[
        loss_plot_df["traffic_type"] == traffic_type
    ]

    for model_name in MODELS:

        model_df = traffic_df[
            traffic_df["model"] == model_name
        ].sort_values("episode")

        valid_model_df = model_df.dropna(
            subset=["smoothed_episode_loss"]
        )

        if valid_model_df.empty:
            continue

        style = MODEL_STYLES[model_name]

        ax.plot(
            valid_model_df["episode"],
            valid_model_df["smoothed_episode_loss"],
            label=MODEL_LABELS[model_name],
            linestyle=style["linestyle"],
            marker=style["marker"],
            markevery=MARKER_INTERVAL,
            markersize=6,
            linewidth=2.2
        )

    # Axis labels.
    ax.set_xlabel(
        "Training Episode",
        fontweight="bold"
    )

    # Traffic-type-specific y-axis label.
    traffic_label = f"TP{traffic_type}"

    ax.set_ylabel(
        f"Training Loss ({traffic_label})",
        fontweight="bold",
        labelpad=10
    )

    # X-axis limits and evenly spaced episode labels.
    ax.set_xlim(0, NUM_EPISODES)

    ax.xaxis.set_major_locator(
        MultipleLocator(EPISODE_TICK_INTERVAL)
    )

    ax.xaxis.set_major_formatter(
        FormatStrFormatter("%d")
    )

    # Loss is non-negative.
    ax.set_ylim(bottom=0)

    ax.grid(
        True,
        linestyle="--",
        linewidth=0.7,
        alpha=0.4
    )

    # Legend above the plotting area.
    ax.legend(
        loc="lower center",
        bbox_to_anchor=(0.5, 1.02),
        ncol=4,
        frameon=False,
        handlelength=2.5,
        columnspacing=1.2
    )

    ax.tick_params(
        axis="both",
        direction="in",
        length=5,
        width=1.1,
        pad=7
    )

    plt.setp(
        ax.get_xticklabels(),
        rotation=0,
        ha="center"
    )

    fig.tight_layout(
        rect=[0, 0, 1, 0.92]
    )

    # Save figures.
    png_path = (
        LOSS_FIGURE_DIR /
        f"loss_traffic_type_{traffic_type}.png"
    )

    eps_path = (
        LOSS_FIGURE_DIR /
        f"loss_traffic_type_{traffic_type}.eps"
    )

    fig.savefig(
        png_path,
        dpi=600,
        bbox_inches="tight"
    )

    fig.savefig(
        eps_path,
        format="eps",
        dpi=600,
        bbox_inches="tight"
    )

    plt.show()
    plt.close(fig)

    print(f"Traffic type {traffic_type} loss figures saved.")
    print("PNG:", png_path)
    print("EPS:", eps_path)

