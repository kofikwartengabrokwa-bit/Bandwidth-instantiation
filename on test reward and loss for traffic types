            )


        print(

            f"{model_name:12s} | "

            f"Action: {action:2d} | "

            f"Epsilon: {agent.epsilon:.3f} | "

            f"Replay: {len(agent.replay_buffer):4d} | "

            f"Device: {agent.device}"

        )


    print("\nAll four DDQN agents passed verification.")


