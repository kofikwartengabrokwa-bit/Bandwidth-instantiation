# ------------------------------------------------------------
# 6.6: SINGLE-EPISODE TRAINING FUNCTION
# ------------------------------------------------------------

def train_one_episode(
    agent,
    environment,
    episode_number
):

    # Reset environment.

    state = environment.reset()


    # Episode-specific statistics.

    episode_reward = 0.0

    episode_losses = []

    throughput_values = []

    latency_values = []

    successful_allocations = 0

    total_allocations = 0

    total_allocated_rbs = 0

    total_allocated_power = 0.0

    optimization_updates = 0


    done = False


    # --------------------------------------------------------
    # Interact with the environment until termination.
    # --------------------------------------------------------

    while not done:

        # Select action using epsilon-greedy policy.

        action = agent.select_action(
            state,
            evaluate=False
        )


        # Execute selected radio resource allocation.

        result = environment.step(
            action
        )


        next_state = result.next_state

        reward = result.reward

        done = result.done


        # ----------------------------------------------------
        # Store transition in independent replay buffer.
        # ----------------------------------------------------

        agent.remember(

            state,

            action,

            reward,

            next_state,

            done

        )


        # ----------------------------------------------------
        # Optimize online network using Double DQN.
        # ----------------------------------------------------

        loss = agent.learn()


        # Record only actual optimization losses.

        if loss is not None:

            if np.isfinite(loss):

                episode_losses.append(loss)

                optimization_updates += 1


        # ----------------------------------------------------
        # Accumulate episode statistics.
        # ----------------------------------------------------

        episode_reward += reward

        throughput_values.append(

            result.info["throughput_mbps"]

        )

        latency_values.append(

            result.info["latency_ms"]

        )

        successful_allocations += int(

            result.info["qos_success"]

        )

        total_allocations += 1

        total_allocated_rbs += (

            result.info["allocated_rbs"]

        )

        total_allocated_power += (

            result.info["allocated_power_w"]

        )


        # Move to the next state.

        state = next_state


    # --------------------------------------------------------
    # Calculate episode-level metrics.
    # --------------------------------------------------------

    average_reward = (

        episode_reward / max(total_allocations, 1)

    )


    average_loss = (

        float(np.mean(episode_losses))

        if len(episode_losses) > 0

        else np.nan

    )


    average_throughput = (

        float(np.mean(throughput_values))

        if len(throughput_values) > 0

        else 0.0

    )


    average_latency = (

        float(np.mean(latency_values))

        if len(latency_values) > 0

        else 0.0

    )


    qos_success_rate = (

        successful_allocations
        / max(total_allocations, 1)

    )


    average_allocated_rbs = (

        total_allocated_rbs
        / max(total_allocations, 1)

    )


    average_allocated_power = (

        total_allocated_power
        / max(total_allocations, 1)

    )


    # --------------------------------------------------------
    # Return actual episode results.
    # --------------------------------------------------------

    episode_result = {

        "episode": episode_number,

        "episode_reward": float(episode_reward),

        "average_episode_reward": float(average_reward),

        "episode_loss": average_loss,

        "optimization_updates": optimization_updates,

        "epsilon": float(agent.epsilon),

        "episode_steps": total_allocations,

        "average_throughput_mbps": average_throughput,

        "average_latency_ms": average_latency,

        "qos_success_rate": qos_success_rate,

        "average_allocated_rbs": average_allocated_rbs,

        "average_allocated_power_w": average_allocated_power

    }


    return episode_result


