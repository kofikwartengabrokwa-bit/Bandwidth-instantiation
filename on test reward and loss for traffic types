    # Store trained agent independently.

    trained_agents[experiment_key] = agent


    # Store environment.

    training_environments[experiment_key] = environment


    # --------------------------------------------------------
    # Save individual experiment history.
    # --------------------------------------------------------

    history_filename = (

        f"{model_name.replace('-', '_')}"
        f"_traffic_type_{traffic_type}"
        f"_training_history.csv"

    )


