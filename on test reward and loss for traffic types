#   - Epsilon value
#   - Learning-step counter
# ============================================================

import random
from collections import deque

import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim


# ------------------------------------------------------------
# 4.1: EXPERIENCE REPLAY BUFFER
# ------------------------------------------------------------

class ReplayBuffer:

    def __init__(self, capacity=REPLAY_BUFFER_SIZE):

        self.buffer = deque(
            maxlen=capacity
        )


    # --------------------------------------------------------
    # Store one transition
    # --------------------------------------------------------

    def push(
        self,
        state,
        action,
        reward,
        next_state,
        done
    ):

        self.buffer.append(

            (
                np.asarray(
                    state,
                    dtype=np.float32
                ).copy(),

                int(action),

                float(reward),

                np.asarray(
                    next_state,
                    dtype=np.float32
                ).copy(),

                float(done)
            )

        )


    # --------------------------------------------------------
    # Sample a random mini-batch
    # --------------------------------------------------------

    def sample(self, batch_size):

        batch = random.sample(
            self.buffer,
            batch_size
        )


        states, actions, rewards, next_states, dones = zip(
            *batch
        )


        return (

            torch.as_tensor(
                np.asarray(states),
                dtype=torch.float32
            ),

            torch.as_tensor(
                actions,
                dtype=torch.long
            ),

            torch.as_tensor(
                rewards,
                dtype=torch.float32
            ),

            torch.as_tensor(
                np.asarray(next_states),
                dtype=torch.float32
            ),

            torch.as_tensor(
                dones,
                dtype=torch.float32
            )

        )


    def __len__(self):

        return len(self.buffer)


# ------------------------------------------------------------
# 4.2: DOUBLE DEEP Q-NETWORK AGENT
# ------------------------------------------------------------

class DDQNAgent:

    def __init__(
        self,
        model_name,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        learning_rate=LEARNING_RATE,
        gamma=GAMMA,
        batch_size=BATCH_SIZE,
        target_update_frequency=TARGET_UPDATE_FREQUENCY,
        epsilon_start=EPSILON_START,
        epsilon_end=EPSILON_END,
        epsilon_decay=EPSILON_DECAY,
        device=None
    ):

        # Validate model name.

        if model_name not in NETWORK_FACTORIES:

            raise ValueError(
                f"Unknown model '{model_name}'. "
                f"Available models: {list(NETWORK_FACTORIES)}"
            )


        self.model_name = model_name

        self.state_dim = state_dim

        self.num_actions = num_actions

        self.gamma = gamma

        self.batch_size = batch_size

        self.target_update_frequency = target_update_frequency


        # ----------------------------------------------------
        # Epsilon-greedy exploration parameters
        # ----------------------------------------------------

        self.epsilon = epsilon_start

        self.epsilon_end = epsilon_end

        self.epsilon_decay = epsilon_decay


        # ----------------------------------------------------
        # Computational device
        # ----------------------------------------------------

        self.device = torch.device(

            device or (
                "cuda"
                if torch.cuda.is_available()
                else "cpu"
            )

        )


        # ----------------------------------------------------
        # Online and target Q-networks
        # ----------------------------------------------------

        self.online_network = NETWORK_FACTORIES[
            model_name
        ]().to(self.device)


        self.target_network = NETWORK_FACTORIES[
            model_name
        ]().to(self.device)


        # Initially synchronize target and online networks.

        self.target_network.load_state_dict(
            self.online_network.state_dict()
        )

        self.target_network.eval()


        # ----------------------------------------------------
        # Optimizer
        # ----------------------------------------------------

        self.optimizer = optim.Adam(

            self.online_network.parameters(),

            lr=learning_rate

        )


        # ----------------------------------------------------
        # Loss function
        # ----------------------------------------------------

        self.loss_function = nn.SmoothL1Loss()


        # ----------------------------------------------------
        # Independent replay buffer
        # ----------------------------------------------------

        self.replay_buffer = ReplayBuffer(

            capacity=REPLAY_BUFFER_SIZE

        )


        # Count actual optimization steps.

        self.learn_steps = 0


    # --------------------------------------------------------
    # 4.2.1: EPSILON-GREEDY ACTION SELECTION
    # --------------------------------------------------------

    def select_action(
        self,
        state,
        evaluate=False
    ):

        # Exploration during training.

        if (
            not evaluate
            and random.random() < self.epsilon
        ):

            return random.randrange(
                self.num_actions
            )


        # Convert state into a PyTorch tensor.

        state_tensor = torch.as_tensor(

            np.asarray(
                state,
                dtype=np.float32
            ),

            dtype=torch.float32,

            device=self.device

        ).unsqueeze(0)


        self.online_network.eval()


        with torch.no_grad():

            q_values = self.online_network(
                state_tensor
            )

            action = int(
                q_values.argmax(dim=1).item()
            )


        self.online_network.train()

        return action


    # --------------------------------------------------------
    # 4.2.2: STORE EXPERIENCE
    # --------------------------------------------------------

    def remember(
        self,
        state,
        action,
        reward,
        next_state,
        done
    ):

        self.replay_buffer.push(

            state,

            action,

            reward,

            next_state,

            done

        )


    # --------------------------------------------------------
    # 4.2.3: DOUBLE DQN OPTIMIZATION
    # --------------------------------------------------------

    def learn(self):

        # Wait until enough experiences are available.

        if len(self.replay_buffer) < self.batch_size:

            return None


        # Sample a mini-batch.

        (
            states,
            actions,
            rewards,
            next_states,
            dones

        ) = self.replay_buffer.sample(
            self.batch_size
        )


        # Transfer tensors to the selected device.

        states = states.to(self.device)

        actions = actions.to(self.device)

        rewards = rewards.to(self.device)

        next_states = next_states.to(self.device)

        dones = dones.to(self.device)


        # ----------------------------------------------------
        # Current Q-values:
        #
        # Q(s_t, a_t; theta)
        # ----------------------------------------------------

        current_q_values = self.online_network(
            states
        ).gather(

            1,

            actions.unsqueeze(1)

        ).squeeze(1)


        # ----------------------------------------------------
        # Double DQN target computation.
        #
        # Online network selects the next action.
        # Target network evaluates that selected action.
        # ----------------------------------------------------

        with torch.no_grad():


            # Select next action using online network.

            next_actions = self.online_network(
                next_states
            ).argmax(

                dim=1,

                keepdim=True

            )


            # Evaluate selected action using target network.

            next_q_values = self.target_network(
                next_states
            ).gather(

                1,

                next_actions

            ).squeeze(1)


            # Calculate the DDQN target.

            target_q_values = rewards + (

                self.gamma

                * next_q_values

                * (1.0 - dones)

            )


        # ----------------------------------------------------
        # Calculate Smooth L1 loss.
        # ----------------------------------------------------

        loss = self.loss_function(

            current_q_values,

            target_q_values

        )


        # ----------------------------------------------------
        # Backpropagation and parameter optimization.
        # ----------------------------------------------------

        self.optimizer.zero_grad()

        loss.backward()


        # Gradient clipping for training stability.

        torch.nn.utils.clip_grad_norm_(

            self.online_network.parameters(),

            max_norm=10.0

        )


        self.optimizer.step()


        # Count optimization steps.

        self.learn_steps += 1


        # ----------------------------------------------------
        # Periodically synchronize target network.
        # ----------------------------------------------------

        if (

            self.learn_steps
            % self.target_update_frequency == 0

        ):

            self.target_network.load_state_dict(

                self.online_network.state_dict()

            )


        # Return the actual optimization loss.
        # Block 6 will record this value for plotting.

        return float(
            loss.item()
        )


    # --------------------------------------------------------
    # 4.2.4: EPSILON DECAY
    # --------------------------------------------------------

    def decay_epsilon(self):

        self.epsilon = max(

            self.epsilon_end,

            self.epsilon * self.epsilon_decay

        )


    # --------------------------------------------------------
    # 4.2.5: SAVE MODEL CHECKPOINT
    # --------------------------------------------------------

    def save_checkpoint(self, filepath):

        filepath = str(filepath)


        torch.save(

            {

                "model_name": self.model_name,

                "state_dim": self.state_dim,

                "num_actions": self.num_actions,

                "online_network":
                    self.online_network.state_dict(),

                "target_network":
                    self.target_network.state_dict(),

                "optimizer":
                    self.optimizer.state_dict(),

                "epsilon": self.epsilon,

                "learn_steps": self.learn_steps

            },

            filepath

        )


    # --------------------------------------------------------
    # 4.2.6: LOAD MODEL CHECKPOINT
    # --------------------------------------------------------

    def load_checkpoint(self, filepath):

        checkpoint = torch.load(

            filepath,

            map_location=self.device

        )


        # Validate checkpoint compatibility.

        if checkpoint["model_name"] != self.model_name:

            raise ValueError(
                "Checkpoint model does not match the agent model."
            )


        if checkpoint["state_dim"] != self.state_dim:

            raise ValueError(
                "Checkpoint state dimension does not match."
            )


        if checkpoint["num_actions"] != self.num_actions:

            raise ValueError(
                "Checkpoint action dimension does not match."
            )


        # Restore networks.

        self.online_network.load_state_dict(

            checkpoint["online_network"]

        )

        self.target_network.load_state_dict(

            checkpoint["target_network"]

        )


        # Restore optimizer.

        self.optimizer.load_state_dict(

            checkpoint["optimizer"]

        )


        # Restore exploration and learning progress.

        self.epsilon = checkpoint["epsilon"]

        self.learn_steps = checkpoint["learn_steps"]


        self.target_network.eval()


# ------------------------------------------------------------
# 4.3: VERIFY ALL FOUR DDQN AGENTS
# ------------------------------------------------------------

def verify_agents():

    print("\n" + "=" * 72)

    print("BLOCK 4: DDQN AGENT VERIFICATION")

    print("=" * 72)


    test_state = np.zeros(

        STATE_DIM,

        dtype=np.float32

    )


    for model_name in NETWORK_FACTORIES:

        agent = DDQNAgent(
            model_name
        )


        # Test greedy action selection.

        action = agent.select_action(

