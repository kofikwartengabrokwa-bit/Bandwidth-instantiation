        part = summary[
            summary["Algorithm_Label"] == algorithm
        ].sort_values(user_col)

        if part.empty:
            print(f"Warning: no observations found for {algorithm}")
            continue

        x = part[user_col].to_numpy(dtype=float)
        y = part[metric].to_numpy(dtype=float)

        ax.plot(
            x, y,
            label=algorithm,
            marker=STYLES[algorithm]["marker"],
            linestyle=STYLES[algorithm]["linestyle"],
            linewidth=STYLES[algorithm]["linewidth"],
            markersize=8,
        )

        if std_col is not None and std_col in part.columns:
            std = part[std_col].to_numpy(dtype=float)
            valid = np.isfinite(x) & np.isfinite(y) & np.isfinite(std)

            if valid.any():
                ax.fill_between(
                    x[valid],
                    y[valid] - std[valid],
                    y[valid] + std[valid],
                    alpha=0.12,
                    linewidth=0,
                )

    ax.set_xlabel("Number of Users")
    ax.set_ylabel(ylabel)
