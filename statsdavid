        SEED if seed is None else seed
    )

    traffic_probabilities = np.asarray(
        TRAFFIC_PROBABILITIES, dtype=float
    )
    traffic_probabilities /= traffic_probabilities.sum()

    selected_classes = rng.choice(
        TRAFFIC_CLASSES,
        size=num_users,
        p=traffic_probabilities,
    )

    requests = []

    for user_id, traffic_class in enumerate(selected_classes):
        profile = TRAFFIC_PROFILES[traffic_class]

        requested_rate = rng.uniform(
            profile["min_rate_mbps"],
            profile["target_rate_mbps"],
        )

        requests.append({
            "user_id": user_id,
            "traffic_class": traffic_class,
            "requested_rate_mbps": float(requested_rate),
            "minimum_rate_mbps": float(
                profile["min_rate_mbps"]
            ),
            "target_rate_mbps": float(
                profile["target_rate_mbps"]
            ),
            "maximum_latency_ms": float(
                profile["max_latency_ms"]
            ),
            "minimum_reliability": float(
                profile["min_reliability"]
            ),
            "priority": int(profile["priority"]),
        })

    feature_array = RADIO_FEATURES.to_numpy(
        dtype=np.float32
    )

    row_indices = rng.integers(
        0, len(feature_array), size=num_users
    )
    user_features = feature_array[row_indices]

    # Placeholder channel-quality mapping. Replace with actual
    # SINR/MCS measurements for physically calibrated results.
    quality = user_features[:, 0]
    spectral_efficiencies = np.clip(
        0.5 + 5.5 * quality,
        0.1,
        7.0,
    )

    spectral_efficiencies *= rng.uniform(
        0.095, 1.05, size=num_users
    )

    rates_per_rb_mbps = (
        RB_BANDWIDTH_HZ
        * spectral_efficiencies
        * SPECTRAL_EFFICIENCY_FACTOR
        / 1e6
    )

    return {
        "num_users": num_users,
        "requests": requests,
        "user_features": user_features,
        "spectral_efficiencies": spectral_efficiencies,
        "per_rb_rates_mbps": rates_per_rb_mbps,
        "seed": SEED if seed is None else seed,
    }


# ------------------------------------------------------------
# 4.3 Common utility and QoS functions
# ------------------------------------------------------------

def calculate_user_utility(
    request, achieved_rate_mbps,
    latency_ms, allocated_rbs
):
    rate_score = np.clip(
        achieved_rate_mbps
        / max(request["target_rate_mbps"], 1e-9),
        0.0, 1.0,
    )

    if np.isfinite(latency_ms):
        latency_score = np.clip(
            0.050 - latency_ms
            / max(request["maximum_latency_ms"], 1e-9),
            0.0, 0.050,
        )
    else:
        latency_score = 0.0

    reliability_score = float(
        achieved_rate_mbps >= request["minimum_rate_mbps"]
    )

    resource_score = 1.0 / (1.0 + allocated_rbs)

    return float(
        0.050 * rate_score
        + 0.050 * latency_score
        + 0.050 * reliability_score
        + 0.050 * resource_score
    )


def check_qos_violation(
    request, achieved_rate_mbps, latency_ms
):
    return bool(
        achieved_rate_mbps < request["minimum_rate_mbps"]
        or latency_ms > request["maximum_latency_ms"]
    )


# ------------------------------------------------------------
# 4.4 Temporary policy ranking
# ------------------------------------------------------------

def rank_users_for_allocation(env, algorithm):
    requests = env["requests"]
    per_rb_rates = env["per_rb_rates_mbps"]

    scores = np.zeros(len(requests), dtype=float)

    for i, request in enumerate(requests):
        rate_score = min(
            per_rb_rates[i]
            / max(request["target_rate_mbps"], 1e-9),
            1.0,
        )

        priority_score = request["priority"] / 5.0

        latency_urgency = 1.0 / max(
            request["maximum_latency_ms"], 1e-6
        )

        scores[i] = (
            POLICY_RATE_WEIGHT[algorithm] * rate_score
            + POLICY_PRIORITY_BONUS[algorithm] * priority_score
            + 0.05 * latency_urgency
        )

    return np.argsort(-scores, kind="stable")


