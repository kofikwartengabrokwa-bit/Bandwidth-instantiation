# ---------------------------------------------------------------------------
# 13.4 PLOT EACH STANDARD DEVIATION AGAINST USER COUNT
# ---------------------------------------------------------------------------

def save_std_plot(fig, filename):
    png_path = FIG_DIR / f"{filename}.png"
    eps_path = FIG_DIR / f"{filename}.eps"

    fig.tight_layout()
    fig.savefig(png_path, dpi=600, bbox_inches="tight")
    fig.savefig(eps_path, format="eps", bbox_inches="tight")

    plt.show()
    plt.close(fig)

    print("Saved:", png_path)
    print("Saved:", eps_path)


for metric_name, std_col in available_metrics.items():

    df[std_col] = pd.to_numeric(df[std_col], errors="coerce")

    # A summary file should normally have one row per algorithm and load.
    # If duplicates exist, average the reported standard deviations.
    summary = (
        df.groupby(
            ["Algorithm_Label", user_col],
            observed=True
        )[std_col]
        .mean()
        .reset_index()
    )

    summary.to_csv(
        CSV_DIR / (
            "block13_"
            + norm_name(metric_name)
            + "_std_summary.csv"
        ),
        index=False,
    )

    fig, ax = plt.subplots(figsize=(11, 7))

    for algorithm in ALGORITHM_ORDER:
        subset = summary[
            summary["Algorithm_Label"] == algorithm
        ].sort_values(user_col)

        if subset.empty:
            continue

        ax.plot(
            subset[user_col],
            subset[std_col],
            label=algorithm,
            marker=STYLES[algorithm]["marker"],
            linestyle=STYLES[algorithm]["linestyle"],
            linewidth=STYLES[algorithm]["linewidth"],
            markersize=8,
        )

    ax.set_xlabel("Number of Users")
    ax.set_ylabel(f"{metric_name}")
    ax.set_xticks(USER_COUNTS)
    ax.set_xlim(left=0)
    ax.set_ylim(bottom=0)
    ax.legend(loc="best", frameon=True, ncol=2)

    ax.grid(True, linestyle="--", alpha=0.35)
    ax.set_axisbelow(True)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

    filename = "block13_" + norm_name(metric_name) + "_std"
    save_std_plot(fig, filename)

