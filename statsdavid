def normalize_name(value):
    """Normalize column names and algorithm labels for matching."""
    return re.sub(r"[^a-z0-9]+", "", str(value).lower())


def display_algorithm(value):
    """Normalize the proposed algorithm's legend label."""
    name = normalize_name(value)

    if "rbf" in name and "edgecover" in name and "ddqn" in name:
        return "Ours"

    for algorithm in ["GGN-DDQN", "GCN-DDQN", "DDQN"]:
        if name == normalize_name(algorithm):
            return algorithm

    return str(value)


def find_column(df, candidates, required=True):
    """Find a column using alternative possible names."""
    lookup = {normalize_name(c): c for c in df.columns}

    for candidate in candidates:
        key = normalize_name(candidate)
        if key in lookup:
            return lookup[key]

    if required:
        raise KeyError(
            f"Could not identify a column matching {candidates}.\n"
            f"Available columns: {df.columns.tolist()}"
        )

    return None


def save_figure(fig, filename):
    """Save each plot in high-resolution PNG and vector EPS formats."""
    png_path = FIG_DIR / f"{filename}.png"
    eps_path = FIG_DIR / f"{filename}.eps"

    fig.savefig(png_path, dpi=600, bbox_inches="tight")
    fig.savefig(eps_path, format="eps", bbox_inches="tight")
    plt.show()
    plt.close(fig)

    print(f"Saved: {png_path}")
    print(f"Saved: {eps_path}")


