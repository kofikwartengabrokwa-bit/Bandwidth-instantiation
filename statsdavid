# ---------------------------------------------------------------------------
# 13.2 LOAD SUMMARY
# ---------------------------------------------------------------------------

if not SUMMARY_FILE.exists():
    raise FileNotFoundError(
        f"Summary file not found: {SUMMARY_FILE}"
    )

df = pd.read_csv(SUMMARY_FILE)

print("Loaded:", SUMMARY_FILE.name)
print("Rows:", len(df))
print("Available columns:")
print(df.columns.tolist())


def norm_name(value):
    return re.sub(r"[^a-z0-9]+", "", str(value).lower())


def find_col(candidates, required=True):
    lookup = {norm_name(c): c for c in df.columns}

    for candidate in candidates:
        if norm_name(candidate) in lookup:
            return lookup[norm_name(candidate)]

    if required:
        raise KeyError(
            f"Could not find any of {candidates}.\n"
            f"Available columns: {df.columns.tolist()}"
        )

    return None


def normalize_algorithm(value):
    name = norm_name(value)

    if "rbf" in name and "edgecover" in name and "ddqn" in name:
        return "Ours"

    for algorithm in ALGORITHM_ORDER:
        if name == norm_name(algorithm):
            return algorithm

    return str(value)


algorithm_col = find_col(
    ["algorithm", "algorithm_name", "model", "method"]
)

user_col = find_col(
    ["user_count", "num_users", "user_counts", "users"]
)

df["Algorithm_Label"] = df[algorithm_col].map(normalize_algorithm)
df[user_col] = pd.to_numeric(df[user_col], errors="coerce")

df = df[
    df["Algorithm_Label"].isin(ALGORITHM_ORDER)
    & df[user_col].notna()
].copy()

