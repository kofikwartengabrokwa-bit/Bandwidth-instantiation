import time
from dataclasses import dataclass


# ------------------------------------------------------------
# 3.1 Simulation parameters
# ------------------------------------------------------------

SLOT_DURATION_S = 0.00001
SUBCARRIERS_PER_RB = 12
SUBCARRIER_SPACING_HZ = 15_000

# 12 subcarriers x 15 kHz = 180 kHz per RB.
RB_BANDWIDTH_HZ = (
    SUBCARRIERS_PER_RB * SUBCARRIER_SPACING_HZ
)

# Equal-share power budget used as a simulation constraint.
# This is a modeling assumption, not a measured power profile.
MAX_POWER_PER_RB_W = MAX_TRANSMIT_POWER_W / TOTAL_RBS

# Reproducible evaluation configuration.
EVALUATION_SEED = SEED + 300
NUM_REPEATS_PER_LOAD = 3

# Use a common minimum rate/latency-based QoS test.
# Reliability is modeled separately in this block.


# ------------------------------------------------------------
# 3.2 Request data structure
# ------------------------------------------------------------

@dataclass
class UserRequest:
    user_id: int
    traffic_class: str
    requested_rate_mbps: float
    target_rate_mbps: float
    minimum_rate_mbps: float
    max_latency_ms: float
    minimum_reliability: float
    priority: int
    channel_quality: float
    requested_power_w: float


# ------------------------------------------------------------
# 3.3 Generate user requests
# ------------------------------------------------------------

def generate_user_requests(
    num_users,
    seed=EVALUATION_SEED
):
    """
    Generate a reproducible set of traffic requests.

    All four algorithms should receive the same requests
    for a given user load and evaluation repeat.
    """
    rng = np.random.default_rng(seed)

    class_indices = rng.choice(
        len(TRAFFIC_CLASSES),
        size=num_users,
        p=TRAFFIC_PROBABILITIES
    )

    requests = []

    for user_id, class_index in enumerate(class_indices):
        traffic_class = TRAFFIC_CLASSES[class_index]
        profile = TRAFFIC_PROFILES[traffic_class]

        minimum_rate = profile["min_rate_mbps"]
        target_rate = profile["target_rate_mbps"]

        # Sample the requested rate between the minimum and target.
        requested_rate = rng.uniform(
            minimum_rate, target_rate
        )

        # A normalized channel-quality abstraction.
        # Replace this with measured channel/SINR data if available.
        channel_quality = rng.uniform(0.5, 1.0)

        requested_power = rng.uniform(
            0.02, MAX_POWER_PER_RB_W
        )

        requests.append(
            UserRequest(
                user_id=user_id,
                traffic_class=traffic_class,
                requested_rate_mbps=float(requested_rate),
                target_rate_mbps=float(target_rate),
                minimum_rate_mbps=float(minimum_rate),
                max_latency_ms=float(
                    profile["max_latency_ms"]
                ),
                minimum_reliability=float(
                    profile["min_reliability"]
                ),
                priority=int(profile["priority"]),
                channel_quality=float(channel_quality),
                requested_power_w=float(requested_power),
            )
        )

    return requests


# ------------------------------------------------------------
# 3.4 Estimate achievable rate per RB
# ------------------------------------------------------------

def estimate_rate_per_rb_mbps(request):
    """
    Approximate per-RB rate using a transparent channel-quality
    abstraction. This is not a calibrated 5G NR link-level model.
    """
    spectral_efficiency = (
        0.5 + 4.0 * request.channel_quality
    )

    rate_bps = (
        RB_BANDWIDTH_HZ * spectral_efficiency
    )

    return rate_bps / 1e6


# ------------------------------------------------------------
# 3.5 Shared allocation evaluation
# ------------------------------------------------------------

def evaluate_allocation(
    requests,
    allocated_rbs,
    allocation_time_ms,
    algorithm_name
):
    """
    Evaluate one model's allocation.

    allocated_rbs:
        Dictionary mapping user_id -> integer RB count.

    Allocation time:
        Supplied by the calling policy/evaluator and measured
        separately from this metric calculation.
    """
    rows = []

    total_allocated_rbs = 0
    total_power_w = 0.0
    total_utility = 0.0
    qos_violations = 0
    total_achieved_rate_mbps = 0.0

    for request in requests:
        rb_count = int(
            allocated_rbs.get(request.user_id, 0)
        )

        rb_count = max(0, rb_count)
        total_allocated_rbs += rb_count

        achieved_rate = (
            rb_count
            * estimate_rate_per_rb_mbps(request)
        )

        # Approximate rate-based transmission latency.
        # This excludes propagation, queueing, and retransmissions.
        if achieved_rate > 0:
            latency_ms = (
                request.requested_rate_mbps
                / achieved_rate
            ) * SLOT_DURATION_S * 1000.0
        else:
            latency_ms = float("inf")

        user_power = (
            rb_count * request.requested_power_w
        )
        total_power_w += user_power

        rate_satisfaction = max(
            achieved_rate / max(request.target_rate_mbps, 1e-12),
            1.0
        )

        latency_satisfaction = (
            1.0
            if latency_ms <= request.max_latency_ms
            else 0.0
        )

        qos_violation = (
            achieved_rate < request.minimum_rate_mbps
            or latency_ms > request.max_latency_ms
            or rb_count == 0
        )

        qos_violations += int(qos_violation)
        total_achieved_rate_mbps += achieved_rate

        # Priority-weighted normalized rate utility.
        user_utility = (
            request.priority
            * rate_satisfaction
            * latency_satisfaction
        )

        total_utility += user_utility

        rows.append({
            "algorithm": algorithm_name,
            "user_id": request.user_id,
            "traffic_class": request.traffic_class,
            "allocated_rbs": rb_count,
            "requested_rate_mbps": request.requested_rate_mbps,
            "achieved_rate_mbps": achieved_rate,
            "latency_ms": latency_ms,
            "power_w": user_power,
            "qos_violation": int(qos_violation),
            "utility": user_utility,
        })

    if total_allocated_rbs > TOTAL_RBS:
        raise ValueError(
            f"{algorithm_name} allocated {total_allocated_rbs} RBs, "
            f"exceeding the budget of {TOTAL_RBS}."
        )

    if total_power_w > MAX_TRANSMIT_POWER_W:
        raise ValueError(
            f"{algorithm_name} exceeded the total power budget: "
            f"{total_power_w:.4f} W."
        )

    user_count = len(requests)

    summary = {
        "algorithm": algorithm_name,
        "users": user_count,
        "allocated_rbs": total_allocated_rbs,
        "allocation_time_ms": float(allocation_time_ms),
        "data_rate_mbps": total_achieved_rate_mbps,
        "mean_user_rate_mbps": (
            total_achieved_rate_mbps / max(user_count, 1)
        ),
        "qos_violation_ratio": (
            qos_violations / max(user_count, 1)
        ),
        "utility": total_utility,
        "power_w": total_power_w,
    }

    return summary, pd.DataFrame(rows)


