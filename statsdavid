        return "Ours"

    for algorithm in ALGORITHM_ORDER:
        if name == b12_norm(algorithm):
            return algorithm

    return str(value)


def b12_find_column(df, candidates):
    lookup = {b12_norm(col): col for col in df.columns}

    for candidate in candidates:
