def allocate_resource_blocks(env, algorithm):
    """
    Temporary heuristic RB allocation engine.

    Enforces:
      1. At most TOTAL_RBS physical RBs.
      2. At most MAX_USERS_PER_RB users per RB.
      3. Total transmit power <= MAX_TRANSMIT_POWER_W.

    Note: This is not a trained DDQN policy.
    """

    num_users = env["num_users"]
    requests = env["requests"]
    per_rb_rates = env["per_rb_rates_mbps"]

    allocated_rbs = np.zeros(num_users, dtype=np.int32)
    rb_occupancy = np.zeros(TOTAL_RBS, dtype=np.int32)

    # The total power budget is shared across physical RBs.
    # Each RB receives one fixed power share, irrespective
    # of how many users share that RB.
    power_per_rb_w = MAX_TRANSMIT_POWER_W / TOTAL_RBS
    rb_power_w = np.zeros(TOTAL_RBS, dtype=np.float64)

    start_time = time.perf_counter()
    ranking = rank_users_for_allocation(env, algorithm)

    for user_idx in ranking:
        request = requests[user_idx]
        rate_per_rb = per_rb_rates[user_idx]

        required_rbs = max(
            1,
            int(np.ceil(
                request["requested_rate_mbps"]
                / max(rate_per_rb, 1e-9)
            )),
        )

        required_rbs = min(required_rbs, TOTAL_RBS)

        for _ in range(required_rbs):
            eligible_rbs = np.flatnonzero(
                (rb_occupancy < MAX_USERS_PER_RB)
                & (rb_power_w == 0.0)
            )

            # Only unallocated physical RBs receive new power.
            # Multiple users can share an occupied RB without
            # multiplying the RB's configured power.
            if eligible_rbs.size == 0:
                eligible_rbs = np.flatnonzero(
                    (rb_occupancy < MAX_USERS_PER_RB)
                    & (rb_power_w <= power_per_rb_w + 1e-12)
                )

            if eligible_rbs.size == 0:
                break

            # Prefer the least occupied eligible RB.
            selected_rb = eligible_rbs[
                np.argmin(rb_occupancy[eligible_rbs])
            ]

            # Allocate power only when activating a physical RB.
            if rb_occupancy[selected_rb] == 0:
                rb_power_w[selected_rb] = power_per_rb_w

            rb_occupancy[selected_rb] += 1
            allocated_rbs[user_idx] += 1

    allocation_time_ms = (
        time.perf_counter() - start_time
    ) * 1000.0

    # --------------------------------------------------------
    # Calculate performance metrics
    # --------------------------------------------------------

    achieved_rates = allocated_rbs * per_rb_rates
    latencies_ms = np.full(num_users, np.inf, dtype=float)
    utilities = np.zeros(num_users, dtype=float)
    qos_violations = np.zeros(num_users, dtype=bool)

    for i, request in enumerate(requests):
        if allocated_rbs[i] > 0:
            latencies_ms[i] = (
                SLOT_DURATION_MS
                * request["requested_rate_mbps"]
                / max(achieved_rates[i], 1e-9)
            )

        utilities[i] = calculate_user_utility(
            request,
            achieved_rates[i],
            latencies_ms[i],
            int(allocated_rbs[i]),
        )

        qos_violations[i] = check_qos_violation(
            request,
            achieved_rates[i],
            latencies_ms[i],
        )

    total_power_used_w = float(rb_power_w.sum())

    result = {
        "algorithm": algorithm,
        "num_users": num_users,
        "allocation_time_ms": allocation_time_ms,
        "allocated_rbs_per_user": allocated_rbs,
        "total_allocated_rbs": int(allocated_rbs.sum()),
        "total_rb_user_assignments": int(rb_occupancy.sum()),
        "rb_occupancy": rb_occupancy,
        "achieved_rates_mbps": achieved_rates,
        "mean_data_rate_mbps": float(np.mean(achieved_rates)),
        "total_data_rate_mbps": float(np.sum(achieved_rates)),
        "latencies_ms": latencies_ms,
        "qos_violations": qos_violations,
        "qos_violation_ratio": float(np.mean(qos_violations)),
        "utilities": utilities,
        "mean_utility": float(np.mean(utilities)),
        "total_power_used_w": total_power_used_w,
    }

    # --------------------------------------------------------
    # Enforce constraints
    # --------------------------------------------------------

    assert np.all(rb_occupancy <= MAX_USERS_PER_RB)
    assert len(rb_occupancy) == TOTAL_RBS
    assert total_power_used_w <= MAX_TRANSMIT_POWER_W + 1e-8
    assert np.all(allocated_rbs >= 0)

    return result


