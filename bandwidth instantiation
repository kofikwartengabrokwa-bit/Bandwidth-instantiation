SLICE_NAMES = list(SLICE_MIX.keys())

def generate_users(num_users, seed):
    rng = np.random.default_rng(seed)

    slice_names = rng.choice(
        SLICE_NAMES,
        size=num_users,
        p=list(SLICE_MIX.values()),
    )

    users = []

    for uid, name in enumerate(slice_names):
        if name == "IoT":
            demand = rng.uniform(0.02, 0.15)
            latency = rng.uniform(5, 100)
        elif name == "M2M":
            demand = rng.uniform(0.05, 0.30)
            latency = rng.uniform(5, 50)
        elif name == "Vehicular":
            demand = rng.uniform(1.0, 8.0)
            latency = rng.uniform(2, 30)
        else:
            demand = rng.uniform(3.0, 20.0)
            latency = rng.uniform(5, 60)

        users.append({
            "user_id": int(uid),
            "slice": str(name),
            "demand_mbps": float(demand),
            "latency_ms": float(latency),
            "channel": float(rng.beta(2.5, 2.0)),
        })

    return users


class ORU:
    """Synthetic O-RU radio-side interface."""

    def __init__(self, seed=SEED):
        self.seed = seed

    def connect_users(self, num_users):
        return generate_users(num_users, self.seed)


class ODU:
    """O-DU shared resource-budget controller."""

    def __init__(
        self,
        total_rbs=TOTAL_RBS,
        total_bandwidth_mhz=TOTAL_BANDWIDTH_MHZ,
        power_budget=TOTAL_POWER_BUDGET,
    ):
        self.total_rbs = int(total_rbs)
        self.total_bandwidth_mhz = float(total_bandwidth_mhz)
        self.power_budget = float(power_budget)
        self.reset()

    def reset(self):
        self.remaining_rbs = self.total_rbs
        self.remaining_power = self.power_budget

    @property
    def bandwidth_per_rb(self):
        return self.total_bandwidth_mhz / max(self.total_rbs, 1)

    def allocate(self, user, requested_rbs, requested_power):
        rbs = min(
            max(0, int(requested_rbs)),
            self.remaining_rbs,
        )
        power = min(
            max(0.0, float(requested_power)),
            self.remaining_power,
        )

        if rbs == 0:
            power = 0.0

        bandwidth = rbs * self.bandwidth_per_rb

        # Illustrative link model, not a calibrated 5G PHY model.
        efficiency = 0.5 + 4.5 * user["channel"]
        power_factor = (
            min(np.sqrt(power / 4.0), 2.0)
            if power > 0 else 0.0
        )

        throughput = bandwidth * efficiency * power_factor

        self.remaining_rbs -= rbs
        self.remaining_power -= power

        return {
            "allocated_rbs": rbs,
            "bandwidth_mhz": bandwidth,
            "power": power,
            "throughput_mbps": float(throughput),
            "energy_proxy": power * SLOT_SECONDS,
        }


# State dimensions:
# 4 slice indicators + channel + demand + observed latency +
# latency constraint + remaining RB fraction + remaining power
# fraction + current total RB scale + current bandwidth scale.
STATE_DIM = 12

def make_state(user, odu, latency_limit_ms):
    slice_one_hot = [
        float(user["slice"] == name)
        for name in SLICE_NAMES
    ]

    return np.asarray(
        slice_one_hot + [
            user["channel"],
            np.clip(user["demand_mbps"] / 20.0, 0.0, 1.0),
            np.clip(user["latency_ms"] / 100.0, 0.0, 1.0),
            np.clip(latency_limit_ms / 100.0, 0.0, 1.0),
            odu.remaining_rbs / max(odu.total_rbs, 1),
            odu.remaining_power / max(odu.power_budget, 1e-8),
            min(odu.total_rbs / 200.0, 1.0),
            min(odu.total_bandwidth_mhz / 40.0, 1.0),
        ],
        dtype=np.float32,
    )

