def calculate_reward(user, allocation, latency_limit_ms):
    demand = max(user["demand_mbps"], 1e-6)

    rate_satisfaction = min(
        allocation["throughput_mbps"] / demand,
        1.0,
    )

    latency_violation = float(
        user["latency_ms"] > latency_limit_ms
    )

    rb_cost = (
        allocation["allocated_rbs"] / max(TOTAL_RBS, 1)
    )

    power_cost = (
        allocation["power"] / max(TOTAL_POWER_BUDGET, 1e-8)
    )

    return float(
        2.0 * rate_satisfaction
        - 0.25 * rb_cost
        - 0.20 * power_cost
        - 0.50 * latency_violation
    )


def run_training_episode(
    model_agent,
    users,
    latency_limit_ms=20.0,
):
    odu = ODU()
    odu.reset()

    users = list(users)
    random.shuffle(users)

    episode_rewards = []
    episode_losses = []

    for i, user in enumerate(users):
        state = make_state(user, odu, latency_limit_ms)

        action_index = model_agent.select_action(
            state, explore=True
        )

        requested_rbs, requested_power = ACTIONS[action_index]

        allocation = odu.allocate(
            user,
            requested_rbs,
            requested_power,
        )

        reward = calculate_reward(
            user,
            allocation,
            latency_limit_ms,
        )

        done = i == len(users) - 1

        if done:
            next_state = np.zeros(STATE_DIM, dtype=np.float32)
        else:
            next_state = make_state(
                users[i + 1], odu, latency_limit_ms
            )

        model_agent.memory.add(
            state,
            action_index,
            reward,
            next_state,
            done,
        )

        # Learn every four user decisions.
        if i % 4 == 0:
            loss = model_agent.learn()
            if loss is not None:
                episode_losses.append(loss)

        episode_rewards.append(reward)

    model_agent.decay_epsilon()

    return {
        "mean_reward": float(np.mean(episode_rewards)),
        "total_reward": float(np.sum(episode_rewards)),
        "mean_loss": (
            float(np.mean(episode_losses))
            if episode_losses else np.nan
        ),
        "allocated_rbs": TOTAL_RBS - odu.remaining_rbs,
        "allocated_power": TOTAL_POWER_BUDGET - odu.remaining_power,
    }


training_rows = []

for episode in range(1, NUM_EPISODES + 1):
    num_users = random.choice(USER_LOADS_TRAIN)

    # Same traffic scenario for each model in this episode.
    shared_users = generate_users(
        num_users,
        seed=SEED + episode,
    )

    for model_name in MODEL_NAMES:
        # Each policy gets an independent copy of the same users.
        episode_users = copy.deepcopy(shared_users)

        metrics = run_training_episode(
            agents[model_name],
            episode_users,
            latency_limit_ms=20.0,
        )

        training_rows.append({
            "episode": episode,
            "num_users": num_users,
            "model": model_name,
            "mean_reward": metrics["mean_reward"],
            "total_reward": metrics["total_reward"],
            "mean_loss": metrics["mean_loss"],
            "allocated_rbs": metrics["allocated_rbs"],
            "allocated_power": metrics["allocated_power"],
            "epsilon": agents[model_name].epsilon,
        })

    if episode == 1 or episode % 10 == 0:
        latest = [
            row for row in training_rows
            if row["episode"] == episode
        ]

        print(f"\nEpisode {episode}/{NUM_EPISODES}")
        for row in latest:
            print(
                f"{row['model']:10s} | "
                f"users={row['num_users']:3d} | "
