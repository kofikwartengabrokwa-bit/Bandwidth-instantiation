def evaluate_model(
    model_agent,
    users,
    total_rbs,
    bandwidth_mhz,
    power_budget,
    latency_limit_ms,
):
    odu = ODU(
        total_rbs=total_rbs,
        total_bandwidth_mhz=bandwidth_mhz,
        power_budget=power_budget,
    )

    odu.reset()
    records = []

    for user in users:
        state = make_state(user, odu, latency_limit_ms)

        action_index = model_agent.select_action(
            state, explore=False
        )

        requested_rbs, requested_power = ACTIONS[action_index]

        allocation = odu.allocate(
            user,
            requested_rbs,
            requested_power,
        )

        records.append({
            "user_id": user["user_id"],
            "slice": user["slice"],
            "demand_mbps": user["demand_mbps"],
            "latency_ms": user["latency_ms"],
            **allocation,
        })

    details = pd.DataFrame(records)

    assert details["allocated_rbs"].sum() <= total_rbs
    assert (
        details["bandwidth_mhz"].sum()
        <= bandwidth_mhz + 1e-6
    )
    assert details["power"].sum() <= power_budget + 1e-6

    return {
        "throughput_mbps": details["throughput_mbps"].sum(),
        "energy_proxy": details["energy_proxy"].sum(),
        "total_power": details["power"].sum(),
        "allocated_rbs": details["allocated_rbs"].sum(),
        "allocated_bandwidth_mhz": details["bandwidth_mhz"].sum(),
        "users_served": int(
            (details["allocated_rbs"] > 0).sum()
        ),
        "details": details,
    }


def run_comparison_sweep(
    experiment_name,
    sweep_values,
    scenario_fn,
):
    rows = []

    for value in sweep_values:
        total_rbs, bandwidth_mhz, latency_limit_ms = (
            scenario_fn(value)
        )

        for repeat in range(EVAL_REPEATS):
            shared_users = generate_users(
                FIXED_EVAL_USERS,
                seed=SEED + 100_000 + repeat * 1000 + int(value * 10),
            )

            for model_name in MODEL_NAMES:
                result = evaluate_model(
                    model_agent=agents[model_name],
                    users=copy.deepcopy(shared_users),
                    total_rbs=total_rbs,
                    bandwidth_mhz=bandwidth_mhz,
                    power_budget=TOTAL_POWER_BUDGET,
                    latency_limit_ms=latency_limit_ms,
                )

                rows.append({
                    "experiment": experiment_name,
                    "sweep_value": value,
                    "repeat": repeat,
                    "model": model_name,
                    "throughput_mbps": result["throughput_mbps"],
                    "energy_proxy": result["energy_proxy"],
                    "total_power": result["total_power"],
                    "allocated_rbs": result["allocated_rbs"],
                    "allocated_bandwidth_mhz": (
                        result["allocated_bandwidth_mhz"]
                    ),
                    "users_served": result["users_served"],
                })

        print(
            f"Completed {experiment_name}: "
            f"value={value}"
        )

    return pd.DataFrame(rows)


