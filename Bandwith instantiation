class SliceUser:
    """One user requesting radio resources from the O-DU."""

    def __init__(
        self,
        user_id,
        slice_name,
        demand_mbps,
        channel_quality,
        latency_ms,
    ):
        self.user_id = user_id
        self.slice_name = slice_name
        self.demand_mbps = float(demand_mbps)

        # Normalized channel-quality indicator in [0, 1].
        self.channel_quality = float(
            np.clip(channel_quality, 0.05, 1.0)
        )

        self.latency_ms = float(latency_ms)

        self.allocated_rbs = 0
        self.allocated_bandwidth_mhz = 0.0
        self.allocated_power = 0.0
        self.achieved_rate_mbps = 0.0


class ORU:
    """
    Simplified radio-side interface.

    Users connect through the O-RU. This class supplies synthetic
    channel-dependent link conditions for the scheduling model.
    """

    def __init__(self, seed=SEED):
        self.rng = np.random.default_rng(seed)

    def generate_users(self, num_users):
        names = list(SLICE_MIX.keys())
        probabilities = np.array(list(SLICE_MIX.values()))

        selected_slices = self.rng.choice(
            names,
            size=num_users,
            p=probabilities,
        )

        users = []

        for user_id, slice_name in enumerate(selected_slices):
            if slice_name == "IoT":
                demand = self.rng.uniform(0.02, 0.15)
                latency = self.rng.uniform(10, 100)

            elif slice_name == "M2M":
                demand = self.rng.uniform(0.05, 0.30)
                latency = self.rng.uniform(5, 50)

            elif slice_name == "Vehicular":
                demand = self.rng.uniform(1.0, 8.0)
                latency = self.rng.uniform(2, 20)

            else:  # eMBB
                demand = self.rng.uniform(3.0, 20.0)
                latency = self.rng.uniform(5, 40)

            channel_quality = self.rng.beta(2.5, 2.0)

            users.append(
                SliceUser(
                    user_id=user_id,
                    slice_name=slice_name,
                    demand_mbps=demand,
                    channel_quality=channel_quality,
                    latency_ms=latency,
                )
            )

        return users


class ODU:
    """
    Simplified O-DU resource scheduler.

    RB and power allocations are made per user.
    Bandwidth follows directly from the allocated RB count.
    """

    def __init__(self):
        self.total_rbs = TOTAL_RBS
        self.total_bandwidth_mhz = TOTAL_BANDWIDTH_MHZ
        self.total_power_budget = TOTAL_POWER_BUDGET

        self.remaining_rbs = self.total_rbs
        self.remaining_power = self.total_power_budget

    def reset(self):
        self.remaining_rbs = self.total_rbs
        self.remaining_power = self.total_power_budget

    def allocate(self, user, requested_rbs, requested_power):
        """Apply the resource-budget constraints to one user."""

        requested_rbs = max(0, int(requested_rbs))
        requested_power = max(0.0, float(requested_power))

        allocated_rbs = min(
            requested_rbs,
            self.remaining_rbs,
        )

        allocated_power = min(
            requested_power,
            self.remaining_power,
        )

        # Do not assign positive power to a user with no RBs.
        if allocated_rbs == 0:
            allocated_power = 0.0

        bandwidth_mhz = (
            allocated_rbs * BANDWIDTH_PER_RB_MHZ
        )

        # Illustrative spectral-efficiency model.
        # Replace this with calibrated channel/MCS calculations
        # when integrating real traces or Py5cheSim.
        spectral_efficiency = (
            0.5 + 4.5 * user.channel_quality
        )

        power_factor = (
            np.sqrt(allocated_power / 4.0)
            if allocated_power > 0
            else 0.0
        )

        achieved_rate = (
            bandwidth_mhz
            * spectral_efficiency
            * min(power_factor, 2.0)
        )

        user.allocated_rbs = allocated_rbs
        user.allocated_bandwidth_mhz = bandwidth_mhz
        user.allocated_power = allocated_power
        user.achieved_rate_mbps = float(achieved_rate)

        self.remaining_rbs -= allocated_rbs
        self.remaining_power -= allocated_power

        return {
            "user_id": user.user_id,
            "slice": user.slice_name,
            "requested_rate_mbps": user.demand_mbps,
            "allocated_rbs": allocated_rbs,
            "allocated_bandwidth_mhz": bandwidth_mhz,
            "allocated_power": allocated_power,
            "achieved_rate_mbps": float(achieved_rate),
            "channel_quality": user.channel_quality,
        }

# ============================================================
# BLOCK 3: RBF FEATURES, REPLAY BUFFER, AND DDQN
# ============================================================

STATE_DIM = 10

RB_ACTIONS = [1, 2, 4, 8, 16]
POWER_ACTIONS = [1.0, 2.0, 4.0, 8.0]

JOINT_ACTIONS = [
    (rb, power)
    for rb in RB_ACTIONS
    for power in POWER_ACTIONS
]

NUM_ACTIONS = len(JOINT_ACTIONS)


def build_state(user, odu, num_users):
    """Build a fixed-size state for the current scheduling decision."""

    slice_vector = [
        float(user.slice_name == name)
        for name in SLICE_CONFIG.keys()
    ]

    state = [
        user.channel_quality,
        np.clip(user.demand_mbps / 20.0, 0.0, 1.0),
        np.clip(user.latency_ms / 100.0, 0.0, 1.0),
        *slice_vector,
        odu.remaining_rbs / odu.total_rbs,
        odu.remaining_power / odu.total_power_budget,
        min(num_users / max(USER_LOADS), 1.0),
    ]

    return np.asarray(state, dtype=np.float32)


class RBFTransform(nn.Module):
    """Fixed Gaussian RBF feature map."""

    def __init__(self, input_dim, num_centers=128, gamma=4.0):
        super().__init__()

        centers = torch.rand(num_centers, input_dim)

        self.register_buffer("centers", centers)
        self.gamma = gamma

    def forward(self, x):
        # Squared Euclidean distance to every RBF center.
        distance = (
            x.unsqueeze(1) - self.centers.unsqueeze(0)
        ).pow(2).sum(dim=2)

        return torch.exp(-self.gamma * distance)


class RBFQNetwork(nn.Module):
    """Q-network using RBF state features."""

    def __init__(self, state_dim, num_actions):
        super().__init__()

        self.rbf = RBFTransform(
            state_dim,
            num_centers=RBF_CENTERS,
        )

        self.network = nn.Sequential(
            nn.Linear(RBF_CENTERS, 128),
            nn.ReLU(),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, num_actions),
        )

    def forward(self, state):
        features = self.rbf(state)
        return self.network(features)


class ReplayBuffer:
    """Experience replay for off-policy DDQN learning."""

    def __init__(self, capacity):
        self.memory = deque(maxlen=capacity)

    def add(self, state, action, reward, next_state, done):
        self.memory.append(
            (
                np.asarray(state, dtype=np.float32),
                int(action),
                float(reward),
                np.asarray(next_state, dtype=np.float32),
                float(done),
            )
        )

    def sample(self, batch_size):
        batch = random.sample(self.memory, batch_size)

        states, actions, rewards, next_states, dones = zip(*batch)

        return (
            np.asarray(states, dtype=np.float32),
            np.asarray(actions, dtype=np.int64),
            np.asarray(rewards, dtype=np.float32),
            np.asarray(next_states, dtype=np.float32),
            np.asarray(dones, dtype=np.float32),
        )

    def __len__(self):
        return len(self.memory)


class RBFDDQNAgent:
    """Double DQN with an RBF feature representation."""

    def __init__(self):
        self.online = RBFQNetwork(
            STATE_DIM, NUM_ACTIONS
        ).to(DEVICE)

        self.target = RBFQNetwork(
            STATE_DIM, NUM_ACTIONS
        ).to(DEVICE)

        self.target.load_state_dict(
            self.online.state_dict()
        )
        self.target.eval()

        self.optimizer = optim.Adam(
            self.online.parameters(),
            lr=LEARNING_RATE,
        )

        self.loss_fn = nn.SmoothL1Loss()
        self.replay = ReplayBuffer(REPLAY_CAPACITY)

        self.gamma = GAMMA
        self.epsilon = EPSILON_START
        self.train_steps = 0

    def select_action(self, state, explore=True):
        if explore and random.random() < self.epsilon:
            return random.randrange(NUM_ACTIONS)

        state_tensor = torch.as_tensor(
            state,
            dtype=torch.float32,
            device=DEVICE,
        ).unsqueeze(0)

        with torch.no_grad():
            q_values = self.online(state_tensor)

        return int(q_values.argmax(dim=1).item())

    def learn(self):
        if len(self.replay) < BATCH_SIZE:
            return None

        (
            states,
            actions,
            rewards,
            next_states,
            dones,
        ) = self.replay.sample(BATCH_SIZE)

        states = torch.as_tensor(
            states, device=DEVICE
        )
        actions = torch.as_tensor(
            actions, device=DEVICE
        ).unsqueeze(1)
        rewards = torch.as_tensor(
            rewards, device=DEVICE
        )
        next_states = torch.as_tensor(
            next_states, device=DEVICE
        )
        dones = torch.as_tensor(
            dones, device=DEVICE
        )

        # Current Q(s, a).
        current_q = self.online(states).gather(
            1, actions
        ).squeeze(1)

        # DDQN: online network selects the next action.
        with torch.no_grad():
            next_actions = self.online(
                next_states
            ).argmax(dim=1, keepdim=True)

            # Target network evaluates that action.
            next_q = self.target(
                next_states
            ).gather(1, next_actions).squeeze(1)

            target_q = (
                rewards
                + self.gamma * (1.0 - dones) * next_q
            )

        loss = self.loss_fn(current_q, target_q)

        self.optimizer.zero_grad()
        loss.backward()

        nn.utils.clip_grad_norm_(
            self.online.parameters(), max_norm=1.0
        )

        self.optimizer.step()

        self.train_steps += 1

        if self.train_steps % TARGET_UPDATE_STEPS == 0:
            self.target.load_state_dict(
                self.online.state_dict()
            )

        return float(loss.item())

    def decay_epsilon(self):
        self.epsilon = max(
            EPSILON_END,
            self.epsilon * EPSILON_DECAY,
        )

# ============================================================
# BLOCK 4: SCHEDULING ENVIRONMENT AND REWARD
# ============================================================

def calculate_reward(user, allocation):
    """QoS-aware reward for one user's resource allocation."""

    demand = max(user.demand_mbps, 1e-6)

    # Throughput satisfaction, bounded to [0, 1].
    rate_satisfaction = min(
        allocation["achieved_rate_mbps"] / demand,
        1.0,
    )

    # Resource-use penalties.
    rb_cost = allocation["allocated_rbs"] / TOTAL_RBS

    power_cost = (
        allocation["allocated_power"]
        / TOTAL_POWER_BUDGET
    )

    # Slice-specific latency target.
    latency_limit = SLICE_CONFIG[
        user.slice_name
    ]["max_latency_ms"]

    latency_violation = float(
        user.latency_ms > latency_limit
    )

    reward = (
        2.0 * rate_satisfaction
        - 0.25 * rb_cost
        - 0.20 * power_cost
        - 0.50 * latency_violation
    )

    if allocation["allocated_rbs"] == 0:
        reward -= 0.5

    return float(reward)


def schedule_users(users, agent, training=True):
    """Schedule a complete group of users using the O-DU."""

    odu = ODU()
    odu.reset()

    records = []
    episode_rewards = []
    losses = []

    # Randomize scheduling order to avoid always favoring
    # the same slice or user position.
    users = list(users)
    random.shuffle(users)

    for index, user in enumerate(users):
        state = build_state(
            user, odu, len(users)
        )

        action_index = agent.select_action(
            state, explore=training
        )

        requested_rbs, requested_power = (
            JOINT_ACTIONS[action_index]
        )

        allocation = odu.allocate(
            user,
            requested_rbs,
            requested_power,
        )

        reward = calculate_reward(
            user, allocation
        )

        episode_rewards.append(reward)

        # The next state represents the next user to schedule
        # under the updated O-DU resource budget.
        done = index == len(users) - 1

        if not done:
            next_state = build_state(
                users[index + 1],
                odu,
                len(users),
            )
        else:
            next_state = np.zeros(
                STATE_DIM, dtype=np.float32
            )

        if training:
            agent.replay.add(
                state,
                action_index,
                reward,
                next_state,
                done,
            )

            # Learn every four scheduling decisions.
            if len(agent.replay) >= BATCH_SIZE and index % 4 == 0:
                loss = agent.learn()

                if loss is not None:
                    losses.append(loss)

        records.append(allocation)

    # Check conservation of radio resources.
    total_allocated_rbs = sum(
        row["allocated_rbs"] for row in records
    )

    total_allocated_bandwidth = sum(
        row["allocated_bandwidth_mhz"]
        for row in records
    )

    total_allocated_power = sum(
        row["allocated_power"] for row in records
    )

    assert total_allocated_rbs <= TOTAL_RBS
    assert total_allocated_bandwidth <= (
        TOTAL_BANDWIDTH_MHZ + 1e-6
    )
    assert total_allocated_power <= (
        TOTAL_POWER_BUDGET + 1e-6
    )

    return {
        "records": records,
        "mean_reward": float(np.mean(episode_rewards)),
        "total_reward": float(np.sum(episode_rewards)),
        "mean_loss": (
            float(np.mean(losses)) if losses else np.nan
        ),
        "allocated_rbs": total_allocated_rbs,
        "allocated_bandwidth_mhz": total_allocated_bandwidth,
        "allocated_power": total_allocated_power,
        "remaining_rbs": odu.remaining_rbs,
        "remaining_power": odu.remaining_power,
    }

# ============================================================
# BLOCK 5: TRAINING
# ============================================================

agent = RBFDDQNAgent()

training_history = []

for episode in range(1, NUM_EPISODES + 1):

    # Randomized curriculum over the configured user loads.
    num_users = random.choice(USER_LOADS)

    # Reproducible generation with a different stream per episode.
    user_generator = ORU(seed=SEED + episode)
    users = user_generator.generate_users(num_users)

    result = schedule_users(
        users,
        agent,
        training=True,
    )

    agent.decay_epsilon()

    training_history.append({
        "episode": episode,
        "num_users": num_users,
        "mean_reward": result["mean_reward"],
        "total_reward": result["total_reward"],
        "mean_loss": result["mean_loss"],
        "allocated_rbs": result["allocated_rbs"],
        "allocated_bandwidth_mhz": (
            result["allocated_bandwidth_mhz"]
        ),
        "allocated_power": result["allocated_power"],
        "epsilon": agent.epsilon,
    })

    if episode == 1 or episode % 10 == 0:
        print(
            f"Episode {episode:4d}/{NUM_EPISODES} | "
            f"Users: {num_users:4d} | "
            f"Mean reward: {result['mean_reward']:8.4f} | "
            f"RBs: {result['allocated_rbs']:3d}/"
            f"{TOTAL_RBS} | "
            f"Bandwidth: "
            f"{result['allocated_bandwidth_mhz']:.2f}/"
            f"{TOTAL_BANDWIDTH_MHZ:.2f} MHz | "
            f"Power: {result['allocated_power']:.2f}/"
            f"{TOTAL_POWER_BUDGET:.2f} | "
            f"Epsilon: {agent.epsilon:.3f}"
        )

# Save training history.
history_df = pd.DataFrame(training_history)

history_path = (
    RESULT_DIR / "csv" / "RBF_DDQN_training_history.csv"
)

history_df.to_csv(history_path, index=False)

# Save the learned network and optimizer.
model_path = (
    RESULT_DIR / "models" / "RBF_DDQN_model.pt"
