# ------------------------------------------------------------
# 1. GENERAL EVALUATION SWEEP FUNCTION
# ------------------------------------------------------------

def run_comparison_sweep(
    sweep_name,
    sweep_levels,
    sweep_type,
):
    """
    Evaluate all four models across a set of experimental levels.

    sweep_type:
        "latency"   -> vary latency constraint
        "bandwidth" -> vary available bandwidth
        "rbs"       -> vary resource-block count
        "users"     -> vary the number of users

    Returns a DataFrame with one row per model, level, and repeat.
    """

    records = []

    for level_index, level in enumerate(sweep_levels):

        for repeat in range(EVAL_REPEATS):

            # Ensure all models receive the same user set
            current_seed = (
                SEED
                + level_index * 1000
                + repeat
            )

            # Default configuration for the current experiment
            num_users = FIXED_EVAL_USERS
            total_rbs = TOTAL_RBS
            total_bandwidth_mhz = TOTAL_BANDWIDTH_MHZ
            latency_limit_ms = 20

            if sweep_type == "latency":
                latency_limit_ms = float(level)

            elif sweep_type == "bandwidth":
                total_bandwidth_mhz = float(level)

            elif sweep_type == "rbs":
                total_rbs = int(level)

                # Maintain 0.2 MHz per RB for this sweep.
                total_bandwidth_mhz = total_rbs * 0.2

            elif sweep_type == "users":
                num_users = int(level)

            else:
                raise ValueError(
                    f"Unsupported sweep_type: {sweep_type}"
                )

            users = oru.connect_users(
                num_users=num_users,
                seed=current_seed,
            )

            # Evaluate each model on the same users and configuration
            for model_name in MODEL_NAMES:

                agent = agents[model_name]

                result = evaluate_model(
                    agent=agent,
                    users=users,
                    total_rbs=total_rbs,
                    total_bandwidth_mhz=total_bandwidth_mhz,
                    power_budget=TOTAL_POWER_BUDGET,
                    latency_limit_ms=latency_limit_ms,
                )

                row = {
                    "experiment": sweep_name,
                    "model": MODEL_DISPLAY_NAMES[model_name],
                    "sweep_value": float(level),
                    "repeat": repeat + 1,
                    "num_users": num_users,
                    "total_rbs": total_rbs,
                    "total_bandwidth_mhz": total_bandwidth_mhz,
                    "power_budget": TOTAL_POWER_BUDGET,
                    "latency_limit_ms": latency_limit_ms,
                }

                # Keep scalar evaluation metrics; exclude nested objects
                for metric_name, metric_value in result.items():

                    if metric_name == "details":
                        continue

                    if isinstance(
                        metric_value,
                        (int, float, np.integer, np.floating, bool),
                    ):
                        row[metric_name] = metric_value

                records.append(row)

        print(
            f"{sweep_name}: completed level "
            f"{level} ({level_index + 1}/{len(sweep_levels)})"
        )

    df = pd.DataFrame(records)

    if df.empty:
        raise RuntimeError(
            f"No evaluation results were generated for {sweep_name}."
        )

    # Save the complete repeated-run data
    csv_path = CSV_DIR / f"{sweep_name}.csv"
    df.to_csv(csv_path, index=False)

    print(f"Saved CSV: {csv_path}")

    return df


