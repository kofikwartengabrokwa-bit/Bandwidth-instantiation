MODEL_STYLES = {
    "RBF-DDQN": ("o", "-"),
    "DDQN": ("s", "--"),
    "GGN-DDQN": ("^", "-."),
    "GCN-DDQN": ("D", ":"),
}


def plot_model_comparison(
    df,
    x_label,
    y_column,
    y_label,
    filename,
):
    fig, ax = plt.subplots(figsize=(10, 7))

    for model_name in MODEL_NAMES:
        subset = df[df["model"] == model_name]

        summary = (
            subset.groupby("sweep_value")[y_column]
            .agg(["mean", "std"])
            .reset_index()
        )

        marker, linestyle = MODEL_STYLES[model_name]

        ax.errorbar(
            summary["sweep_value"],
            summary["mean"],
            yerr=summary["std"].fillna(0.0),
            label=model_name,
            marker=marker,
            linestyle=linestyle,
            markersize=7,
            capsize=4,
        )

    ax.set_xlabel(x_label)
    ax.set_ylabel(y_label)
    ax.set_xlim(left=0)
    ax.grid(True, linestyle="--", alpha=0.5)
    ax.legend(loc="best", ncol=2)

    fig.tight_layout()

    fig.savefig(
        FIG_DIR / f"{filename}.png",
        dpi=600,
        bbox_inches="tight",
    )
    fig.savefig(
        FIG_DIR / f"{filename}.eps",
        format="eps",
        dpi=600,
        bbox_inches="tight",
    )

    plt.show()
    plt.close(fig)


