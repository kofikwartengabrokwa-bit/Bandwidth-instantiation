NUM_ACTIONS = len(ACTIONS)
RBF_CENTERS = 128
HIDDEN_DIM = 64


class RBFQNetwork(nn.Module):
    """Radial-basis state representation followed by a Q head."""

    def __init__(self):
        super().__init__()

        centers = torch.rand(RBF_CENTERS, STATE_DIM)
        self.register_buffer("centers", centers)

        self.gamma_rbf = 4.0

        self.head = nn.Sequential(
            nn.Linear(RBF_CENTERS, 128),
            nn.ReLU(),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, NUM_ACTIONS),
        )

    def forward(self, x):
        distance = (
            x.unsqueeze(1) - self.centers.unsqueeze(0)
        ).pow(2).sum(dim=2)

        features = torch.exp(-self.gamma_rbf * distance)
        return self.head(features)


class DDQNQNetwork(nn.Module):
    """Conventional fully connected Q-network."""

    def __init__(self):
        super().__init__()

        self.network = nn.Sequential(
            nn.Linear(STATE_DIM, 128),
            nn.ReLU(),
            nn.Linear(128, 128),
            nn.ReLU(),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, NUM_ACTIONS),
        )

    def forward(self, x):
        return self.network(x)


def make_feature_adjacency(n_features):
    """
    Build a fixed feature graph.

    Each state feature is a node. Adjacent feature indices
    are connected, with self-loops.
    """
    adjacency = torch.eye(n_features)

    for i in range(n_features - 1):
        adjacency[i, i + 1] = 1.0
        adjacency[i + 1, i] = 1.0

    degree = adjacency.sum(dim=1).clamp(min=1.0)

    # Symmetric degree normalization.
    inv_sqrt = torch.diag(degree.pow(-0.5))
    normalized = inv_sqrt @ adjacency @ inv_sqrt

    return normalized


class GGNQNetwork(nn.Module):
    """
    Graph-neighborhood aggregation Q-network.

    Each state feature becomes a node embedding. Neighbor
    aggregation is combined with the original embedding.
    """

    def __init__(self):
        super().__init__()

        self.register_buffer(
            "adjacency",
            make_feature_adjacency(STATE_DIM),
        )

        self.node_encoder = nn.Linear(1, HIDDEN_DIM)

        self.neighbor_update = nn.Sequential(
            nn.Linear(HIDDEN_DIM * 2, HIDDEN_DIM),
            nn.ReLU(),
            nn.Linear(HIDDEN_DIM, HIDDEN_DIM),
            nn.ReLU(),
        )

        self.q_head = nn.Sequential(
            nn.Linear(HIDDEN_DIM, 128),
            nn.ReLU(),
            nn.Linear(128, NUM_ACTIONS),
        )

    def forward(self, x):
        # x: [batch, features]
        node_values = x.unsqueeze(-1)
        node_embeddings = torch.relu(
            self.node_encoder(node_values)
        )

        neighbors = torch.einsum(
            "ij,bjh->bih",
            self.adjacency,
            node_embeddings,
        )

        combined = torch.cat(
            [node_embeddings, neighbors],
            dim=-1,
        )

        updated = self.neighbor_update(combined)
        graph_embedding = updated.mean(dim=1)

        return self.q_head(graph_embedding)


class GCNQNetwork(nn.Module):
    """
    Graph convolutional Q-network over the same feature graph.
    """

    def __init__(self):
        super().__init__()

        self.register_buffer(
            "adjacency",
            make_feature_adjacency(STATE_DIM),
        )

        self.input_projection = nn.Linear(1, HIDDEN_DIM)
        self.graph_conv1 = nn.Linear(HIDDEN_DIM, HIDDEN_DIM)
        self.graph_conv2 = nn.Linear(HIDDEN_DIM, HIDDEN_DIM)

        self.q_head = nn.Sequential(
            nn.Linear(HIDDEN_DIM, 128),
            nn.ReLU(),
            nn.Linear(128, NUM_ACTIONS),
        )

    def forward(self, x):
        h = torch.relu(
            self.input_projection(x.unsqueeze(-1))
        )

        h = torch.einsum(
            "ij,bjh->bih",
            self.adjacency,
            h,
        )
        h = torch.relu(self.graph_conv1(h))

        h = torch.einsum(
            "ij,bjh->bih",
            self.adjacency,
            h,
        )
        h = torch.relu(self.graph_conv2(h))

        graph_embedding = h.mean(dim=1)
        return self.q_head(graph_embedding)


NETWORK_FACTORIES = {
    "RBF-DDQN": RBFQNetwork,
    "DDQN": DDQNQNetwork,
    "GGN-DDQN": GGNQNetwork,
    "GCN-DDQN": GCNQNetwork,
}

