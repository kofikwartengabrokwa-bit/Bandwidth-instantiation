torch.save({
    "online_state_dict": agent.online.state_dict(),
    "target_state_dict": agent.target.state_dict(),
    "optimizer_state_dict": agent.optimizer.state_dict(),
    "epsilon": agent.epsilon,
    "state_dim": STATE_DIM,
    "num_actions": NUM_ACTIONS,
    "rb_actions": RB_ACTIONS,
    "power_actions": POWER_ACTIONS,
}, model_path)

print("\nTraining completed.")
print("Training history:", history_path)
print("Saved model     :", model_path)

# ============================================================
# BLOCK 6: EVALUATION FOR INCREASING USER LOADS
# ============================================================

evaluation_records = []
slice_records = []

for num_users in USER_LOADS:

    # Identical generated test users for repeatable comparisons.
    test_oru = ORU(seed=SEED + 100_000 + num_users)
    test_users = test_oru.generate_users(num_users)

