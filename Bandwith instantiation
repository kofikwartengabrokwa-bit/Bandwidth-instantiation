# ------------------------------------------------------------
# 9.2 Evaluate each agent on matching environment seeds
# ------------------------------------------------------------


episode_results = []
summary_results = []

for agent_name, current_agent in evaluation_agents.items():

    rewards = []
    powers = []
    total_prbs = []
    slice_prbs = {name: [] for name in SLICE_NAMES}
    slice_bandwidth = {name: [] for name in SLICE_NAMES}

    for episode in range(EVAL_EPISODES):

        eval_seed = EVAL_SEED_START + episode
        state, info = evaluation_env.reset(seed=eval_seed)

        total_reward = 0.0
        done = False

        while not done:
            # Greedy evaluation: disable epsilon exploration.
            action = current_agent.select_action(
                state, explore=False
            )

            next_state, reward, terminated, truncated, info = (
                evaluation_env.step(action)
            )

            done = terminated or truncated
            total_reward += float(reward)
            state = next_state

        # Extract final resource-allocation metrics.
        allocated = np.asarray(
            info["allocated_prbs"], dtype=np.float64
        )

        if "bandwidth_mhz" in info:
            bandwidth = np.asarray(
                info["bandwidth_mhz"], dtype=np.float64
            )
        else:
            bandwidth = (
                allocated / N_PRBS
            ) * BANDWIDTH_MHZ

        episode_power = float(info["total_power_w"])
        episode_prbs = int(allocated.sum())

        rewards.append(total_reward)
        powers.append(episode_power)
        total_prbs.append(episode_prbs)

        for idx, slice_name in enumerate(SLICE_NAMES):
            slice_prbs[slice_name].append(
                float(allocated[idx])
            )
            slice_bandwidth[slice_name].append(
                float(bandwidth[idx])
            )

        # Save per-episode results.
        episode_row = {
            "algorithm": agent_name,
            "episode": episode + 1,
            "seed": eval_seed,
            "reward": total_reward,
            "total_prbs": episode_prbs,
            "total_power_w": episode_power,
        }

        for idx, slice_name in enumerate(SLICE_NAMES):
            episode_row[f"{slice_name}_prbs"] = float(
                allocated[idx]
            )
            episode_row[f"{slice_name}_bandwidth_mhz"] = float(
                bandwidth[idx]
            )

        episode_results.append(episode_row)

    # Aggregate evaluation metrics.
    summary = {
        "algorithm": agent_name,
        "evaluation_episodes": EVAL_EPISODES,
        "mean_reward": float(np.mean(rewards)),
        "std_reward": float(np.std(rewards, ddof=1)),
        "min_reward": float(np.min(rewards)),
        "max_reward": float(np.max(rewards)),
        "mean_power_w": float(np.mean(powers)),
        "std_power_w": float(np.std(powers, ddof=1)),
        "mean_total_prbs": float(np.mean(total_prbs)),
        "std_total_prbs": float(np.std(total_prbs, ddof=1)),
    }

    for slice_name in SLICE_NAMES:
        summary[f"mean_{slice_name}_prbs"] = float(
            np.mean(slice_prbs[slice_name])
        )
        summary[f"mean_{slice_name}_bandwidth_mhz"] = float(
            np.mean(slice_bandwidth[slice_name])
        )

    summary_results.append(summary)

    print(
        f"{agent_name:10s} | "
        f"Mean reward: {summary['mean_reward']:8.3f} | "
        f"Std reward: {summary['std_reward']:7.3f} | "
        f"Mean power: {summary['mean_power_w']:6.3f} W | "
        f"Mean PRBs: {summary['mean_total_prbs']:6.2f}"
    )



