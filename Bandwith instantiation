def plot_model_comparison(
    df,
    x_column,
    x_label,
    y_column,
    y_label,
    filename,
    percentage=False,
):
    """
    Plot the mean metric for each model at each sweep level.

    Output:
        PNG at 600 dpi
        EPS at 600 dpi

    The input DataFrame is not modified.
    """

    data = df.copy()

    # Standardize internal model names for publication figures
    data["model"] = (
        data["model"]
        .astype(str)
        .map(lambda name: MODEL_DISPLAY_NAMES.get(name, name))
    )

    # Convert values to numeric
    data[x_column] = pd.to_numeric(
        data[x_column],
        errors="coerce",
    )

    data[y_column] = pd.to_numeric(
        data[y_column],
        errors="coerce",
    )

    # Remove missing or invalid observations
    data = data.dropna(
        subset=["model", x_column, y_column]
    )

    if data.empty:
        raise ValueError(
            f"No valid observations are available for {filename}."
        )

    # Validate model labels
    unexpected_models = sorted(
        set(data["model"].unique()) - set(PLOT_MODEL_ORDER)
    )

    if unexpected_models:
        raise ValueError(
            f"Unexpected model names in {filename}: {unexpected_models}"
        )

    # Average repeated evaluation runs
    summary = (
        data.groupby(
            ["model", x_column],
            as_index=False,
        )[y_column]
        .mean()
    )

    # --------------------------------------------------------
    # CREATE FIGURE
    # --------------------------------------------------------

    fig, ax = plt.subplots(figsize=(9.0, 6.2))

    plotted_models = []

    for model_name in PLOT_MODEL_ORDER:

        model_data = summary[
            summary["model"] == model_name
        ].sort_values(x_column)

        if model_data.empty:
            print(
                f"Warning: {model_name} has no data in {filename}."
            )
            continue

        marker, linestyle = MODEL_STYLES[model_name]

        ax.plot(
            model_data[x_column].to_numpy(),
            model_data[y_column].to_numpy(),
            label=model_name,
            marker=marker,
            linestyle=linestyle,
            linewidth=2.5,
            markersize=8,
            markerfacecolor="none",
        )

        plotted_models.append(model_name)

    if not plotted_models:
        plt.close(fig)
        raise ValueError(
            f"No models could be plotted for {filename}."
        )

    # --------------------------------------------------------
    # AXES AND LABELS
    # --------------------------------------------------------

    ax.set_xlabel(x_label, labelpad=8)
    ax.set_ylabel(y_label, labelpad=8)

    # Start the x-axis at zero for nonnegative sweep values
    if summary[x_column].min() >= 0:
        ax.set_xlim(left=0)

    # Avoid negative y-axis values for nonnegative metrics
    if summary[y_column].min() >= 0:
        ax.set_ylim(bottom=0)

    # Display ratios as percentages when stored as fractions
    if percentage:

        maximum_value = summary[y_column].max()

        if maximum_value <= 1.0 + 1e-9:
            ax.set_ylim(0, 1.05)

            fraction_ticks = np.linspace(0, 1, 6)

            ax.set_yticks(fraction_ticks)
            ax.set_yticklabels([
                f"{value * 100:.0f}"
                for value in fraction_ticks
            ])

    # --------------------------------------------------------
    # GRID AND TICKS
    # --------------------------------------------------------

    ax.grid(
        True,
        which="major",
        linestyle="--",
        linewidth=0.7,
        alpha=0.45,
    )

    ax.set_axisbelow(True)

    ax.tick_params(
        axis="both",
        which="major",
        direction="in",
        length=5,
        width=1.2,
    )

    for spine in ax.spines.values():
        spine.set_linewidth(1.3)

    # --------------------------------------------------------
    # LEGEND IN REQUIRED ORDER
    # --------------------------------------------------------

    handles, labels = ax.get_legend_handles_labels()

    handle_map = dict(zip(labels, handles))

    ordered_labels = [
        name
        for name in PLOT_MODEL_ORDER
        if name in handle_map
    ]

    ordered_handles = [
        handle_map[name]
        for name in ordered_labels
    ]

    ax.legend(
        ordered_handles,
        ordered_labels,
        loc="best",
        ncol=2,
        frameon=True,
        edgecolor="black",
        fancybox=False,
        framealpha=1.0,
    )

    fig.tight_layout()

    # --------------------------------------------------------
    # SAVE FIGURES
    # --------------------------------------------------------

    png_path = FIG_DIR / f"{filename}.png"
    eps_path = FIG_DIR / f"{filename}.eps"

    fig.savefig(
        png_path,
        format="png",
        dpi=600,
        bbox_inches="tight",
    )

    fig.savefig(
        eps_path,
        format="eps",
        dpi=600,
        bbox_inches="tight",
    )

    print(f"Saved PNG: {png_path}")
    print(f"Saved EPS: {eps_path}")

    # Show the figure during execution
    plt.show(block=True)

    # Close after the displayed window is closed
    plt.close(fig)

    return summary


