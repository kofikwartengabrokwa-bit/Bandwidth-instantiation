import numpy as np
import gymnasium as gym
from gymnasium import spaces

# Reuse configuration from the earlier blocks.
SLICE_NAMES = ["IoT", "M2M", "Vehicular", "eMBB"]
N_SLICES = len(SLICE_NAMES)

N_PRBS = 52
BANDWIDTH_MHZ = 10.0

# Illustrative power levels per allocated PRB (watts).
POWER_LEVELS_W = np.array([0.10, 0.20, 0.30], dtype=np.float32)
POWER_BUDGET_W = 12.0

# Illustrative relative utility weights; tune and justify for experiments.
SLICE_WEIGHTS = np.array([1.0, 1.2, 2.0, 1.5], dtype=np.float32)


class FourSliceResourceEnv(gym.Env):
    """
    Prototype shared-resource environment.

    One discrete action selects:
      - one of four slices;
      - one of three power levels.

    Each valid action allocates one PRB to the selected slice.
    Bandwidth is derived from the PRB allocation.
    """

    metadata = {"render_modes": []}

    def __init__(self, seed=420):
        super().__init__()

        self.n_slices = N_SLICES
        self.n_prbs = N_PRBS
        self.bandwidth_mhz = BANDWIDTH_MHZ
        self.power_budget_w = POWER_BUDGET_W

        # 4 slices x 3 power levels = 12 discrete actions.
        self.action_space = spaces.Discrete(
            self.n_slices * len(POWER_LEVELS_W)
        )

        # Per slice: demand, allocated PRBs, allocated power, unmet demand.
        # Plus global remaining PRBs and remaining power.
        self.observation_space = spaces.Box(
            low=0.0,
            high=1.0,
            shape=(4 * self.n_slices + 2,),
            dtype=np.float32,
        )

        self._initial_seed = seed
        self.reset(seed=seed)

    def reset(self, seed=None, options=None):
        super().reset(seed=seed)

        # Synthetic episode demand, in PRBs per slice.
        # Replace this with trace-driven traffic when dataset semantics
        # and slice labels have been verified.
        nominal = np.array([8, 10, 20, 26], dtype=np.float32)
        variation = self.np_random.uniform(0.80, 1.20, self.n_slices)
        self.demand = np.maximum(
            1.0, np.round(nominal * variation)
        ).astype(np.float32)

        self.allocated = np.zeros(self.n_slices, dtype=np.float32)
        self.slice_power = np.zeros(self.n_slices, dtype=np.float32)

        self.used_prbs = 0
        self.total_power = 0.0
        self.steps = 0

        return self._get_obs(), self._get_info()

    def _get_obs(self):
        demand_norm = np.clip(self.demand / self.n_prbs, 0, 1)
        allocation_norm = self.allocated / self.n_prbs
        power_norm = np.clip(
            self.slice_power / self.power_budget_w, 0, 1
        )
        unmet_norm = np.clip(
            np.maximum(self.demand - self.allocated, 0)
            / self.n_prbs,
            0,
            1,
        )

        remaining_prbs = (self.n_prbs - self.used_prbs) / self.n_prbs
        remaining_power = max(
            0.0, self.power_budget_w - self.total_power
        ) / self.power_budget_w

        obs = np.concatenate([
            demand_norm,
            allocation_norm,
            power_norm,
            unmet_norm,
            np.array([remaining_prbs, remaining_power], dtype=np.float32),
        ])

        return obs.astype(np.float32)

    def _get_info(self):
        prb_bandwidth_mhz = self.bandwidth_mhz / self.n_prbs

        return {
            "slice_names": SLICE_NAMES.copy(),
            "demand_prbs": self.demand.astype(int).tolist(),
            "allocated_prbs": self.allocated.astype(int).tolist(),
            "allocated_bandwidth_mhz": (
                self.allocated * prb_bandwidth_mhz
            ).tolist(),
            "slice_power_w": self.slice_power.tolist(),
            "total_allocated_prbs": int(self.used_prbs),
            "total_power_w": float(self.total_power),
            "remaining_power_w": float(
                max(0.0, self.power_budget_w - self.total_power)
            ),
        }

    def step(self, action):
        action = int(action)
        if not self.action_space.contains(action):
            raise ValueError(f"Invalid action: {action}")

        slice_idx = action // len(POWER_LEVELS_W)
        power_idx = action % len(POWER_LEVELS_W)
        requested_power = float(POWER_LEVELS_W[power_idx])

        reward = 0.0
        allocated_now = False

        # Do not exceed the shared PRB or power budgets.
        power_fits = (
            self.total_power + requested_power
            <= self.power_budget_w + 1e-8
        )
        prbs_remain = self.used_prbs < self.n_prbs

        if prbs_remain and power_fits:
            # Marginal service benefit decreases once demand is satisfied.
            if self.allocated[slice_idx] < self.demand[slice_idx]:
                demand = max(float(self.demand[slice_idx]), 1.0)
                service_gain = (
                    self.demand[slice_idx] - self.allocated[slice_idx]
                ) / demand

                reward += float(
                    SLICE_WEIGHTS[slice_idx] * service_gain
                )
            else:
                # Extra PRBs can be used, but receive a small marginal
                # benefit to discourage allocating everything to one slice.
                reward += 0.05 * float(SLICE_WEIGHTS[slice_idx])

            # Small cost for power consumption.
            reward -= 0.10 * requested_power

            self.allocated[slice_idx] += 1.0
            self.slice_power[slice_idx] += requested_power
            self.total_power += requested_power
            self.used_prbs += 1
            allocated_now = True
        else:
            # Invalid resource request incurs a penalty.
            reward -= 0.5

        self.steps += 1

        terminated = self.used_prbs >= self.n_prbs
        truncated = self.steps >= self.n_prbs

        info = self._get_info()
        info["action_allocated_prb"] = allocated_now
        info["selected_slice"] = SLICE_NAMES[slice_idx]
        info["selected_power_w"] = requested_power

        return (
            self._get_obs(),
            float(reward),
            terminated,
            truncated,
            info,
        )


