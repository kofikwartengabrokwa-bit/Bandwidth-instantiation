# ------------------------------------------------------------
# 7.1 Four-slice graph convolution layer
# ------------------------------------------------------------

class SliceGraphConv(nn.Module):
    """
    Lightweight graph convolution:
        H' = ReLU(A_hat H W)

    The four slice nodes use normalized PRB demand, allocated PRBs,
    remaining demand, and slice priority as node features.
    """

    def __init__(self, in_features, out_features):
        super().__init__()

        self.linear = nn.Linear(in_features, out_features)

    def forward(self, node_features, adjacency):
        aggregated = torch.matmul(adjacency, node_features)
        return torch.relu(self.linear(aggregated))


# ------------------------------------------------------------
# 7.2 GCN-based Q-network
# ------------------------------------------------------------

class GCNQNetwork(nn.Module):

    def __init__(
        self,
        state_dim,
        action_dim,
        num_slices=4,
        node_features=4,
        hidden_dim=64
    ):
        super().__init__()

        self.num_slices = num_slices
        self.node_features = node_features

        # State structure:
        # 4 slice-wise vectors (each of length 4) + 2 global values.
        self.global_dim = state_dim - num_slices * node_features

        if self.global_dim < 0:
            raise ValueError("Invalid state dimension for GCN encoder.")

        self.gcn1 = SliceGraphConv(node_features, hidden_dim)
        self.gcn2 = SliceGraphConv(hidden_dim, hidden_dim)

        self.q_head = nn.Sequential(
            nn.Linear(
                num_slices * hidden_dim + self.global_dim,
                hidden_dim
            ),
            nn.ReLU(),
            nn.Linear(hidden_dim, action_dim)
        )

        # Fully connected four-slice graph with self-loops.
        adjacency = torch.ones(num_slices, num_slices)

        # Symmetric degree normalization.
        degree = adjacency.sum(dim=1)
        inv_sqrt_degree = degree.pow(-0.5)
        normalized_adjacency = (
            inv_sqrt_degree[:, None]
            * adjacency
            * inv_sqrt_degree[None, :]
        )

        self.register_buffer(
            "adjacency", normalized_adjacency
        )

    def forward(self, state):
        if state.dim() == 1:
            state = state.unsqueeze(0)

        batch_size = state.shape[0]

        slice_end = self.num_slices * self.node_features

        node_features = state[:, :slice_end].reshape(
            batch_size,
            self.num_slices,
            self.node_features
        )

        global_features = state[:, slice_end:]

        graph_embeddings = self.gcn1(
            node_features, self.adjacency
        )

        graph_embeddings = self.gcn2(
            graph_embeddings, self.adjacency
        )

        graph_embeddings = graph_embeddings.reshape(
            batch_size, -1
        )

        combined = torch.cat(
            [graph_embeddings, global_features], dim=1
        )

        return self.q_head(combined)


# ------------------------------------------------------------
# 7.3 GCN-DDQN agent
# ------------------------------------------------------------

class GCNDDQNAgent:

    def __init__(
        self,
        state_dim,
        action_dim,
        learning_rate=1e-3,
        gamma=0.99,
        batch_size=64,
        buffer_capacity=20000,
        target_update_frequency=100,
        epsilon_start=1.0,
        epsilon_min=0.05,
        epsilon_decay=0.995
    ):
        self.action_dim = action_dim
        self.gamma = gamma
        self.batch_size = batch_size
        self.target_update_frequency = target_update_frequency

        self.epsilon = epsilon_start
        self.epsilon_min = epsilon_min
        self.epsilon_decay = epsilon_decay
        self.training_steps = 0

        self.online_net = GCNQNetwork(
            state_dim, action_dim
        ).to(DEVICE)

        self.target_net = GCNQNetwork(
            state_dim, action_dim
        ).to(DEVICE)

        self.target_net.load_state_dict(
            self.online_net.state_dict()
        )
        self.target_net.eval()

        self.optimizer = optim.Adam(
            self.online_net.parameters(),
            lr=learning_rate
        )

        self.loss_function = nn.SmoothL1Loss()
        self.replay_buffer = ReplayBuffer(buffer_capacity)

    def select_action(self, state, explore=True):
        if explore and random.random() < self.epsilon:
            return random.randrange(self.action_dim)

        state_tensor = torch.as_tensor(
            np.asarray(state, dtype=np.float32),
            dtype=torch.float32,
            device=DEVICE
        ).unsqueeze(0)

        self.online_net.eval()

        with torch.no_grad():
            action = int(
                self.online_net(state_tensor)
                .argmax(dim=1).item()
            )

        self.online_net.train()
        return action

    def store_transition(
        self, state, action, reward, next_state, done
    ):
        self.replay_buffer.add(
            state, action, reward, next_state, done
        )

    def train_step(self):
        if len(self.replay_buffer) < self.batch_size:
            return None

        states, actions, rewards, next_states, dones = (
            self.replay_buffer.sample(self.batch_size)
        )

        states = torch.as_tensor(
            states, dtype=torch.float32, device=DEVICE
        )
        actions = torch.as_tensor(
            actions, dtype=torch.long, device=DEVICE
        ).unsqueeze(1)
        rewards = torch.as_tensor(
            rewards, dtype=torch.float32, device=DEVICE
        )
        next_states = torch.as_tensor(
            next_states, dtype=torch.float32, device=DEVICE
        )
        dones = torch.as_tensor(
            dones, dtype=torch.float32, device=DEVICE
        )

        current_q = self.online_net(states).gather(
            1, actions
        ).squeeze(1)

        # Double DQN target calculation.
        with torch.no_grad():
            next_actions = self.online_net(
                next_states
            ).argmax(dim=1, keepdim=True)

            next_q = self.target_net(
                next_states
            ).gather(1, next_actions).squeeze(1)

            target_q = rewards + (
                self.gamma * (1.0 - dones) * next_q
            )

        loss = self.loss_function(current_q, target_q)

        self.optimizer.zero_grad()
        loss.backward()

        nn.utils.clip_grad_norm_(
            self.online_net.parameters(), max_norm=1.0
        )

        self.optimizer.step()
        self.training_steps += 1

        if (
            self.training_steps
            % self.target_update_frequency == 0
        ):
            self.target_net.load_state_dict(
                self.online_net.state_dict()
            )

        return float(loss.item())

    def decay_epsilon(self):
        self.epsilon = max(
            self.epsilon_min,
            self.epsilon * self.epsilon_decay
        )


