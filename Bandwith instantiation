def metric_plot(
    values,
    errors,
    ylabel,
    filename,
    nonnegative=False,
):
    """Create a bar plot with standard-deviation error bars."""
    values = np.asarray(values, dtype=float)
    errors = np.asarray(errors, dtype=float)

    # Replace undefined standard deviations for single observations.
    errors = np.nan_to_num(errors, nan=0.0)

    fig, ax = plt.subplots(figsize=(10, 6))

    ax.bar(
        x,
        values,
        width=bar_width,
        yerr=errors,
        capsize=5,
        edgecolor="black",
        linewidth=0.8,
        label="Mean ± SD",
    )

    ax.set_xticks(x)
    ax.set_xticklabels(algorithms, rotation=0)
    ax.set_ylabel(ylabel)
    ax.set_xlim(-0.5, len(algorithms) - 0.5)
    ax.grid(axis="y", linestyle="--", alpha=0.4)
    ax.set_axisbelow(True)

    if nonnegative:
        ax.set_ylim(bottom=0)

    ax.legend(
        loc="upper center",
        bbox_to_anchor=(0.5, 1.16),
        ncol=1,
        frameon=False,
    )

    fig.tight_layout()
    save_figure(fig, filename)


