# ------------------------------------------------------------
# 8.1 Gated graph message-passing layer
# ------------------------------------------------------------

class GatedGraphLayer(nn.Module):
    """
    Gated graph update:
      1. Aggregate neighboring node representations.
      2. Transform the aggregated messages.
      3. Update each node with a GRU cell.
    """

    def __init__(self, hidden_dim):
        super().__init__()

        self.message_linear = nn.Linear(
            hidden_dim, hidden_dim
        )

        self.gru = nn.GRUCell(
            input_size=hidden_dim,
            hidden_size=hidden_dim
        )

        self.norm = nn.LayerNorm(hidden_dim)

    def forward(self, node_states, adjacency):
        # node_states: (batch, nodes, hidden_dim)
        messages = torch.matmul(
            adjacency, node_states
        )

        messages = torch.relu(
            self.message_linear(messages)
        )

        batch_size, num_nodes, hidden_dim = node_states.shape

        # Apply a GRU update independently to each node.
        old_states = node_states.reshape(
            batch_size * num_nodes, hidden_dim
        )

        incoming_messages = messages.reshape(
            batch_size * num_nodes, hidden_dim
        )

        updated_states = self.gru(
            incoming_messages, old_states
        )

        updated_states = updated_states.reshape(
            batch_size, num_nodes, hidden_dim
        )

        return self.norm(updated_states)


# ------------------------------------------------------------
# 8.2 GGN-based Q-network
# ------------------------------------------------------------

class GGNQNetwork(nn.Module):

    def __init__(
        self,
        state_dim,
        action_dim,
        num_slices=4,
        node_features=4,
        hidden_dim=64,
        message_passing_steps=2
    ):
        super().__init__()

        self.num_slices = num_slices
        self.node_features = node_features

        self.global_dim = (
            state_dim - num_slices * node_features
        )

        if self.global_dim < 0:
            raise ValueError(
                "Invalid state dimension for GGN encoder."
            )

        self.node_encoder = nn.Sequential(
            nn.Linear(node_features, hidden_dim),
            nn.ReLU()
        )

        self.gated_layers = nn.ModuleList([
            GatedGraphLayer(hidden_dim)
            for _ in range(message_passing_steps)
        ])

        self.q_head = nn.Sequential(
            nn.Linear(
                num_slices * hidden_dim + self.global_dim,
                hidden_dim
            ),
            nn.ReLU(),
            nn.Linear(hidden_dim, action_dim)
        )

        # Fully connected slice graph with self-loops.
        adjacency = torch.ones(
            num_slices, num_slices
        )

        degree = adjacency.sum(dim=1)
        inv_sqrt_degree = degree.pow(-0.5)

        normalized_adjacency = (
            inv_sqrt_degree[:, None]
            * adjacency
            * inv_sqrt_degree[None, :]
        )

        self.register_buffer(
            "adjacency", normalized_adjacency
        )

    def forward(self, state):
        if state.dim() == 1:
            state = state.unsqueeze(0)

        batch_size = state.shape[0]

        slice_end = (
            self.num_slices * self.node_features
        )

        node_features = state[:, :slice_end].reshape(
            batch_size,
            self.num_slices,
            self.node_features
        )

        global_features = state[:, slice_end:]

        node_states = self.node_encoder(node_features)

        for layer in self.gated_layers:
            node_states = layer(
                node_states, self.adjacency
            )

        graph_embedding = node_states.reshape(
            batch_size, -1
        )

        combined = torch.cat(
            [graph_embedding, global_features],
            dim=1
        )

        return self.q_head(combined)


