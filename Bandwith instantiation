            scenario_fn(value)
        )

        for repeat in range(EVAL_REPEATS):
            shared_users = generate_users(
                FIXED_EVAL_USERS,
                seed=SEED + 100_000 + repeat * 1000 + int(value * 10),
            )

            for model_name in MODEL_NAMES:
                result = evaluate_model(
                    model_agent=agents[model_name],
                    users=copy.deepcopy(shared_users),
                    total_rbs=total_rbs,
                    bandwidth_mhz=bandwidth_mhz,
                    power_budget=TOTAL_POWER_BUDGET,
                    latency_limit_ms=latency_limit_ms,
                )

                rows.append({
                    "experiment": experiment_name,
                    "sweep_value": value,
                    "repeat": repeat,
                    "model": model_name,
                    "throughput_mbps": result["throughput_mbps"],
                    "energy_proxy": result["energy_proxy"],
                    "total_power": result["total_power"],
                    "allocated_rbs": result["allocated_rbs"],
                    "allocated_bandwidth_mhz": (
                        result["allocated_bandwidth_mhz"]
                    ),
                    "users_served": result["users_served"],
                })

        print(
            f"Completed {experiment_name}: "
            f"value={value}"
        )

    return pd.DataFrame(rows)


