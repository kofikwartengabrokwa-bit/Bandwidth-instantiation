# ------------------------------------------------------------
# 5.2 RBF feature transformation
# ------------------------------------------------------------

class RBFFeatureLayer(nn.Module):
    """
    Learnable radial basis function feature transformation.

    Input:
        Normalized environment states, shape (batch, state_dim)

    Output:
        RBF feature vectors, shape (batch, num_centers)
    """

    def __init__(self, input_dim, num_centers=64, initial_gamma=4.0):
        super().__init__()

        self.centers = nn.Parameter(
            torch.rand(num_centers, input_dim)
        )

        self.log_gamma = nn.Parameter(
            torch.tensor(float(np.log(initial_gamma)))
        )

    def forward(self, x):
        # Squared Euclidean distance from each state to each center.
        differences = x.unsqueeze(1) - self.centers.unsqueeze(0)

        squared_distances = torch.sum(
            differences ** 2, dim=2
        )

        gamma = torch.exp(self.log_gamma).clamp(
            min=1e-4, max=100.0
        )

        # Gaussian radial basis functions.
        features = torch.exp(-gamma * squared_distances)

        return features


# ------------------------------------------------------------
# 5.3 RBF-based Q-network
# ------------------------------------------------------------

class RBFQNetwork(nn.Module):
    """
    RBF features followed by a neural network that estimates
    Q-values for all discrete resource-allocation actions.
    """

    def __init__(
        self,
        state_dim,
        action_dim,
        num_centers=64,
        hidden_dim=128
    ):
        super().__init__()

        self.rbf = RBFFeatureLayer(
            input_dim=state_dim,
            num_centers=num_centers
        )

        self.q_head = nn.Sequential(
            nn.Linear(num_centers, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, action_dim)
        )

    def forward(self, state):
        rbf_features = self.rbf(state)
        q_values = self.q_head(rbf_features)
        return q_values


# ------------------------------------------------------------
# 5.4 Experience replay buffer
# ------------------------------------------------------------

class ReplayBuffer:
    def __init__(self, capacity=20000):
        self.memory = deque(maxlen=capacity)

    def add(self, state, action, reward, next_state, done):
        self.memory.append(
            (
                np.asarray(state, dtype=np.float32),
                int(action),
                float(reward),
                np.asarray(next_state, dtype=np.float32),
                float(done)
            )
        )

    def sample(self, batch_size):
        batch = random.sample(self.memory, batch_size)

        states, actions, rewards, next_states, dones = zip(*batch)

        return (
            np.asarray(states, dtype=np.float32),
            np.asarray(actions, dtype=np.int64),
            np.asarray(rewards, dtype=np.float32),
            np.asarray(next_states, dtype=np.float32),
            np.asarray(dones, dtype=np.float32)
        )

    def __len__(self):
        return len(self.memory)


# ------------------------------------------------------------
# 5.5 Double DQN agent
# ------------------------------------------------------------

class RBFDDQNAgent:

    def __init__(
        self,
        state_dim,
        action_dim,
        learning_rate=1e-3,
        gamma=0.99,
        batch_size=64,
        buffer_capacity=20000,
        target_update_frequency=100,
        epsilon_start=1.0,
        epsilon_min=0.05,
        epsilon_decay=0.995
    ):
        self.state_dim = state_dim
        self.action_dim = action_dim

        self.gamma = gamma
        self.batch_size = batch_size
        self.target_update_frequency = target_update_frequency

        self.epsilon = epsilon_start
        self.epsilon_min = epsilon_min
        self.epsilon_decay = epsilon_decay

        # Online network.
        self.online_net = RBFQNetwork(
            state_dim, action_dim
        ).to(DEVICE)

        # Target network.
        self.target_net = RBFQNetwork(
            state_dim, action_dim
        ).to(DEVICE)

        self.target_net.load_state_dict(
            self.online_net.state_dict()
        )

        self.target_net.eval()

        self.optimizer = optim.Adam(
            self.online_net.parameters(),
            lr=learning_rate
        )

        self.loss_function = nn.SmoothL1Loss()

        self.replay_buffer = ReplayBuffer(
            capacity=buffer_capacity
        )

        self.training_steps = 0

    def select_action(self, state, explore=True):
        # Epsilon-greedy exploration.
        if explore and random.random() < self.epsilon:
            return random.randrange(self.action_dim)

        state_tensor = torch.as_tensor(
            np.asarray(state, dtype=np.float32),
            dtype=torch.float32,
            device=DEVICE
        ).unsqueeze(0)

        self.online_net.eval()

        with torch.no_grad():
            q_values = self.online_net(state_tensor)
            action = int(torch.argmax(q_values, dim=1).item())

        self.online_net.train()

        return action

    def store_transition(
        self, state, action, reward, next_state, done
    ):
        self.replay_buffer.add(
            state, action, reward, next_state, done
        )

    def train_step(self):
        if len(self.replay_buffer) < self.batch_size:
            return None

        (
            states,
            actions,
            rewards,
            next_states,
            dones
        ) = self.replay_buffer.sample(self.batch_size)

        states = torch.as_tensor(
            states, dtype=torch.float32, device=DEVICE
        )

        actions = torch.as_tensor(
            actions, dtype=torch.long, device=DEVICE
        ).unsqueeze(1)

        rewards = torch.as_tensor(
            rewards, dtype=torch.float32, device=DEVICE
        )

        next_states = torch.as_tensor(
            next_states, dtype=torch.float32, device=DEVICE
        )

        dones = torch.as_tensor(
            dones, dtype=torch.float32, device=DEVICE
        )

        # Q(s,a) from the online network.
        current_q = self.online_net(states).gather(
            1, actions
        ).squeeze(1)

        # Double DQN:
        # 1. Online network selects the next action.
        # 2. Target network evaluates that action.
        with torch.no_grad():
            next_actions = self.online_net(
                next_states
            ).argmax(dim=1, keepdim=True)

            next_q = self.target_net(
                next_states
            ).gather(
                1, next_actions
            ).squeeze(1)

            target_q = rewards + (
                self.gamma * (1.0 - dones) * next_q
            )

        loss = self.loss_function(current_q, target_q)

        self.optimizer.zero_grad()
        loss.backward()

        # Stabilize updates by limiting gradient magnitude.
        nn.utils.clip_grad_norm_(
            self.online_net.parameters(), max_norm=1.0
        )

        self.optimizer.step()

        self.training_steps += 1

        # Periodically synchronize target-network parameters.
        if (
            self.training_steps
            % self.target_update_frequency == 0
        ):
            self.target_net.load_state_dict(
                self.online_net.state_dict()
            )

        return float(loss.item())

    def decay_epsilon(self):
        self.epsilon = max(
            self.epsilon_min,
            self.epsilon * self.epsilon_decay
        )


