def make_state(user, odu):

    """

    Construct a 12-dimensional state vector.

    Input:
        user: dataset-derived user dictionary
        odu: current O-DU resource controller

    Output:
        float32 state vector of dimension 12

    All four models use this same state representation.

    """

    # --------------------------------------------------------
    # A. Traffic type one-hot encoding
    # --------------------------------------------------------

    traffic_id = int(user["traffic_type"])

    if traffic_id not in TRAFFIC_TO_INDEX:

        raise ValueError(

            f"Unsupported traffic type: {traffic_id}"

        )


    traffic_one_hot = np.zeros(

        NUM_TRAFFIC_TYPES,

        dtype=np.float32

    )


    traffic_one_hot[

        TRAFFIC_TO_INDEX[traffic_id]

    ] = 1.0


    # --------------------------------------------------------
    # B. Dataset-derived traffic characteristics
    # --------------------------------------------------------

    demand = float(

        user["demand_mbps"]

    )


    throughput = float(

        user["observed_throughput_mbps"]

    )


    latency = float(

        user["observed_latency_ms"]

    )


    packet_loss = float(

        user["packet_loss"]

    )


    channel = float(

        user["channel"]

    )


    bandwidth_utilization = float(

        user["bandwidth_utilization"]

    )


    # --------------------------------------------------------
    # C. Normalize traffic characteristics
    # --------------------------------------------------------

    demand_norm = np.clip(

        demand / STATE_SCALES["demand"],

        0.0,

        1.0

    )


    throughput_norm = np.clip(

        throughput / STATE_SCALES["throughput"],

        0.0,

        1.0

    )


    latency_norm = np.clip(

        latency / STATE_SCALES["latency"],

        0.0,

        1.0

    )


    packet_loss_norm = np.clip(

        packet_loss,

        0.0,

        1.0

    )


    channel_norm = np.clip(

        channel,

        0.0,

        1.0

    )


    bandwidth_util_norm = np.clip(

        bandwidth_utilization,

        0.0,

        1.0

    )


    # --------------------------------------------------------
    # D. Current O-DU resource conditions
    # --------------------------------------------------------

    remaining_rb_fraction = (

        odu.remaining_rbs /

        max(odu.total_rbs, 1)

    )


    remaining_power_fraction = (

        odu.remaining_power /

        max(odu.power_budget, 1e-8)

    )


    remaining_bandwidth = (

        odu.remaining_rbs *

        odu.bandwidth_per_rb

    )


    remaining_bandwidth_fraction = (

        remaining_bandwidth /

        max(odu.total_bandwidth_mhz, 1e-8)

    )


    # --------------------------------------------------------
    # E. Construct final state vector
    # --------------------------------------------------------

    state = np.concatenate([

        traffic_one_hot,

        np.asarray([

            demand_norm,

            throughput_norm,

            latency_norm,

            packet_loss_norm,

            channel_norm,

            bandwidth_util_norm,

            remaining_rb_fraction,

            remaining_power_fraction,

            remaining_bandwidth_fraction

        ], dtype=np.float32)

    ])


    state = np.nan_to_num(

        state,

        nan=0.0,

        posinf=1.0,

        neginf=0.0

    )


    state = np.clip(

        state,

        0.0,

        1.0

    )


    return state.astype(np.float32)


