    def allocate(

        self,

        user,

        requested_rbs=None,

        requested_power=None

    ):

        """

        Allocate available RBs and power to a user.

        """

        if requested_rbs is None:

            requested_rbs = user["requested_rbs"]


        if requested_power is None:

            requested_power = user["requested_power"]


        requested_rbs = max(

            0,

            int(requested_rbs)

        )


        requested_power = max(

            0.0,

            float(requested_power)

        )


        # Record requested resources before allocation.

        self.total_requested_rbs += requested_rbs

        self.total_requested_bandwidth_mhz += (

            requested_rbs * self.bandwidth_per_rb

        )

        self.users_requested += 1


        # Enforce O-DU resource constraints.

        allocated_rbs = min(

            requested_rbs,

            self.remaining_rbs

        )


        allocated_power = min(

            requested_power,

            self.remaining_power

        )


        if allocated_rbs == 0:

            allocated_power = 0.0


        # Calculate allocated bandwidth.

        allocated_bandwidth = (

            allocated_rbs * self.bandwidth_per_rb

        )


        # Dataset-driven channel quality.

        channel = float(

            np.clip(user["channel"], 0.0, 1.0)

        )


        spectral_efficiency = (

            0.5 + 4.5 * channel

        )


        # Simplified power-dependent rate model.

        power_factor = (

            min(np.sqrt(allocated_power / 4.0), 2.0)

            if allocated_power > 0

            else 0.0

        )


        data_rate_mbps = (

            allocated_bandwidth *

            spectral_efficiency *

            power_factor

        )


        # Transmission latency.

        data_volume = float(

            user["data_volume_mbits"]

        )


        if data_rate_mbps > 0:

            transmission_latency_ms = (

                data_volume / data_rate_mbps

            ) * 1000.0

        else:

            transmission_latency_ms = np.nan


        # Scheduling energy.

        energy_proxy = (

            allocated_power * SLOT_SECONDS

        )


        # Successful service.

        served = (

            allocated_rbs > 0 and

            data_rate_mbps >= user["demand_mbps"]

        )


        # Update O-DU resource budgets.

        self.remaining_rbs -= allocated_rbs

        self.remaining_power -= allocated_power


        # Accumulate scheduling statistics.

        self.total_allocated_rbs += allocated_rbs

        self.total_allocated_bandwidth_mhz += (

            allocated_bandwidth

        )

        self.total_allocated_power += allocated_power

        self.total_throughput_mbps += data_rate_mbps

        self.total_energy_proxy += energy_proxy


        if served:

            self.users_served += 1


        if np.isfinite(transmission_latency_ms):

            self.user_latencies_ms.append(

                transmission_latency_ms

            )


        result = {

            "user_id": user["user_id"],

            "requested_rbs": requested_rbs,

            "allocated_rbs": allocated_rbs,

            "requested_power": requested_power,

            "allocated_power": allocated_power,

            "bandwidth_mhz": allocated_bandwidth,

            "data_rate_mbps": data_rate_mbps,

            "throughput_mbps": data_rate_mbps,

            "demand_mbps": user["demand_mbps"],

            "transmission_latency_ms": transmission_latency_ms,

            "energy_proxy": energy_proxy,

            "served": bool(served),

            "packet_loss": user["packet_loss"],

            "traffic_name": user["traffic_name"]

        }


        self.user_results.append(result)


        return result


