Signature: (user)
def calculate_user_reward(user):

    traffic_name = user["traffic_name"]

    # --------------------------------------------------------
    # 1. Retrieve user and allocation information
    # --------------------------------------------------------

    demand_mbps = max(
        float(user.get("demand_mbps", 0.0)),
        REWARD_EPSILON
    )

    achieved_rate = max(
        float(user.get("achieved_rate_mbps", 0.0)),
        0.0
    )

    allocated_rbs = max(
        float(user.get("allocated_rbs", 0.0)),
        0.0
    )

    allocated_power = max(
        float(user.get("allocated_power_w", 0.0)),
        0.0
    )

    transmission_latency = max(
        float(user.get("transmission_latency_ms", 0.0)),
        0.0
    )

    energy = max(
        float(user.get("energy_j", 0.0)),
        0.0
    )

    packet_loss = np.clip(
        float(user.get("packet_loss_fraction", 0.0)),
        0.0,
        1.0
    )

    served = bool(user.get("served", False))

    # --------------------------------------------------------
    # 2. Throughput satisfaction
    # --------------------------------------------------------

    throughput_satisfaction = np.clip(
        achieved_rate / demand_mbps,
        0.0,
        1.0
    )

    # --------------------------------------------------------
    # 3. Successful service delivery
    # --------------------------------------------------------

    service_success = float(
        served and achieved_rate >= demand_mbps
    )

    # --------------------------------------------------------
    # 4. Radio resource efficiency
    # --------------------------------------------------------

    # A user receiving no RBs has zero resource efficiency.
    # Otherwise, efficiency is based on achieved throughput
    # relative to the user's requested throughput per RB.

    if allocated_rbs > 0:

        requested_rate_per_rb = demand_mbps / max(
            float(user.get("requested_rbs", allocated_rbs)),
            1.0
        )

        achieved_rate_per_rb = achieved_rate / allocated_rbs

        resource_efficiency = np.clip(
            achieved_rate_per_rb /
            max(requested_rate_per_rb, REWARD_EPSILON),
            0.0,
            1.0
        )

    else:
        resource_efficiency = 0.0

    # --------------------------------------------------------
    # --------------------------------------------------------
    # 5. Latency penalty
    # --------------------------------------------------------

    # Resolve traffic ID and label
    if isinstance(traffic_name, (int, np.integer)):

        traffic_id = int(traffic_name)

    else:

        traffic_label_input = str(traffic_name).strip().upper()

        traffic_id = next(
            (
                tid
                for tid, config in TRAFFIC_TYPES.items()
                if config["name"].upper() == traffic_label_input
            ),
            None
        )

        if traffic_id is None:
            raise ValueError(
                f"Unknown traffic type: {traffic_name}"
            )

    if traffic_id not in TRAFFIC_TYPES:
        raise ValueError(
            f"Invalid traffic ID: {traffic_id}"
        )

    traffic_label = TRAFFIC_TYPES[traffic_id]["name"]

    # Retrieve latency reference
    latency_reference = QOS_NORMALIZATION[
        traffic_label
    ]["latency_ms"]

    normalized_latency = np.clip(
        transmission_latency /
        max(float(latency_reference), REWARD_EPSILON),
        0.0,
        1.0
    )

    latency_score = 1.0 - normalized_latency
    # --------------------------------------------------------
    # 6. Energy penalty
    # --------------------------------------------------------

    # Maximum reference energy assumes maximum transmission
    # power is consumed throughout one radio slot.

    maximum_slot_energy = (
        float(MAX_TX_POWER_W) *
        float(SLOT_DURATION_SECONDS)
    )

    normalized_energy = np.clip(
        energy /
        max(maximum_slot_energy, REWARD_EPSILON),
        0.0,
        1.0
    )

    energy_score = float(
        1.0 - normalized_energy
    )
    # --------------------------------------------------------
    # 7. Packet loss penalty
    # --------------------------------------------------------

    packet_loss_reference = QOS_NORMALIZATION[
        traffic_label
    ]["packet_loss"]

    normalized_packet_loss = np.clip(
        packet_loss /
        max(float(packet_loss_reference), REWARD_EPSILON),
        0.0,
        1.0
    )

    packet_loss_score = 1.0 - normalized_packet_loss

    # --------------------------------------------------------
    # 8. Calculate weighted reward
    # --------------------------------------------------------

    # --------------------------------------------------------
    # 8. Calculate weighted reward
    # --------------------------------------------------------

    reward = (

            REWARD_WEIGHTS["throughput"]
            * throughput_satisfaction

            + REWARD_WEIGHTS["service_success"]
            * service_success

            + REWARD_WEIGHTS["resource_efficiency"]
            * resource_efficiency

            + REWARD_WEIGHTS["latency"]
            * latency_score

            + REWARD_WEIGHTS["energy"]
            * energy_score

            + REWARD_WEIGHTS["packet_loss"]
            * packet_loss_score
    )

    # --------------------------------------------------------
    # 9. Return reward and its individual components
    # --------------------------------------------------------

    reward_details = {

        "reward": reward,

        "throughput_satisfaction": float(
            throughput_satisfaction
        ),

        "service_success": float(
            service_success
        ),

        "resource_efficiency": float(
            resource_efficiency
        ),

        "latency_score": float(
            latency_score
        ),

        "energy_score": float(
            energy_score
        ),

        "packet_loss_score": float(
            packet_loss_score
        )
    }

    return reward_details


