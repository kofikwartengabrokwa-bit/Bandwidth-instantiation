def execute_agent_action(odu, user, action_id):

    """
    Execute one agent-selected action and return the
    resulting reward and resource-allocation information.
    """

    # State before resource allocation.
    state = make_state(user, odu)

    # Execute the selected action.
    allocation_results = allocate_user_with_action(
        odu=odu,
        user=user,
        action_id=action_id
    )

    # Retrieve reward.
    reward = allocation_results["reward"]

    # State after allocation, using the updated O-DU resources.
    next_state = make_state(user, odu)

    # Determine whether the current allocation failed.
    allocation_failed = (
        allocation_results["allocated_rbs"] <= 0
    )

    return {

        "state": state,

        "action": int(action_id),

        "reward": float(reward),

        "next_state": next_state,

        "allocation_results": allocation_results,

        "allocation_failed": allocation_failed
    }


