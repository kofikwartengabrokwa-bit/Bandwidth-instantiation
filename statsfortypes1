def run_environment_episode(
    traffic_name,
    num_users,
    seed=SEED
):
    """
    Execute one radio-resource allocation episode.

    All models use the same environment initialization,
    user generation, O-DU allocation, and reward calculation.
    """

    # --------------------------------------------------------
    # 1. Initialize the environment
    # --------------------------------------------------------

    environment = initialize_environment(
        traffic_name=traffic_name,
        num_users=num_users,
        seed=seed
    )

    odu = environment["odu"]
    users = environment["users"]

    # --------------------------------------------------------
    # 2. Initialize episode records
    # --------------------------------------------------------

    user_records = []
    state_records = []

    # --------------------------------------------------------
    # 3. Process users and allocate radio resources
    # --------------------------------------------------------

    for user_index, user in enumerate(users):

        # Capture the user's state before allocation.
        state = make_state(user, odu)

        state_records.append(state.copy())

        # Allocate radio resources to the current user.
        odu.allocate(user)

        # Calculate the user's reward after allocation.
        reward_details = calculate_user_reward(user)

        # Store user-level allocation and reward information.
        user_records.append({

            "user_index": user_index,

            "traffic_name": traffic_name,

            "demand_mbps": user.get(
                "demand_mbps", np.nan
            ),

            "achieved_rate_mbps": user.get(
                "achieved_rate_mbps", np.nan
            ),

            "requested_rbs": user.get(
                "requested_rbs", np.nan
            ),

            "allocated_rbs": user.get(
                "allocated_rbs", np.nan
            ),

            "allocated_power_w": user.get(
                "allocated_power_w", np.nan
            ),

            "transmission_latency_ms": user.get(
                "transmission_latency_ms", np.nan
            ),

            "energy_j": user.get(
                "energy_j", np.nan
            ),

            "packet_loss_fraction": user.get(
                "packet_loss_fraction", np.nan
            ),

            "served": user.get(
                "served", False
            ),

            "reward": reward_details["reward"],

            "throughput_satisfaction":
                reward_details["throughput_satisfaction"],

            "service_success":
                reward_details["service_success"],

            "resource_efficiency":
                reward_details["resource_efficiency"],

            "latency_score":
                reward_details["latency_score"],

            "energy_score":
                reward_details["energy_score"],

            "packet_loss_score":
                reward_details["packet_loss_score"]
        })

    # --------------------------------------------------------
    # 4. Calculate episode-level reward
    # --------------------------------------------------------

    episode_reward = calculate_episode_reward(users)

    # --------------------------------------------------------
    # 5. Retrieve O-DU resource utilization statistics
    # --------------------------------------------------------

    odu_summary = odu.get_summary()

    # --------------------------------------------------------
    # 6. Convert user records into a DataFrame
    # --------------------------------------------------------

    user_results = pd.DataFrame(user_records)

    # --------------------------------------------------------
    # 7. Return all episode information
    # --------------------------------------------------------

    episode_results = {

        "traffic_name": traffic_name,

        "num_users": len(users),

        "episode_reward": episode_reward,

