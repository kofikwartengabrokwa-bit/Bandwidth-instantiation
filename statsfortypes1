    reward_records = []

    for user in users:

        reward_details = calculate_user_reward(user)

        reward_records.append(reward_details)

    reward_df = pd.DataFrame(reward_records)

    episode_results = {

        "episode_reward": float(
            reward_df["reward"].mean()
