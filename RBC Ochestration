# ============================================================
# 5.4 WEIGHTED GREEDY VERTEX COVER
# ============================================================

def weighted_greedy_vertex_cover(graph, priority_scores):

    if graph.is_directed():
        raise ValueError(
            "Vertex Cover requires an undirected graph."
        )

    if graph.number_of_nodes() == 0:
        raise ValueError("The RBC graph is empty.")

    if graph.number_of_edges() == 0:
        raise ValueError(
            "The RBC graph contains no edges."
        )

    uncovered_edges = set(
        frozenset(edge)
        for edge in graph.edges()
    )

    selected_vertices = set()

    selection_history = []

    # --------------------------------------------------------
    # Iteratively select vertices until every edge is covered
    # --------------------------------------------------------

    iteration = 0

    while uncovered_edges:

        iteration += 1

        if iteration > VERTEX_COVER_MAX_ITERATIONS:

            raise RuntimeError(
                "Vertex Cover exceeded the maximum iterations."
            )

        vertex_candidates = []

        for node in graph.nodes():

            if node in selected_vertices:
                continue

            # Find uncovered edges incident to this vertex.
            incident_uncovered_edges = [
                edge
                for edge in uncovered_edges
                if node in edge
            ]

            if not incident_uncovered_edges:
                continue

            # ------------------------------------------------
            # Calculate total uncovered edge importance
            # ------------------------------------------------

            coverage_weight = 0.0

            for edge in incident_uncovered_edges:

                edge_nodes = list(edge)

                u, v = edge_nodes

                edge_data = graph[u][v]

                edge_importance = (
                    1.0 /
                    (
                        edge_data["routing_cost"]
                        + VERTEX_COVER_EPS
                    )
                )

                coverage_weight += edge_importance

            # ------------------------------------------------
            # Selection cost
            # ------------------------------------------------

            priority = priority_scores[node]

            selection_cost = (
                1.0 - priority
                + VERTEX_COVER_EPS
            )

            # ------------------------------------------------
            # Greedy selection ratio
            # ------------------------------------------------

            selection_ratio = (
                coverage_weight / selection_cost
            )

            vertex_candidates.append(
                {
                    "node": node,
                    "coverage_weight": coverage_weight,
                    "selection_cost": selection_cost,
                    "selection_ratio": selection_ratio,
                    "priority": priority,
                    "covered_edge_count": len(
                        incident_uncovered_edges
                    )
                }
            )

        if not vertex_candidates:

            raise RuntimeError(
                "Unable to cover all remaining RBC graph edges."
            )

        # ----------------------------------------------------
        # Select the vertex with the highest ratio
        # ----------------------------------------------------

        vertex_candidates.sort(
            key=lambda item: (
                -item["selection_ratio"],
                -item["priority"],
                item["node"]
            )
        )

        best_candidate = vertex_candidates[0]

        selected_node = best_candidate["node"]

        selected_vertices.add(selected_node)

        # ----------------------------------------------------
        # Remove all edges covered by the selected vertex
        # ----------------------------------------------------

        newly_covered_edges = [
            edge
            for edge in uncovered_edges
            if selected_node in edge
        ]

        for edge in newly_covered_edges:

            uncovered_edges.remove(edge)

        selection_history.append(
            {
                "iteration": iteration,
                "selected_vertex": selected_node,
                "priority_score": best_candidate["priority"],
                "coverage_weight": best_candidate[
                    "coverage_weight"
                ],
                "selection_cost": best_candidate[
                    "selection_cost"
                ],
                "selection_ratio": best_candidate[
                    "selection_ratio"
                ],
                "newly_covered_edges": len(
                    newly_covered_edges
                ),
                "remaining_uncovered_edges": len(
                    uncovered_edges
                )
            }
        )

    return (
        selected_vertices,
        selection_history
    )


