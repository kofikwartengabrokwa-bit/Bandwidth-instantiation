def normalize_rbc_features(feature_matrix):

    feature_min = np.min(
        feature_matrix,
        axis=0,
        keepdims=True
    )

    feature_max = np.max(
        feature_matrix,
        axis=0,
        keepdims=True
    )

    feature_range = feature_max - feature_min

    normalized = (
        feature_matrix - feature_min
    ) / (
        feature_range + RBF_NORMALIZATION_EPS
    )

    return normalized.astype(np.float32), feature_min, feature_max


