def normalize_score_dictionary(score_dict):

    values = np.array(
        list(score_dict.values()),
        dtype=np.float32
    )

    minimum = np.min(values)

    maximum = np.max(values)

    normalized_values = (
        values - minimum
    ) / (
        maximum - minimum + VERTEX_COVER_EPS
    )

    return {
        node: float(normalized_values[index])
        for index, node in enumerate(score_dict.keys())
    }


