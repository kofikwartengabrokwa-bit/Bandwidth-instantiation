def evaluate_candidate_resources(graph, node):

    state = SUBSLOT_STATE[node]

    available_rbs = state["available_rbs"]

    allocated_rbs = state["allocated_rbs"]

    neighbors = list(graph.neighbors(node))

    capacities = []
    latencies = []
    qualities = []

    for neighbor in neighbors:

        edge = graph[node][neighbor]

        if not edge.get("available", True):
            continue

        capacities.append(edge["capacity"])
        latencies.append(edge["latency"])
        qualities.append(edge["weight"])

    if capacities:

        average_capacity = float(np.mean(capacities))

        average_latency = float(np.mean(latencies))

        average_quality = float(np.mean(qualities))

    else:

        average_capacity = 0.0
        average_latency = float("inf")
        average_quality = 0.0

    # --------------------------------------------------------
    # Normalize resource availability
    # --------------------------------------------------------

    resource_availability = np.clip(
        available_rbs / TOTAL_RBS,
        0.0,
        1.0
    )

    # --------------------------------------------------------
    # Return candidate characteristics
    # --------------------------------------------------------

    return {
        "available_rbs": int(available_rbs),
        "allocated_rbs": int(allocated_rbs),
        "resource_availability": float(
            resource_availability
        ),
        "average_capacity": average_capacity,
        "average_latency": average_latency,
        "average_link_quality": average_quality,
        "degree": int(graph.degree(node))
    }

# ============================================================
# 6.4 NORMALIZE CANDIDATE EVALUATION METRICS
# ============================================================

def min_max_normalize(values):

    values = np.asarray(
        values,
        dtype=np.float32
    )

    minimum = np.min(values)

    maximum = np.max(values)

    if np.isclose(maximum, minimum):

        return np.ones_like(values)

    return (
        (values - minimum)
        / (maximum - minimum + RBC_SELECTION_EPS)
    )


