def build_interconnected_subslot_graph(graph):

    """
    Construct a sparse multi-hop graph.

    Each node may connect to multiple other nodes.
    Intermediate nodes can be used as routing hops.
    """

    # --------------------------------------------------------
    # A. Intra-slot connections
    # --------------------------------------------------------

    intra_slot_links = [

        # Slot 1

        ("Slot_1_S1", "Slot_1_S3"),

        ("Slot_1_S2", "Slot_1_S3"),

        ("Slot_1_S3", "Slot_1_S4"),

        ("Slot_1_S4", "Slot_1_S6"),

        ("Slot_1_S5", "Slot_1_S6"),

        ("Slot_1_S6", "Slot_1_S7"),

        ("Slot_1_S7", "Slot_1_S9"),

        ("Slot_1_S8", "Slot_1_S9"),

        ("Slot_1_S9", "Slot_1_S10"),


        # Slot 2

        ("Slot_2_S1", "Slot_2_S2"),

        ("Slot_2_S2", "Slot_2_S4"),

        ("Slot_2_S3", "Slot_2_S4"),

        ("Slot_2_S4", "Slot_2_S5"),

        ("Slot_2_S5", "Slot_2_S7"),

        ("Slot_2_S6", "Slot_2_S7"),

        ("Slot_2_S7", "Slot_2_S8"),

        ("Slot_2_S8", "Slot_2_S10"),

        ("Slot_2_S9", "Slot_2_S10")

    ]


    # --------------------------------------------------------
    # B. Inter-slot connections
    # --------------------------------------------------------

    inter_slot_links = [

        ("Slot_1_S1", "Slot_2_S2"),

        ("Slot_1_S3", "Slot_2_S3"),

        ("Slot_1_S4", "Slot_2_S5"),

        ("Slot_1_S5", "Slot_2_S4"),

        ("Slot_1_S6", "Slot_2_S7"),

        ("Slot_1_S7", "Slot_2_S8"),

        ("Slot_1_S8", "Slot_2_S6"),

        ("Slot_1_S9", "Slot_2_S9"),

        ("Slot_1_S10", "Slot_2_S10")

    ]


    # Add intra-slot links

    for source, destination in intra_slot_links:

        add_subslot_link(

            graph,

            source,

            destination

        )


    # Add inter-slot links

    for source, destination in inter_slot_links:

        add_subslot_link(

            graph,

            source,

            destination

        )


    return graph



