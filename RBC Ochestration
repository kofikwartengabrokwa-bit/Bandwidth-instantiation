# 2.6 ROUTING COST CALCULATION
# ============================================================

ROUTING_ALPHA = 0.40

ROUTING_BETA = 0.35

ROUTING_GAMMA = 0.25


def calculate_routing_cost(edge_data):

    """
    Calculate routing cost for an interconnection link.
    Lower cost means a better routing link.
    """

    weight = edge_data["weight"]

    latency = edge_data["latency_ms"]

    capacity = edge_data["capacity_mbps"]


    normalized_latency = (

        latency / MAX_LINK_LATENCY_MS

    )


    normalized_capacity_cost = (

        MIN_LINK_CAPACITY_MBPS / capacity

    )


    inverse_quality_cost = (

        1.0 / (weight + RBF_EPS)

    )

    cost = (

        ROUTING_ALPHA * inverse_quality_cost

        + ROUTING_BETA * normalized_latency

        + ROUTING_GAMMA * normalized_capacity_cost

    )

    return float(cost)


# Assign routing costs to all edges

for source, destination, edge_data in G.edges(data=True):

    edge_data["routing_cost"] = calculate_routing_cost(

        edge_data

    )


