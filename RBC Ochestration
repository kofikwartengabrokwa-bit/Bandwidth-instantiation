def evaluate_candidate_route(graph, start_node, candidate_node):

    if start_node not in graph:
        return None

    if candidate_node not in graph:
        return None

    if not nx.has_path(
        graph,
        start_node,
        candidate_node
    ):
        return None

    try:

        route = nx.shortest_path(
            graph,
            source=start_node,
            target=candidate_node,
            weight="routing_cost"
        )

        route_cost = nx.shortest_path_length(
            graph,
            source=start_node,
            target=candidate_node,
            weight="routing_cost"
        )

        route_hops = len(route) - 1

        if route_hops > RBC_MAX_ROUTE_HOPS:
            return None

        return {
            "route": route,
            "route_cost": float(route_cost),
            "route_hops": int(route_hops),
            "reachable": True
        }

