# ============================================================
# 2.3 LINK CREATION FUNCTION
# ============================================================

def add_subslot_link(

    graph,

    source,

    destination,

    weight=None,

    capacity=None,

    latency=None

):

    """
    Establish a bidirectional connection between two subslots.

    Each link has:
        - Link weight
        - Link capacity
        - Link latency
        - Link availability
    """

    if source == destination:

        return False

    if graph.has_edge(source, destination):

        return False


    if weight is None:

        weight = graph_rng.uniform(

            MIN_LINK_WEIGHT,

            MAX_LINK_WEIGHT

        )


    if capacity is None:

        capacity = graph_rng.uniform(

            MIN_LINK_CAPACITY_MBPS,

            MAX_LINK_CAPACITY_MBPS

        )


    if latency is None:

        latency = graph_rng.uniform(

            MIN_LINK_LATENCY_MS,

            MAX_LINK_LATENCY_MS

        )


    # Higher weight indicates a stronger link.

    graph.add_edge(

        source,

        destination,

        weight=float(weight),

        capacity_mbps=float(capacity),

        latency_ms=float(latency),

        available=True,

        selected=False,

        traversed=False,

        link_type=(

            "intra-slot"

            if graph.nodes[source]["slot"]

            == graph.nodes[destination]["slot"]

            else "inter-slot"

        )

    )

    return True


