# ============================================================
# 3.2 DYNAMIC LINK QUALITY EVALUATION
# ============================================================

def evaluate_rbc_link(graph, source, destination):

    """
    Evaluate a connection between two subslots.

    Returns link quality, capacity, latency,
    routing cost, and normalized utility.
    """

    if not graph.has_edge(source, destination):

        return None


    edge = graph[source][destination]


    if RBC_REQUIRE_AVAILABLE_LINK and not edge["available"]:

        return None


    weight = float(edge["weight"])

    capacity = float(edge["capacity_mbps"])

    latency = float(edge["latency_ms"])

    routing_cost = float(edge["routing_cost"])


    normalized_quality = np.clip(

        weight,

        0.0,

        1.0

    )


    normalized_capacity = np.clip(

        capacity / MAX_LINK_CAPACITY_MBPS,

        0.0,

        1.0

    )


    normalized_latency = np.clip(

        latency / MAX_LINK_LATENCY_MS,

        0.0,

        1.0

    )


    utility = (

        HOP_COST_WEIGHT * normalized_quality

        + CAPACITY_COST_WEIGHT * normalized_capacity

        - LATENCY_COST_WEIGHT * normalized_latency

    )


    return {

        "source": source,

        "destination": destination,

        "link_quality": weight,

        "capacity_mbps": capacity,

        "latency_ms": latency,

        "routing_cost": routing_cost,

        "utility": float(utility)

    }


# ============================================================
# 3.3 DYNAMIC NEXT-HOP SELECTION
# ============================================================

def select_rbc_next_hop(

    graph,

    current_node,

    destination_node,

    visited_nodes=None

):

    """
    Dynamically select the next hop toward the destination.

    Previously visited nodes are avoided unless the node
    is the final destination.
    """

    if visited_nodes is None:

        visited_nodes = set()


    if current_node == destination_node:

        return None, []


    # Exclude previously visited nodes from onward routing.

    blocked_nodes = (

        set(visited_nodes)

        - {current_node, destination_node}

    )


    routing_graph = graph.copy()

    routing_graph.remove_nodes_from(

        node

        for node in blocked_nodes

        if node in routing_graph

    )


    if destination_node not in routing_graph:

        return None, []


    # Calculate remaining shortest-path distances.

    try:

        remaining_distances = nx.single_source_dijkstra_path_length(

            routing_graph,

            destination_node,

            weight="routing_cost"

        )

    except nx.NetworkXNoPath:

        return None, []


    candidate_records = []


    # Evaluate each neighboring node.

    for neighbor in graph.neighbors(current_node):


        if neighbor in visited_nodes:

            if neighbor != destination_node:

                continue


        link_information = evaluate_rbc_link(

            graph,

            current_node,

            neighbor

        )


        if link_information is None:

            continue


        if neighbor not in remaining_distances:

            continue


        immediate_cost = link_information["routing_cost"]

        remaining_cost = remaining_distances[neighbor]


        estimated_total_cost = (

            immediate_cost + remaining_cost

        )


        candidate_records.append({

            **link_information,

            "remaining_cost": remaining_cost,

            "estimated_total_cost": estimated_total_cost

        })


    if not candidate_records:

        return None, []


    # Lowest estimated total route cost is preferred.

    candidate_records.sort(

        key=lambda item: (

            item["estimated_total_cost"],

            -item["utility"],

            item["destination"]

        )

    )


    selected_candidate = candidate_records[0]


    selected_next_hop = selected_candidate["destination"]


    return selected_next_hop, candidate_records



# ============================================================
# 3.4 RBC MULTI-HOP ROUTING ALGORITHM
# ============================================================

def execute_rbc_routing(

    graph,

    start_node,

    destination_node,

    max_hops=RBC_MAX_HOPS

):

    """
    Execute multi-hop RBC navigation.

    Returns:
        Route
        Visited nodes
        Selected links
        Candidate history
        Total routing cost
        Total end-to-end latency
        Routing status
    """

    if start_node not in graph:

        raise ValueError(
            f"Unknown starting node: {start_node}"
        )

    if destination_node not in graph:

        raise ValueError(
            f"Unknown destination node: {destination_node}"
        )

    if start_node != destination_node and not nx.has_path(
        graph,
        start_node,
        destination_node
    ):

        raise nx.NetworkXNoPath(
            f"No route exists from {start_node} "
            f"to {destination_node}."
        )

    # --------------------------------------------------------
    # INITIALIZE ROUTE RECORDS
    # --------------------------------------------------------

    route = [start_node]

    visited_nodes = [start_node]

    selected_links = []

    candidate_history = []

    total_routing_cost = 0.0

    total_latency = 0.0

    current_node = start_node

    route_status = "in_progress"

    # --------------------------------------------------------
    # RESET PREVIOUS GRAPH VISUALIZATION FLAGS
    # --------------------------------------------------------

    for node in graph.nodes:

        graph.nodes[node]["visited"] = False

        graph.nodes[node]["is_hop"] = False

        graph.nodes[node]["is_destination"] = False

    for u, v in graph.edges:

        graph[u][v]["selected"] = False

        graph[u][v]["traversed"] = False

    graph.nodes[start_node]["visited"] = True

    # --------------------------------------------------------
    # MULTI-HOP NAVIGATION
    # --------------------------------------------------------

    for step in range(max_hops):

        if current_node == destination_node:

            route_status = "success"

            break

        next_hop, candidates = select_rbc_next_hop(

            graph,

            current_node,

            destination_node,

            visited_nodes=set(visited_nodes)

        )

        candidate_history.append({

            "step": step + 1,

            "current_node": current_node,

            "candidates": candidates

        })

        if next_hop is None:

            route_status = "failed_no_available_hop"

            break

        # ----------------------------------------------------
        # RETRIEVE SELECTED LINK INFORMATION
        # ----------------------------------------------------

        link_data = evaluate_rbc_link(

            graph,

            current_node,

            next_hop

        )

        if link_data is None:

            route_status = "failed_invalid_link"

            break

        # ----------------------------------------------------
        # RECORD SELECTED LINK
        # ----------------------------------------------------

        graph[current_node][next_hop]["selected"] = True

        graph[current_node][next_hop]["traversed"] = True

        graph.nodes[next_hop]["visited"] = True

        if next_hop != destination_node:

            graph.nodes[next_hop]["is_hop"] = True

        # ----------------------------------------------------
        # EXTRACT LINK LATENCY AND ROUTING COST
        # ----------------------------------------------------

        link_latency = float(link_data["latency_ms"])

        link_routing_cost = float(link_data["routing_cost"])

        # ----------------------------------------------------
        # RECORD SELECTED LINK METRICS
        # ----------------------------------------------------

        selected_links.append({

            "step": step + 1,

            "source": current_node,

            "destination": next_hop,

            "link_quality": link_data["link_quality"],

            "capacity_mbps": link_data["capacity_mbps"],

            "latency_ms": link_latency,

            "routing_cost": link_routing_cost,

            "utility": link_data["utility"]

        })

        # ----------------------------------------------------
        # ACCUMULATE ROUTE METRICS
        # ----------------------------------------------------

        total_routing_cost += link_routing_cost

        total_latency += link_latency

        # ----------------------------------------------------
        # UPDATE NAVIGATION STATE
        # ----------------------------------------------------

        current_node = next_hop

        route.append(current_node)

        visited_nodes.append(current_node)

        # ----------------------------------------------------
        # CHECK DESTINATION
        # ----------------------------------------------------

        if current_node == destination_node:

            route_status = "success"

            graph.nodes[destination_node]["is_destination"] = True

            break

    # --------------------------------------------------------
    # FINALIZE ROUTING STATUS
    # --------------------------------------------------------

    if current_node == destination_node:

        route_status = "success"

    elif route_status == "in_progress":

        route_status = "failed_max_hops"

    # --------------------------------------------------------
    # UPDATE GLOBAL RBC STATE
    # --------------------------------------------------------

    RBC_STATE["selected_route"] = route.copy()

    RBC_STATE["visited_subslots"] = visited_nodes.copy()

    RBC_STATE["selected_links"] = selected_links.copy()

    RBC_STATE["total_routing_cost"] = total_routing_cost

    RBC_STATE["total_latency"] = total_latency

    RBC_STATE["selected_subslot"] = (

        destination_node

        if route_status == "success"

        else None

    )

    # --------------------------------------------------------
    # STORE NAVIGATION HISTORY
    # --------------------------------------------------------

    RBC_ROUTE_HISTORY.append({

        "start_node": start_node,

        "destination_node": destination_node,

        "route": route.copy(),

        "visited_nodes": visited_nodes.copy(),

        "selected_links": selected_links.copy(),

        "total_routing_cost": total_routing_cost,

        "total_latency_ms": total_latency,

        "average_latency_ms": (

            total_latency / len(selected_links)

            if selected_links

            else 0.0

        ),

        "number_of_hops": len(selected_links),

        "status": route_status

    })

    # --------------------------------------------------------
    # UPDATE GLOBAL HISTORIES
    # --------------------------------------------------------

    RBC_VISITED_HISTORY.extend(visited_nodes)

    RBC_LINK_SELECTION_HISTORY.extend(selected_links)

    RBC_CANDIDATE_HISTORY.extend(candidate_history)

    # --------------------------------------------------------
    # RETURN ROUTING RESULTS
    # --------------------------------------------------------

    return {

        "route": route,

        "visited_nodes": visited_nodes,

        "selected_links": selected_links,

        "candidate_history": candidate_history,

        "total_routing_cost": total_routing_cost,

        "total_latency_ms": total_latency,

        "average_latency_ms": (

            total_latency / len(selected_links)

            if selected_links

            else 0.0

        ),

        "number_of_hops": len(selected_links),

        "status": route_status

    }


