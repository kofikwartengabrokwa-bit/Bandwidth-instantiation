def calculate_rbc_centrality(graph):

    degree_centrality = nx.degree_centrality(graph)

    betweenness_centrality = nx.betweenness_centrality(
        graph,
        weight="routing_cost",
        normalized=True
    )

    closeness_centrality = nx.closeness_centrality(
        graph,
        distance="routing_cost"
    )

    centrality_results = {}

    for node in graph.nodes():

        degree_value = degree_centrality[node]

        betweenness_value = betweenness_centrality[node]

        closeness_value = closeness_centrality[node]

        centrality_score = (
            0.25 * degree_value
            + 0.50 * betweenness_value
            + 0.25 * closeness_value
        )

        centrality_results[node] = {
            "degree_centrality": float(degree_value),
            "betweenness_centrality": float(
                betweenness_value
            ),
            "closeness_centrality": float(
                closeness_value
            ),
            "centrality_score": float(
                centrality_score
            )
        }

    return centrality_results


