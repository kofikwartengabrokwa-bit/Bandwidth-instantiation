# ============================================================
# 4.2 EXTRACT SUBSLOT FEATURES
# ============================================================

def extract_subslot_features(graph, node):

    if node not in graph:
        raise ValueError(
            f"Subslot {node} does not exist in graph."
        )

    if node not in SUBSLOT_STATE:
        raise KeyError(
            f"Subslot {node} is missing from SUBSLOT_STATE."
        )

    node_state = SUBSLOT_STATE[node]

    neighbors = list(graph.neighbors(node))

    # --------------------------------------------------------
    # Feature 1: RB availability
    # --------------------------------------------------------

    available_rbs = float(
        node_state["available_rbs"]
    )

    rb_availability = np.clip(
        available_rbs / max(1.0, float(TOTAL_RBS)),
        0.0,
        1.0
    )

    # --------------------------------------------------------
    # Feature 2: Connectivity
    # --------------------------------------------------------

    connectivity = len(neighbors) / max(
        1, MAX_NODE_DEGREE
    )

    connectivity = np.clip(
        connectivity,
        0.0,
        1.0
    )

    # --------------------------------------------------------
    # Initialize link-related features
    # --------------------------------------------------------

    link_qualities = []
    link_capacities = []
    link_latencies = []

    # --------------------------------------------------------
    # Extract neighboring link characteristics
    # --------------------------------------------------------

    for neighbor in neighbors:

        edge_data = graph.get_edge_data(node, neighbor)

        if edge_data is None:
            continue

        # Skip unavailable links.
        if not edge_data.get("available", True):
            continue

        # ----------------------------------------------------
        # Extract capacity
        # Supports both attribute names.
        # ----------------------------------------------------

        capacity = edge_data.get(
            "capacity_mbps",
            edge_data.get("capacity")
        )

        # ----------------------------------------------------
        # Extract latency
        # Supports both attribute names.
        # ----------------------------------------------------

        latency = edge_data.get(
            "latency_ms",
            edge_data.get("latency")
        )

        # ----------------------------------------------------
        # Extract link quality
        # ----------------------------------------------------

        weight = edge_data.get("weight")

        if weight is None:
            weight = edge_data.get("link_quality")

        # ----------------------------------------------------
        # Validate edge attributes
        # ----------------------------------------------------

        missing_attributes = []

        if capacity is None:
            missing_attributes.append("capacity/capacity_mbps")

        if latency is None:
            missing_attributes.append("latency/latency_ms")

        if weight is None:
            missing_attributes.append("weight/link_quality")

        if missing_attributes:
            raise KeyError(
                f"Missing attributes {missing_attributes} "
                f"for edge {node} -> {neighbor}. "
                f"Available attributes: {list(edge_data.keys())}"
            )

        capacity = float(capacity)
        latency = float(latency)
        weight = float(weight)

        # ----------------------------------------------------
        # Feature 3: Normalized link quality
        # ----------------------------------------------------

        link_quality = np.clip(
            weight,
            0.0,
            1.0
        )

        # ----------------------------------------------------
        # Feature 4: Normalized link capacity
        # ----------------------------------------------------

        link_capacity = np.clip(
            capacity / max(1e-8, RBC_MAX_LINK_CAPACITY),
            0.0,
            1.0
        )

        # ----------------------------------------------------
        # Feature 5: Normalized link latency
        # ----------------------------------------------------

        link_latency = np.clip(
            latency / max(1e-8, RBC_MAX_LINK_LATENCY),
            0.0,
            1.0
        )

        # ----------------------------------------------------
        # Store link characteristics
        # ----------------------------------------------------

        link_qualities.append(link_quality)
        link_capacities.append(link_capacity)
        link_latencies.append(link_latency)

    # --------------------------------------------------------
    # Average neighboring link characteristics
    # --------------------------------------------------------

    if link_qualities:

        avg_link_quality = float(
            np.mean(link_qualities)
        )

        avg_link_capacity = float(
            np.mean(link_capacities)
        )

        avg_link_latency = float(
            np.mean(link_latencies)
        )

    else:

        # No available neighboring links.
        avg_link_quality = 0.0
        avg_link_capacity = 0.0
        avg_link_latency = 1.0

    # --------------------------------------------------------
    # Feature 6: Subslot occupancy
    # --------------------------------------------------------

    allocated_rbs = float(
        node_state["allocated_rbs"]
    )

    occupancy = np.clip(
        allocated_rbs / max(1.0, float(TOTAL_RBS)),
        0.0,
        1.0
    )

    # --------------------------------------------------------
    # Construct six-dimensional feature vector
    # --------------------------------------------------------

    feature_vector = np.array(
        [
            rb_availability,       # Feature 1
            connectivity,          # Feature 2
            avg_link_quality,      # Feature 3
            avg_link_capacity,     # Feature 4
            avg_link_latency,      # Feature 5
            occupancy              # Feature 6
        ],
        dtype=np.float32
    )

    # --------------------------------------------------------
    # Validate feature vector
    # --------------------------------------------------------

    if feature_vector.shape != (6,):
        raise ValueError(
            f"Invalid feature dimension for {node}: "
            f"{feature_vector.shape}. Expected (6,)."
        )

    if not np.all(np.isfinite(feature_vector)):
        raise ValueError(
            f"Non-finite feature values detected for {node}: "
            f"{feature_vector}"
        )

    return feature_vector




