# ============================================================
# RBC ROUTING FOOTPRINT VISUALIZATION
# ============================================================

def plot_rbc_routing_footprint(

    graph,

    routing_result,

    episode=None

):

    """
    Visualize the complete RBC routing footprint.
    Displays cumulative end-to-end latency instead of routing cost.
    """

    route = routing_result["route"]

    visited = set(routing_result["visited_nodes"])

    selected_links = routing_result["selected_links"]

    candidate_history = routing_result["candidate_history"]

    # --------------------------------------------------------
    # EXTRACT ROUTING METRICS
    # --------------------------------------------------------

    total_latency_ms = routing_result.get(
        "total_latency_ms",
        sum(
            float(link["latency_ms"])
            for link in selected_links
        )
    )

    average_latency_ms = routing_result.get(
        "average_latency_ms",
        (
            total_latency_ms / len(selected_links)
            if selected_links
            else 0.0
        )
    )

    number_of_hops = routing_result["number_of_hops"]

    positions = get_rbc_node_positions()

    fig, ax = plt.subplots(figsize=(16, 11))

    # --------------------------------------------------------
    # A. IDENTIFY GRAPH EDGES
    # --------------------------------------------------------

    all_edges = list(graph.edges())

    selected_edges = [

        (item["source"], item["destination"])

        for item in selected_links

    ]

    candidate_edges = []

    for record in candidate_history:

        for candidate in record["candidates"]:

            edge = (

                record["current_node"],

                candidate["destination"]

            )

            if edge not in selected_edges:

                candidate_edges.append(edge)

    # --------------------------------------------------------
    # B. DRAW ALL AVAILABLE GRAPH CONNECTIONS
    # --------------------------------------------------------

    nx.draw_networkx_edges(

        graph,

        positions,

        edgelist=all_edges,

        edge_color="lightgray",

        width=1.5,

        ax=ax

    )

    # --------------------------------------------------------
    # C. DRAW CANDIDATE LINKS
    # --------------------------------------------------------

    candidate_edges = list(dict.fromkeys(candidate_edges))

    nx.draw_networkx_edges(

        graph,

        positions,

        edgelist=candidate_edges,

        edge_color="darkorange",

        width=2.0,

        style="dashed",

        alpha=0.8,

        ax=ax

    )

    # --------------------------------------------------------
    # D. DRAW SELECTED ROUTING LINKS
    # --------------------------------------------------------

    nx.draw_networkx_edges(

        graph,

        positions,

        edgelist=selected_edges,

        edge_color="red",

        width=4.0,

        ax=ax

    )

    # --------------------------------------------------------
    # E. DRAW GRAPH NODES
    # --------------------------------------------------------

    start_node = route[0]

    destination_node = (

        routing_result.get("destination_node")

        or RBC_STATE["selected_subslot"]

    )

    node_colors = []

    for node in graph.nodes():

        if node == start_node:

            node_colors.append("royalblue")

        elif (

            routing_result["status"] == "success"

            and node == destination_node

        ):

            node_colors.append("limegreen")

        elif node in visited:

            node_colors.append("darkorange")

        else:

            node_colors.append("lightgray")

    nx.draw_networkx_nodes(

        graph,

        positions,

        node_color=node_colors,

        node_size=1250,

        edgecolors="black",

        linewidths=1.2,

        ax=ax

    )

    # --------------------------------------------------------
    # F. DRAW NODE LABELS
    # --------------------------------------------------------

    nx.draw_networkx_labels(

        graph,

        positions,

        font_size=10,

        font_weight="bold",

        font_color="black",

        ax=ax

    )

    # --------------------------------------------------------
    # G. DRAW ROUTE STEP LABELS
    # --------------------------------------------------------

    for index, node in enumerate(route):

        x, y = positions[node]

        ax.annotate(

            f"Step {index}",

            xy=(x, y),

            xytext=(0, 17),

            textcoords="offset points",

            ha="center",

            fontsize=20,

            fontweight="bold"

        )

    # --------------------------------------------------------
    # H. TITLES AND LEGEND
    # --------------------------------------------------------

    ax.text(

        0,

        0.7,

        "Slot 1",

        ha="center",

        fontsize=19,

        fontweight="bold"

    )

    ax.text(

        5,

        0.7,

        "Slot 2",

        ha="center",

        fontsize=19,

        fontweight="bold"

    )

    legend_elements = [

        Line2D(

            [0], [0],

            color="lightgray",

            lw=2,

            label="Available links"

        ),

        Line2D(

            [0], [0],

            color="darkorange",

            lw=2,

            linestyle="--",

            label="Candidate links"

        ),

        Line2D(

            [0], [0],

            color="red",

            lw=4,

            label="Selected routing links"

        ),

        Line2D(

            [0], [0],

            marker="o",

            color="w",

            markerfacecolor="royalblue",

            markeredgecolor="black",

            markersize=12,

            label="Starting subslot"

        ),

        Line2D(

            [0], [0],

            marker="o",

            color="w",

            markerfacecolor="darkorange",

            markeredgecolor="black",

            markersize=12,

            label="Intermediate hop"

        ),

        Line2D(

            [0], [0],

            marker="o",

            color="w",

            markerfacecolor="limegreen",

            markeredgecolor="black",

            markersize=12,

            label="Destination"

        )

    ]

    ax.legend(

        handles=legend_elements,

        loc="upper center",

        bbox_to_anchor=(0.5, 1.112),

        ncol=3,

        frameon=True

    )

    # --------------------------------------------------------
    # I. ROUTING INFORMATION WITH LATENCY
    # --------------------------------------------------------

    route_text = " → ".join(route)

    status = routing_result["status"]

    ax.text(

        2.5,

        -11.0,

        f"Routing status: {status}\n"

        f"Number of hops: {number_of_hops}\n"

        f"Total End-to-End Latency: {total_latency_ms:.4f} ms\n"

        f"Average Link Latency: {average_latency_ms:.4f} ms\n"

        f"Route: {route_text}",

        ha="center",

        va="top",

        fontsize=11,

        bbox=dict(

            boxstyle="round,pad=0.5",

            facecolor="white",

            edgecolor="gray",

            alpha=0.9

        )

    )

    # --------------------------------------------------------
    # J. AXIS CONFIGURATION
    # --------------------------------------------------------

    ax.set_xlim(-1.5, 6.5)

    ax.set_ylim(-12.0, 1.5)

    ax.axis("off")

    plt.tight_layout()

    # --------------------------------------------------------

    # --------------------------------------------------------
    # K. SAVE ROUTING FOOTPRINT (ROBUST WINDOWS PATH HANDLING)
    # --------------------------------------------------------

    from pathlib import Path
    import re

    # Ensure output directory exists
    output_dir = Path(RBC_ROUTING_DIR)

    output_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    # Construct filename
    if episode is not None:

        filename = f"RBC_Routing_Footprint_Episode_{episode}"

    else:

        filename = "RBC_Routing_Footprint"

    # Remove invalid Windows filename characters
    filename = re.sub(
        r'[<>:"/\\|?*\x00-\x1f]',
        "_",
        str(filename)
    ).strip(" .")

    # Save in configured formats
    for fmt in ROUTING_SAVE_FORMAT:

        fmt = str(fmt).strip().lower().lstrip(".")

        if not fmt:
            continue

        output_path = output_dir / f"{filename}.{fmt}"

        try:

            fig.savefig(
                str(output_path),
                format=fmt,
                dpi=ROUTING_DPI,
                bbox_inches="tight"
            )

            print(
                f"[RBC] Routing footprint saved: {output_path}"
            )

        except (OSError, ValueError) as error:

            print(
                f"[RBC] Failed to save routing footprint:\n"
                f"Path: {output_path!s}\n"
                f"Format: {fmt}\n"
                f"Error: {error}"
            )

    plt.show()

    plt.close(fig)


