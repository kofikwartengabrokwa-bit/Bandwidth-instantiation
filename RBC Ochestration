# ============================================================
# 4.5 DEFINE RBF NETWORK
# ============================================================

class RBC_RBF_Network(nn.Module):

    def __init__(
        self,
        input_dim,
        num_centers,
        sigma=None
    ):

        super(RBC_RBF_Network, self).__init__()

        self.input_dim = input_dim
        self.num_centers = num_centers

        # ----------------------------------------------------
        # Initialize RBF centers
        # ----------------------------------------------------

        centers = torch.rand(
            num_centers,
            input_dim
        )

        self.centers = nn.Parameter(centers)

        # ----------------------------------------------------
        # Initialize Gaussian widths
        # ----------------------------------------------------

        if sigma is None:

            initial_sigma = torch.ones(
                num_centers
            ) * 0.5

        else:

            initial_sigma = torch.ones(
                num_centers
            ) * float(sigma)

        self.log_sigma = nn.Parameter(
            torch.log(initial_sigma)
        )

        # ----------------------------------------------------
        # Output transformation
        # ----------------------------------------------------

        self.output_layer = nn.Linear(
            num_centers,
            num_centers
        )

    def forward(self, x):

        # ----------------------------------------------------
        # Pairwise squared Euclidean distances
        # ----------------------------------------------------

        distances = torch.cdist(
            x,
            self.centers,
            p=2
        ) ** 2

        # ----------------------------------------------------
        # Positive Gaussian widths
        # ----------------------------------------------------

        sigma = torch.exp(
            self.log_sigma
        ).clamp(min=RBF_NORMALIZATION_EPS)

        # ----------------------------------------------------
        # Gaussian RBF activation
        # ----------------------------------------------------

        rbf_activations = torch.exp(
            -distances /
            (2.0 * sigma.unsqueeze(0) ** 2)
        )

        # ----------------------------------------------------
        # Learnable feature transformation
        # ----------------------------------------------------

        output = torch.relu(
            self.output_layer(rbf_activations)
        )

        return rbf_activations, output


