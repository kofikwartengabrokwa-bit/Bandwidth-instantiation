from matplotlib.lines import Line2D


def get_rbc_node_positions():

    """
    Position the two groups of ten subslots
    in a two-column topology.
    """

    positions = {}

    for i in range(SUBSLOTS_PER_SLOT):

        positions[f"Slot_1_S{i+1}"] = (0, -i)

        positions[f"Slot_2_S{i+1}"] = (5, -i)

