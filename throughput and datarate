def calculate_reward(user, allocation, latency_limit_ms):
    """Calculate the reward for a user's resource allocation."""

    demand = max(float(user["demand_mbps"]), 1e-6)

    rate_satisfaction = min(
        float(allocation["throughput_mbps"]) / demand,
        1.0,
    )

    # Use measured allocation latency when available.
    # Fall back to the user's latency requirement only if the
    # allocation result does not contain a valid latency value.
    experienced_latency = allocation.get("latency_ms", np.nan)

    if not np.isfinite(experienced_latency):
        experienced_latency = float(user["latency_ms"])

    latency_violation = float(
        experienced_latency > latency_limit_ms
    )

    rb_cost = (
        allocation["allocated_rbs"] / max(TOTAL_RBS, 1)
    )

    power_cost = (
        allocation["power"] / max(TOTAL_POWER_BUDGET, 1e-8)
    )

    return float(
        2.0 * rate_satisfaction
        - 0.25 * rb_cost
        - 0.20 * power_cost
        - 0.50 * latency_violation
    )


def run_training_episode(
    model_agent,
    users,
    latency_limit_ms=20.0,
):
    """Train one agent for one scheduling episode."""

    odu = ODU()
    odu.reset()

    users = list(users)
    random.shuffle(users)

    episode_rewards = []
    episode_losses = []
    user_data_rates = []
    user_latencies = []

    for i, user in enumerate(users):

        state = make_state(
            user,
            odu,
            latency_limit_ms,
        )

        action_index = model_agent.select_action(
            state,
            explore=True,
        )

        requested_rbs, requested_power = ACTIONS[action_index]

        allocation = odu.allocate(
            user,
            requested_rbs,
            requested_power,
        )

        reward = calculate_reward(
            user,
            allocation,
            latency_limit_ms,
        )

        # Collect per-user performance metrics.
        user_data_rates.append(
            float(allocation["data_rate_mbps"])
        )

        allocation_latency = allocation.get(
            "latency_ms", np.nan
        )

        if np.isfinite(allocation_latency):
            user_latencies.append(float(allocation_latency))

        done = i == len(users) - 1

        if done:
            next_state = np.zeros(
                STATE_DIM,
                dtype=np.float32,
            )
        else:
            next_state = make_state(
                users[i + 1],
                odu,
                latency_limit_ms,
            )

        model_agent.memory.add(
            state,
            action_index,
            reward,
            next_state,
            done,
        )

        # Learn every four user decisions.
        if i % 4 == 0:
            loss = model_agent.learn()

            if loss is not None:
                episode_losses.append(loss)

        episode_rewards.append(reward)

    model_agent.decay_epsilon()

    # Aggregate the metrics from this episode.
    summary = odu.get_summary()

    mean_data_rate = (
        float(np.mean(user_data_rates))
        if user_data_rates
        else 0.0
    )

    mean_latency = (
        float(np.mean(user_latencies))
        if user_latencies
        else np.nan
    )

    return {
        "mean_reward": float(np.mean(episode_rewards)),
        "total_reward": float(np.sum(episode_rewards)),
        "mean_loss": (
            float(np.mean(episode_losses))
            if episode_losses
            else np.nan
        ),

        "allocated_rbs": summary["allocated_rbs"],
        "allocated_power": summary["total_power"],
        "allocated_bandwidth_mhz": (
            summary["allocated_bandwidth_mhz"]
        ),

        # Aggregate throughput is the sum of user throughputs.
        "throughput_mbps": summary["throughput_mbps"],

        # Mean per-user data rate is kept distinct from aggregate
        # throughput for the user-load plots.
        "data_rate_mbps": mean_data_rate,

        "latency_ms": mean_latency,
        "energy_proxy": summary["energy_proxy"],
        "users_served": summary["users_served"],

        "rb_utilization": (
            summary["allocated_rbs"] / max(TOTAL_RBS, 1)
        ),
        "power_utilization": (
            summary["total_power"]
            / max(TOTAL_POWER_BUDGET, 1e-8)
        ),
    }


