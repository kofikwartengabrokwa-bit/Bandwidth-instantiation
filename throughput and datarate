            plot_df["model"] == model_name
        ].copy()

        if subset.empty:
            continue

        summary = (
            subset.groupby("sweep_value")[y_column]
            .agg(["mean", "std"])
            .reset_index()
            .sort_values("sweep_value")
        )

        summary = summary[
            np.isfinite(summary["mean"])
        ]

        if summary.empty:
            continue

        marker, linestyle = MODEL_STYLES[model_name]

        ax.errorbar(
            summary["sweep_value"],
            summary["mean"],
            yerr=summary["std"].fillna(0.0),
            label=MODEL_DISPLAY_NAMES[model_name],
            marker=marker,
            linestyle=linestyle,
            markersize=7,
            capsize=4,
            linewidth=2.5,
            clip_on=True,
        )

    # ------------------------------------------------------------
    # Force the x-axis to begin at the leftmost zero
    # ------------------------------------------------------------
    valid_x = pd.to_numeric(
        plot_df["sweep_value"],
        errors="coerce",
    ).dropna()

    max_x = valid_x.max()

    ax.set_xlim(left=0, right=max_x * 1.02)

    # Show the origin and all actual user-load values.
    user_ticks = sorted(valid_x.unique())
    ax.set_xticks([0] + [x for x in user_ticks if x != 0])

    ax.set_xlabel("Number of users")
    ax.set_ylabel(y_label)

    # Remove horizontal padding added by Matplotlib.
    ax.margins(x=0, y=0.08)

    ax.set_ylabel(y_label)
    ax.margins(x=0, y=0.08)
    ax.grid(True, linestyle="--", alpha=0.5)
    ax.legend(loc="best", ncol=2)

    fig.tight_layout()

    png_path = FIG_DIR / f"{filename}.png"
    eps_path = FIG_DIR / f"{filename}.eps"

    fig.savefig(
        png_path,
        dpi=600,
        bbox_inches="tight",
    )

    fig.savefig(
        eps_path,
        format="eps",
        dpi=600,
        bbox_inches="tight",
    )

    plt.show()
    plt.close(fig)

    print(f"Saved: {png_path}")
    print(f"Saved: {eps_path}")

