# BLOCK 7: GENERAL COMPARISON SWEEP
# Supports fixed-user and variable-user experiments
# ============================================================

def run_comparison_sweep(
    experiment_name,
    sweep_values,
    scenario_fn,
    user_load=None,
):
    """
    Evaluate all models over a scenario sweep.

    If user_load is None, use FIXED_EVAL_USERS.
    Otherwise, use the specified number of users.
    """

    rows = []

    num_users = (
        FIXED_EVAL_USERS
        if user_load is None
        else int(user_load)
    )

    if num_users <= 0:
        raise ValueError(
            "user_load must be a positive integer."
        )

    for value in sweep_values:

        total_rbs, bandwidth_mhz, latency_limit_ms = (
            scenario_fn(value)
        )

        for repeat in range(EVAL_REPEATS):

            # Use the same generated users for every model
            # within a given sweep value and repeat.
            shared_users = generate_users(
                num_users,
                seed=(
                    SEED
                    + 100_000
                    + repeat * 1000
                    + int(value * 10)
                ),
            )

            for model_name in MODEL_NAMES:

                result = evaluate_model(
                    model_agent=agents[model_name],
                    users=copy.deepcopy(shared_users),
                    total_rbs=total_rbs,
                    bandwidth_mhz=bandwidth_mhz,
                    power_budget=TOTAL_POWER_BUDGET,
                    latency_limit_ms=latency_limit_ms,
                )

                rows.append({
                    "experiment": experiment_name,
                    "sweep_value": value,
                    "num_users": num_users,
                    "repeat": repeat,
                    "model": model_name,

                    # Performance metrics.
                    "throughput_mbps": (
                        result["throughput_mbps"]
                    ),
                    "data_rate_mbps": (
                        result["data_rate_mbps"]
                    ),
                    "latency_ms": (
                        result["latency_ms"]
                    ),

                    # Energy and power metrics.
                    "energy_proxy": (
                        result["energy_proxy"]
                    ),
                    "total_power": (
                        result["total_power"]
                    ),

                    # Resource allocation metrics.
                    "allocated_rbs": (
                        result["allocated_rbs"]
                    ),
                    "allocated_bandwidth_mhz": (
                        result["allocated_bandwidth_mhz"]
                    ),
                    "users_served": (
                        result["users_served"]
                    ),

                    # Resource utilization metrics.
                    "rb_utilization": (
                        result["rb_utilization"]
                    ),
                    "bandwidth_utilization": (
                        result["bandwidth_utilization"]
                    ),
                    "power_utilization": (
                        result["power_utilization"]
                    ),
                })

        print(
            f"Completed {experiment_name}: "
            f"value={value}, users={num_users}"
        )

    return pd.DataFrame(rows)

