def format_x_axis(ax, x_values, x_label, user_load_axis=False):
    """
    Start the x-axis at zero and use sensible tick positions.
    Does not fabricate a data point at x=0.
    """
    x_values = pd.to_numeric(
        pd.Series(x_values), errors="coerce"
    ).dropna()

    if x_values.empty:
        ax.set_xlim(left=0)
        ax.set_xlabel(x_label)
        return

    max_x = float(x_values.max())

    # Ensure the left boundary is exactly zero.
    # Use the largest observed x-value as the right boundary,
    # with a small margin so markers/error bars are not clipped.
    if max_x > 0:
        ax.set_xlim(left=0, right=max_x * 1.04)
    else:
        ax.set_xlim(left=0, right=1)

    # Prefer the actual experimental x-values as ticks.
    unique_x = sorted(x_values.unique())

    if user_load_axis:
        ax.set_xticks(unique_x)
    elif len(unique_x) <= 12:
        ax.set_xticks(unique_x)

    ax.set_xlabel(x_label)


