# ============================================================
# O-DU: SHARED RESOURCE-BUDGET CONTROLLER
# Supports data rate, throughput, latency, and energy metrics
# ============================================================

class ODU:
    """O-DU shared resource-budget controller."""

    def __init__(
        self,
        total_rbs=TOTAL_RBS,
        total_bandwidth_mhz=TOTAL_BANDWIDTH_MHZ,
        power_budget=TOTAL_POWER_BUDGET,
    ):
        self.total_rbs = max(0, int(total_rbs))
        self.total_bandwidth_mhz = max(
            0.0, float(total_bandwidth_mhz)
        )
        self.power_budget = max(0.0, float(power_budget))
        self.reset()

    def reset(self):
        """Reset the available resources for a scheduling interval."""
        self.remaining_rbs = self.total_rbs
        self.remaining_power = self.power_budget

        self.total_allocated_rbs = 0
        self.total_allocated_bandwidth_mhz = 0.0
        self.total_allocated_power = 0.0
        self.total_throughput_mbps = 0.0
        self.total_energy_proxy = 0.0
        self.users_served = 0
        self.user_latencies_ms = []

    @property
    def bandwidth_per_rb(self):
        """Available bandwidth per RB under the configured model."""
        return (
            self.total_bandwidth_mhz / self.total_rbs
            if self.total_rbs > 0
            else 0.0
        )

    def allocate(self, user, requested_rbs, requested_power):
        """Allocate available RBs and power to one user."""

        # Enforce the remaining O-DU resource budgets.
        rbs = min(
            max(0, int(requested_rbs)),
            self.remaining_rbs,
        )

        power = min(
            max(0.0, float(requested_power)),
            self.remaining_power,
        )

        if rbs == 0:
            power = 0.0

        bandwidth = rbs * self.bandwidth_per_rb

        # Illustrative link model, not a calibrated 5G PHY model.
        channel = float(np.clip(user["channel"], 0.0, 1.0))
        spectral_efficiency = 0.5 + 4.5 * channel

        power_factor = (
            min(np.sqrt(power / 4.0), 2.0)
            if power > 0.0
            else 0.0
        )

        # Mbps, assuming MHz * bits/s/Hz.
        data_rate_mbps = (
            bandwidth * spectral_efficiency * power_factor
        )

        # Under this model, instantaneous allocated data rate
        # and per-user throughput are the same quantity.
        throughput_mbps = data_rate_mbps

        # Simplified transmission-time estimate:
        # latency = transmitted data volume / achieved data rate.
        # If the user has no positive data volume or rate, latency
        # is undefined and is returned as NaN.
        data_volume_mbits = float(
            user.get("data_volume_mbits", np.nan)
        )

        if (
            np.isfinite(data_volume_mbits)
            and data_volume_mbits >= 0.0
            and data_rate_mbps > 0.0
        ):
            latency_ms = (
                data_volume_mbits / data_rate_mbps
            ) * 1000.0
        else:
            latency_ms = np.nan

        # Energy proxy in joules, assuming power is in watts
        # and SLOT_SECONDS is measured in seconds.
        energy_proxy = power * SLOT_SECONDS

        # Update the O-DU resource budgets.
        self.remaining_rbs -= rbs
        self.remaining_power -= power

        # Accumulate scheduling-interval statistics.
        self.total_allocated_rbs += rbs
        self.total_allocated_bandwidth_mhz += bandwidth
        self.total_allocated_power += power
        self.total_throughput_mbps += throughput_mbps
        self.total_energy_proxy += energy_proxy

        if rbs > 0 and throughput_mbps > 0.0:
            self.users_served += 1

        if np.isfinite(latency_ms):
            self.user_latencies_ms.append(latency_ms)

        return {
            "allocated_rbs": rbs,
            "bandwidth_mhz": float(bandwidth),
            "power": float(power),
            "data_rate_mbps": float(data_rate_mbps),
            "throughput_mbps": float(throughput_mbps),
            "latency_ms": float(latency_ms),
            "energy_proxy": float(energy_proxy),
        }

    def get_summary(self):
        """Return aggregate metrics for the scheduling interval."""

        mean_latency_ms = (
            float(np.mean(self.user_latencies_ms))
            if self.user_latencies_ms
            else np.nan
        )

        return {
            "allocated_rbs": self.total_allocated_rbs,
            "allocated_bandwidth_mhz": (
                self.total_allocated_bandwidth_mhz
            ),
            "total_power": self.total_allocated_power,
            "throughput_mbps": self.total_throughput_mbps,
            "data_rate_mbps": self.total_throughput_mbps,
            "latency_ms": mean_latency_ms,
            "energy_proxy": self.total_energy_proxy,
            "users_served": self.users_served,
        }



# State dimensions:
# 4 slice indicators + channel + demand + observed latency +
# latency constraint + remaining RB fraction + remaining power
# fraction + current total RB scale + current bandwidth scale.
STATE_DIM = 12

def make_state(user, odu, latency_limit_ms):
    slice_one_hot = [
        float(user["slice"] == name)
        for name in SLICE_NAMES
    ]

    return np.asarray(
        slice_one_hot + [
            user["channel"],
            np.clip(user["demand_mbps"] / 20.0, 0.0, 1.0),
            np.clip(user["latency_ms"] / 100.0, 0.0, 1.0),
            np.clip(latency_limit_ms / 100.0, 0.0, 1.0),
            odu.remaining_rbs / max(odu.total_rbs, 1),
            odu.remaining_power / max(odu.power_budget, 1e-8),
            min(odu.total_rbs / 200.0, 1.0),
            min(odu.total_bandwidth_mhz / 40.0, 1.0),
        ],
        dtype=np.float32,
    )

