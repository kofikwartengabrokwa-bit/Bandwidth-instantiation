# BLOCK 6: COMMON EVALUATION FUNCTION
# ============================================================

def evaluate_model(
    model_agent,
    users,
    total_rbs,
    bandwidth_mhz,
    power_budget,
    latency_limit_ms,
):
    """
    Evaluate one trained model under a shared resource budget.

    Returns:
        Aggregate throughput, mean per-user data rate,
        mean experienced latency, energy, resource utilization,
        users served, and per-user allocation details.
    """

    odu = ODU(
        total_rbs=total_rbs,
        total_bandwidth_mhz=bandwidth_mhz,
        power_budget=power_budget,
    )

    odu.reset()
    records = []

    for user in users:

        # Construct the current observation.
        state = make_state(
            user,
            odu,
            latency_limit_ms,
        )

        # Deterministic evaluation: disable exploration.
        action_index = model_agent.select_action(
            state,
            explore=False,
        )

        requested_rbs, requested_power = ACTIONS[
            action_index
        ]

        # Allocate resources subject to the remaining budget.
        allocation = odu.allocate(
            user,
            requested_rbs,
            requested_power,
        )

        records.append({
            "user_id": user["user_id"],
            "slice": user["slice"],
            "demand_mbps": user["demand_mbps"],
            "latency_requirement_ms": user["latency_ms"],
            **allocation,
        })

    details = pd.DataFrame(records)

    # --------------------------------------------------------
    # Handle empty evaluation sets safely.
    # --------------------------------------------------------
    if details.empty:
        return {
            "throughput_mbps": 0.0,
            "data_rate_mbps": np.nan,
            "latency_ms": np.nan,
            "energy_proxy": 0.0,
            "total_power": 0.0,
            "allocated_rbs": 0,
            "allocated_bandwidth_mhz": 0.0,
            "users_served": 0,
            "rb_utilization": 0.0,
            "bandwidth_utilization": 0.0,
            "power_utilization": 0.0,
            "details": details,
        }

    # --------------------------------------------------------
    # Aggregate performance metrics.
    # --------------------------------------------------------
    total_throughput = float(
        details["throughput_mbps"].sum()
    )

    allocated_rbs = int(
        details["allocated_rbs"].sum()
    )

    allocated_bandwidth = float(
        details["bandwidth_mhz"].sum()
    )

    total_power = float(
        details["power"].sum()
    )

    total_energy = float(
        details["energy_proxy"].sum()
    )

    users_served = int(
        (details["allocated_rbs"] > 0).sum()
    )

    # Mean data rate among users receiving RBs.
    served_mask = details["allocated_rbs"] > 0

    if (
        served_mask.any()
        and "data_rate_mbps" in details.columns
    ):
        valid_rates = details.loc[
            served_mask, "data_rate_mbps"
        ]

        valid_rates = valid_rates[
            np.isfinite(valid_rates)
        ]

        mean_data_rate = (
            float(valid_rates.mean())
            if not valid_rates.empty
            else np.nan
        )
    else:
        mean_data_rate = np.nan

    # Mean experienced latency for users with valid measurements.
    if "latency_ms" in details.columns:
        valid_latencies = details["latency_ms"]

        valid_latencies = valid_latencies[
            np.isfinite(valid_latencies)
        ]

        mean_latency = (
            float(valid_latencies.mean())
            if not valid_latencies.empty
            else np.nan
        )
    else:
        mean_latency = np.nan

    # --------------------------------------------------------
    # Resource utilization.
    # --------------------------------------------------------
    rb_utilization = (
        allocated_rbs / max(int(total_rbs), 1)
    )

    bandwidth_utilization = (
        allocated_bandwidth
        / max(float(bandwidth_mhz), 1e-8)
    )

    power_utilization = (
        total_power / max(float(power_budget), 1e-8)
    )

    # --------------------------------------------------------
    # Verify that the resource budgets are respected.
    # --------------------------------------------------------
    assert allocated_rbs <= total_rbs, (
        "Allocated RBs exceed the available RB budget."
    )

    assert allocated_bandwidth <= bandwidth_mhz + 1e-6, (
        "Allocated bandwidth exceeds the available bandwidth."
    )

    assert total_power <= power_budget + 1e-6, (
        "Allocated power exceeds the power budget."
    )

    return {
        # Aggregate throughput across served users.
        "throughput_mbps": total_throughput,

        # Mean data rate per served user.
        "data_rate_mbps": mean_data_rate,

        # Mean measured latency; NaN if unavailable.
        "latency_ms": mean_latency,

        "energy_proxy": total_energy,
        "total_power": total_power,
        "allocated_rbs": allocated_rbs,
        "allocated_bandwidth_mhz": allocated_bandwidth,
        "users_served": users_served,
        "rb_utilization": float(rb_utilization),
        "bandwidth_utilization": float(
            bandwidth_utilization
        ),
        "power_utilization": float(power_utilization),
        "details": details,
    }


