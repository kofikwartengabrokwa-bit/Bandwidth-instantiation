# ------------------------------------------------------------

excluded_columns = set(LABEL_COLUMNS + IDENTIFIER_COLUMNS)

numeric_columns = DATA_CLEAN.select_dtypes(
    include=[np.number]
).columns.tolist()

FEATURE_COLUMNS = [
    col for col in numeric_columns
    if col not in excluded_columns
]

if not FEATURE_COLUMNS:
    raise ValueError(
        "No usable numerical input features were identified. "
        "Inspect Block 3's column names and data types."
    )

X_DF = DATA_CLEAN[FEATURE_COLUMNS].copy()

# Convert infinities to missing values and impute with column medians.
X_DF = X_DF.replace([np.inf, -np.inf], np.nan)

all_missing = X_DF.columns[X_DF.isna().all()].tolist()
if all_missing:
    print("Dropping all-missing features:", all_missing)
    X_DF = X_DF.drop(columns=all_missing)

FEATURE_COLUMNS = X_DF.columns.tolist()

if not FEATURE_COLUMNS:
    raise ValueError("No numerical features remain after cleaning.")

X_DF = X_DF.fillna(X_DF.median())

# Remove constant columns.
constant_columns = [
    col for col in X_DF.columns
    if X_DF[col].nunique(dropna=False) <= 1
]

if constant_columns:
    print("Dropping constant features:", constant_columns)
    X_DF = X_DF.drop(columns=constant_columns)

FEATURE_COLUMNS = X_DF.columns.tolist()

if not FEATURE_COLUMNS:
