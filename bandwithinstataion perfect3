)
traffic_probabilities /= traffic_probabilities.sum()


def generate_workload(num_users, seed=SEED):
    """
    Generate a reproducible workload.

    Radio-context vectors are sampled from prepared dataset rows.
    Traffic classes and QoS targets come from the explicit profiles
    configured in Block 10; they are not dataset ground-truth labels.
    """
    rng = np.random.default_rng(seed)

    row_indices = rng.integers(
        0, len(RADIO_CONTEXT), size=num_users
    )
    context = RADIO_CONTEXT[row_indices].copy()

    class_indices = rng.choice(
        len(TRAFFIC_NAMES),
        size=num_users,
        p=traffic_probabilities
    )
    class_names = np.asarray(TRAFFIC_NAMES, dtype=object)[class_indices]

    demand = np.array([
        TRAFFIC_PROFILES[name]["target_rate_mbps"]
        for name in class_names
    ], dtype=np.float32)

    min_rate = np.array([
        TRAFFIC_PROFILES[name]["min_rate_mbps"]
        for name in class_names
    ], dtype=np.float32)

    max_latency = np.array([
        TRAFFIC_PROFILES[name]["max_latency_ms"]
        for name in class_names
    ], dtype=np.float32)

    reliability = np.array([
        TRAFFIC_PROFILES[name]["min_reliability"]
        for name in class_names
    ], dtype=np.float32)

    priority = np.array([
        TRAFFIC_PROFILES[name]["priority"]
        for name in class_names
    ], dtype=np.float32)

    # Initial normalized channel-quality proxy derived from the
    # dataset feature vectors. It is NOT a measured SINR estimate.
    context_quality = np.mean(context, axis=1)
    context_quality = np.clip(context_quality, 0.0, 1.0)

    # Configurable per-user radio context for the allocation model.
    # The scaling factors are simulation assumptions.
    channel_factor = np.clip(
        0.25 + 1.5 * context_quality, 0.25, 1.75
    )

    return {
        "features": context,
        "class_names": class_names,
        "class_indices": class_indices.astype(np.int64),
        "demand_mbps": demand,
        "min_rate_mbps": min_rate,
        "max_latency_ms": max_latency,
        "reliability_target": reliability,
        "priority": priority,
        "channel_factor": channel_factor.astype(np.float32),
    }


