    "iot": "IoT",
    "mtm": "MTM",
    "m2m": "MTM",
}

CLASS_ORDER = ["eMBB", "uRLLC", "Vehicular", "IoT", "MTM"]

# Add or modify aliases here if Block 19 reveals other column names.
COLUMN_ALIASES = {
    "model": [
        "algorithm", "model", "method", "agent", "algorithm_name"
    ],
    "traffic_class": [
        "traffic_class", "slice", "slice_type", "service_type",
        "traffic_type", "class_name"
    ],
    "data_rate": [
        "data_rate_mbps", "throughput_mbps", "mean_data_rate_mbps",
        "avg_throughput_mbps", "throughput", "data_rate"
    ],
    "latency": [
        "latency_ms", "mean_latency_ms", "avg_latency_ms",
        "delay_ms", "latency", "delay"
    ],
    "energy": [
        "energy_j", "energy_consumption_j", "energy_consumption",
        "energy_proxy", "mean_energy", "energy_w", "power_w",
        "mean_power_w"
    ],
    "prbs": [
        "allocated_prbs", "prbs_allocated", "mean_prbs",
        "allocated_rbs", "rb_allocation", "resource_blocks"
    ],
    "bandwidth": [
        "allocated_bandwidth_mhz", "bandwidth_mhz",
        "allocated_bandwidth", "bandwidth"
    ],
    "satisfaction": [
        "service_satisfaction_ratio", "qos_satisfaction_ratio",
        "satisfaction_ratio", "service_satisfaction",
        "qos_satisfaction"
    ],
    "qos_violation": [
        "qos_violation_ratio", "violation_ratio",
        "qos_violations", "violation_rate"
    ],
    "spectral_efficiency": [
        "spectral_efficiency_bps_hz", "spectral_efficiency",
        "se_bps_hz"
    ],
    "packet_loss": [
        "packet_loss_ratio", "packet_loss_rate",
        "packet_loss"
    ],
    "reliability": [
        "reliability", "reliability_ratio", "success_probability"
    ],
    "utility": [
        "utility", "mean_utility", "normalized_utility"
    ],
    "acceptance": [
        "acceptance_ratio", "request_acceptance_ratio",
        "admission_ratio"
    ],
}

def normalize_name(value):
    """Normalize column names and model/class labels."""
    return re.sub(r"[^a-z0-9]+", "_", str(value).strip().lower()).strip("_")

def find_column(df, aliases):
    normalized = {normalize_name(c): c for c in df.columns}

    for alias in aliases:
        key = normalize_name(alias)
        if key in normalized:
            return normalized[key]

    return None

# ------------------------------------------------------------
# 1. Load candidate CSVs and find the best class-level dataset
# ------------------------------------------------------------
candidate_files = list(RESULT_DIR.rglob("*.csv"))
best_df = None
best_file = None
best_mapping = None
best_score = -1

for file_path in candidate_files:
    try:
        candidate = pd.read_csv(file_path)
    except Exception:
        continue

    if candidate.empty:
        continue

    mapping = {
        key: find_column(candidate, aliases)
        for key, aliases in COLUMN_ALIASES.items()
    }

    # Both model and class identifiers are required for class plots.
    if mapping["model"] is None or mapping["traffic_class"] is None:
        continue

    metric_count = sum(
        mapping[key] is not None
        for key in COLUMN_ALIASES
        if key not in ("model", "traffic_class")
    )

    # Prefer files with more useful metrics and more observations.
    score = metric_count * 100000 + min(len(candidate), 99999)

    if score > best_score:
        best_score = score
        best_df = candidate.copy()
        best_file = file_path
        best_mapping = mapping

if best_df is None:
    raise ValueError(
        "No CSV contains both a recognizable model column and traffic-class "
        "column. Inspect Block 19 and update COLUMN_ALIASES."
    )

print("Selected source:", best_file)
print("Rows:", len(best_df))
print("Detected columns:", best_mapping)

# ------------------------------------------------------------
# 2. Standardize model and traffic-class labels
# ------------------------------------------------------------
def normalize_model(value):
    key = normalize_name(value)
    return MODEL_ALIASES.get(key, None)

def normalize_class(value):
    key = normalize_name(value)
    return CLASS_ALIASES.get(key, None)

best_df["plot_model"] = best_df[best_mapping["model"]].map(normalize_model)
best_df["plot_class"] = best_df[best_mapping["traffic_class"]].map(
    normalize_class
)

best_df = best_df[
    best_df["plot_model"].isin(MODEL_ORDER)
    & best_df["plot_class"].isin(CLASS_ORDER)
].copy()

if best_df.empty:
    raise ValueError(
        "No rows matched the four expected model names and five traffic "
        "classes. Print the unique values in the model/class columns and "
        "extend MODEL_ALIASES or CLASS_ALIASES."
    )

# ------------------------------------------------------------
# 3. Convert detected metrics to numeric values
# ------------------------------------------------------------
metric_specs = {
    "data_rate": ("Data rate / throughput (Mbps)", "DataRate"),
    "latency": ("Latency (ms)", "Latency"),
    "energy": ("Energy / power metric (source units)", "Energy"),
    "prbs": ("Allocated resource blocks (PRBs)", "PRBs"),
    "bandwidth": ("Allocated bandwidth (MHz)", "Bandwidth"),
    "satisfaction": ("Service/QoS satisfaction ratio", "Satisfaction"),
    "qos_violation": ("QoS violation ratio", "QoSViolation"),
    "spectral_efficiency": ("Spectral efficiency (source units)", "SpectralEfficiency"),
    "packet_loss": ("Packet-loss metric (source units)", "PacketLoss"),
    "reliability": ("Reliability metric (source units)", "Reliability"),
    "utility": ("Utility (source units)", "Utility"),
    "acceptance": ("Acceptance ratio", "Acceptance"),
}

available_metrics = {
    key: spec
    for key, spec in metric_specs.items()
    if best_mapping.get(key) is not None
}

if not available_metrics:
    raise ValueError(
        "The selected CSV has model and class columns but no recognized "
        "metric columns. Update COLUMN_ALIASES using Block 19."
    )

for metric, _ in available_metrics.items():
    source_col = best_mapping[metric]
    best_df[metric] = pd.to_numeric(best_df[source_col], errors="coerce")

print("\nMetrics to plot:")
for metric in available_metrics:
    print(f"  {metric}: {best_mapping[metric]}")

# ------------------------------------------------------------
# 4. Aggregate rows at model/class level
# ------------------------------------------------------------
# If the source is per-user or per-episode data, this computes means.
# If it already contains aggregate rows, these are means of those rows.
grouped = (
    best_df.groupby(["plot_class", "plot_model"], as_index=False)
    [list(available_metrics.keys())]
    .mean(numeric_only=True)
)

grouped.to_csv(
    CSV_DIR / "Per_Class_Metric_Means_Four_Models.csv",
    index=False
)

# ------------------------------------------------------------
# 5. Draw a separate figure for each available metric
# ------------------------------------------------------------
for metric, (y_label, file_suffix) in available_metrics.items():

    plot_data = grouped.dropna(subset=[metric]).copy()

    if plot_data.empty:
        print(f"Skipping {metric}: no numeric data.")
        continue

    pivot = plot_data.pivot(
        index="plot_class",
        columns="plot_model",
        values=metric
    )

    pivot = pivot.reindex(index=CLASS_ORDER)
    pivot = pivot.reindex(columns=MODEL_ORDER)

    # Remove models/classes with no recorded observations.
    pivot = pivot.dropna(axis=0, how="all").dropna(axis=1, how="all")

    if pivot.empty:
        continue

    ax = pivot.plot(
        kind="bar",
        figsize=(12, 6.5),
        width=0.78,
        rot=0,
        edgecolor="black"
    )

    ax.set_xlabel("Traffic class")
    ax.set_ylabel(y_label)
    ax.set_axisbelow(True)
    ax.grid(axis="y", linestyle="--", alpha=0.3)
    ax.grid(axis="x", visible=False)
    ax.legend(
        title="Model",
        loc="best",
        frameon=True
    )

    plt.tight_layout()
    plt.show()

    fig = ax.get_figure()
    fig.savefig(
        FIGURE_DIR / f"{file_suffix}_By_Traffic_Class.png",
        dpi=600,
        bbox_inches="tight"
    )
    fig.savefig(
        FIGURE_DIR / f"{file_suffix}_By_Traffic_Class.eps",
        format="eps",
        dpi=600,
        bbox_inches="tight"
    )
    plt.close(fig)

print("\nCompleted class-level metric plots.")
print("Figures saved to:", FIGURE_DIR)
print("Class-level summary saved to:", CSV_DIR)




