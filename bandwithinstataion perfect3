import random
import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from collections import deque

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

STATE_DIM = 8
ACTION_LEVELS = 5
REPLAY_CAPACITY = 20000
BATCH_SIZE = 64
GAMMA = 0.95
LEARNING_RATE = 3e-4
TARGET_UPDATE_STEPS = 100

class ReplayBuffer:
    def __init__(self, capacity=REPLAY_CAPACITY):
        self.memory = deque(maxlen=capacity)

    def add(self, state, action, reward, next_state, done):
        self.memory.append((
            np.asarray(state, dtype=np.float32),
            int(action),
            float(reward),
            np.asarray(next_state, dtype=np.float32),
            float(done),
        ))

    def sample(self, batch_size):
        batch = random.sample(self.memory, batch_size)
        s, a, r, ns, d = zip(*batch)
        return (
            torch.tensor(np.asarray(s), dtype=torch.float32, device=DEVICE),
            torch.tensor(a, dtype=torch.long, device=DEVICE),
            torch.tensor(r, dtype=torch.float32, device=DEVICE),
            torch.tensor(np.asarray(ns), dtype=torch.float32, device=DEVICE),
            torch.tensor(d, dtype=torch.float32, device=DEVICE),
        )

    def __len__(self):
        return len(self.memory)


class AllocationQNetwork(nn.Module):
    def __init__(self, state_dim=STATE_DIM, action_levels=ACTION_LEVELS,
                 architecture="ddqn"):
        super().__init__()
        self.architecture = architecture

        self.input_layer = nn.Linear(state_dim, 64)
        self.local_layer = nn.Linear(64, 64)
        self.global_layer = nn.Linear(64, 64)
        self.output_layer = nn.Linear(64, action_levels)

    def forward(self, x):
        h = torch.relu(self.input_layer(x))

        if self.architecture == "gcn":
            # One-dimensional neighborhood proxy:
            # adjacent users are represented by a batch-local average.
            local = torch.roll(h, shifts=1, dims=0)
            h = torch.relu(self.local_layer(0.5 * (h + local)))

        elif self.architecture == "ggn":
            # Global context aggregation across the current batch.
            global_context = h.mean(dim=0, keepdim=True)
            h = torch.relu(
                self.global_layer(h + global_context)
            )

        return self.output_layer(h)


class DDQNAgent:
    def __init__(self, architecture="ddqn", state_dim=STATE_DIM):
        self.architecture = architecture
        self.online = AllocationQNetwork(
            state_dim=state_dim, architecture=architecture
        ).to(DEVICE)
        self.target = AllocationQNetwork(
            state_dim=state_dim, architecture=architecture
        ).to(DEVICE)
        self.target.load_state_dict(self.online.state_dict())
        self.target.eval()

        self.optimizer = optim.Adam(
            self.online.parameters(), lr=LEARNING_RATE
        )
        self.buffer = ReplayBuffer()
        self.steps = 0

    def choose_action(self, state, epsilon=0.1):
        if random.random() < epsilon:
            return random.randrange(ACTION_LEVELS)

        x = torch.tensor(
            np.asarray(state, dtype=np.float32),
            device=DEVICE
        ).unsqueeze(0)

        with torch.no_grad():
            return int(self.online(x).argmax(dim=1).item())

    def train_step(self):
        if len(self.buffer) < BATCH_SIZE:
            return None

        states, actions, rewards, next_states, dones = (
            self.buffer.sample(BATCH_SIZE)
        )

        q_values = self.online(states).gather(
            1, actions.unsqueeze(1)
        ).squeeze(1)

        # Double DQN: online network chooses; target network evaluates.
        with torch.no_grad():
            next_actions = self.online(next_states).argmax(dim=1)
            next_q = self.target(next_states).gather(
                1, next_actions.unsqueeze(1)
            ).squeeze(1)
            targets = rewards + GAMMA * (1.0 - dones) * next_q

        loss = nn.functional.smooth_l1_loss(q_values, targets)

        self.optimizer.zero_grad()
        loss.backward()
        nn.utils.clip_grad_norm_(self.online.parameters(), 1.0)
        self.optimizer.step()

        self.steps += 1
        if self.steps % TARGET_UPDATE_STEPS == 0:
            self.target.load_state_dict(self.online.state_dict())

        return float(loss.item())


def user_state(workload, i, current_rbs, users_remaining):
    """Build an eight-dimensional normalized user state."""
    return np.asarray([
        workload["features"][i].mean(),
        workload["demand_mbps"][i] / 50.0,
        workload["min_rate_mbps"][i] / 10.0,
        workload["max_latency_ms"][i] / 1000.0,
        workload["priority"][i] / 5.0,
        workload["channel_factor"][i] / 1.75,
        current_rbs / max(TOTAL_RBS, 1),
        users_remaining / max(len(workload["class_names"]), 1),
    ], dtype=np.float32)


# Discrete allocation proposals: 0, 1, 2, 4, or 8 PRBs per user.
ACTION_RBS = np.array([0, 1, 2, 4, 8], dtype=int)

def allocate_with_agent(agent, workload, epsilon=0.0):
    n = len(workload["class_names"])
    proposed = np.zeros(n, dtype=int)

    # All methods use the same order to ensure fair comparison.
    order = np.argsort(
        -np.asarray(workload["priority"]), kind="stable"
    )

    allocated_so_far = 0
    for position, i in enumerate(order):
        state = user_state(
            workload, i, allocated_so_far, n - position
        )
        action = agent.choose_action(state, epsilon=epsilon)
        proposed[i] = ACTION_RBS[action]
        allocated_so_far += proposed[i]

    return proposed


def allocate_edgecover_rbf(workload, centers, sigma):
    """
    RBF + greedy edge-cover-inspired candidate allocation.
    The policy is a transparent heuristic, not an edge-cover
    optimality guarantee.
    """
    features = np.asarray(workload["features"], dtype=np.float32)
    if len(centers) == 0:
        rbf_scores = np.zeros(len(features))
    else:
        dist2 = ((features[:, None, :] - centers[None, :, :]) ** 2).mean(axis=2)
        rbf_scores = np.exp(-dist2 / (2.0 * max(sigma, 1e-6) ** 2)).mean(axis=1)

    priorities = np.asarray(workload["priority"], dtype=float)
    demand = np.asarray(workload["demand_mbps"], dtype=float)
    channel = np.asarray(workload["channel_factor"], dtype=float)

    # Candidate score combines RBF similarity, service priority,
    # demand and channel quality.
    score = (
        0.35 * rbf_scores
        + 0.35 * priorities / 5.0
        + 0.20 * np.clip(demand / 50.0, 0.0, 1.0)
        + 0.10 * np.clip(channel / 1.75, 0.0, 1.0)
    )

    order = np.argsort(-score, kind="stable")
    allocation = np.zeros(len(features), dtype=int)
    remaining = TOTAL_RBS

    for i in order:
        if remaining <= 0:
            break

        desired = int(ACTION_RBS[
            min(int(score[i] * (ACTION_LEVELS - 1)), ACTION_LEVELS - 1)
        ])
        granted = min(desired, remaining)
        allocation[i] = granted
        remaining -= granted

    return allocation


