# BLOCK 6: RBF ENCODER AND EDGECOVER CANDIDATE SELECTION
# ============================================================

import numpy as np
import pandas as pd

# ------------------------------------------------------------
# 6.1 CONFIGURATION
# ------------------------------------------------------------

RBF_NUM_CENTERS = min(64, len(X_train))
RBF_SIGMA = None          # Automatically estimated from training data
RBF_EPS = 1e-8

# Number of candidate users that may share an RB in this
# preliminary abstraction. Calibrate this against the simulator.
MAX_USERS_PER_RB = 10

rng_rbf = np.random.default_rng(SEED)

if len(X_train) == 0:
    raise ValueError("X_train is empty. Run Block 4 successfully first.")

center_indices = rng_rbf.choice(
    len(X_train),
    size=RBF_NUM_CENTERS,
    replace=False,
)

RBF_CENTERS = X_train[center_indices].copy()

# Estimate the RBF width using sampled pairwise distances.
sample_size = min(256, len(X_train))
sample_indices = rng_rbf.choice(
    len(X_train),
    size=sample_size,
    replace=False,
)
sample = X_train[sample_indices]

if len(sample) > 1:
    differences = sample[:, None, :] - sample[None, :, :]
    distances = np.sqrt(
        np.sum(differences ** 2, axis=2)
    )
    positive_distances = distances[distances > RBF_EPS]

    RBF_SIGMA = (
        float(np.median(positive_distances))
        if len(positive_distances)
        else 1.0
    )
else:
    RBF_SIGMA = 1.0

RBF_SIGMA = max(RBF_SIGMA, RBF_EPS)

# ------------------------------------------------------------
# 6.2 RBF FEATURE TRANSFORMATION
# ------------------------------------------------------------

def rbf_transform(features):
    """
    Map normalized input features to radial-basis features.

    Parameters
    ----------
    features : array, shape (n_samples, n_features)

    Returns
    -------
    array, shape (n_samples, RBF_NUM_CENTERS)
    """
    features = np.asarray(features, dtype=np.float32)

    if features.ndim == 1:
        features = features.reshape(1, -1)

    if features.shape[1] != RBF_CENTERS.shape[1]:
        raise ValueError(
            f"Expected {RBF_CENTERS.shape[1]} features, "
            f"received {features.shape[1]}."
        )

    difference = (
        features[:, None, :] - RBF_CENTERS[None, :, :]
    )

    squared_distance = np.sum(
        difference ** 2,
        axis=2,
    )

    encoded = np.exp(
        -squared_distance / (2.0 * RBF_SIGMA ** 2)
    )

    return encoded.astype(np.float32)


# ------------------------------------------------------------
# 6.3 EDGECOVER-INSPIRED RESOURCE CANDIDATE SELECTION
# ------------------------------------------------------------

def edgecover_candidates(
    user_features,
    user_classes,
    num_rbs=TOTAL_RBS,
    max_users_per_rb=MAX_USERS_PER_RB,
):
    """
    Generate user-to-RB candidate assignments.

    The score combines RBF state similarity and the configured
    traffic priority. The function greedily assigns one RB per
    user subject to a per-RB occupancy limit.

    This is a candidate selector, not a learned DDQN policy.
    Replace/calibrate its scoring rule using the real simulator.
    """
    user_features = np.asarray(
        user_features,
        dtype=np.float32,
    )

    user_classes = np.asarray(user_classes)

    if user_features.ndim != 2:
        raise ValueError("user_features must be a 2D array.")

    n_users = len(user_features)

    if len(user_classes) != n_users:
        raise ValueError(
            "Each user must have one traffic-class label."
        )

    if num_rbs <= 0 or max_users_per_rb <= 0:
        raise ValueError("RB count and RB capacity must be positive.")

    unknown_classes = set(user_classes) - set(TRAFFIC_NAMES)
    if unknown_classes:
        raise ValueError(
            f"Unknown traffic classes: {unknown_classes}"
        )

    rbf_features = rbf_transform(user_features)

    # Similarity score for each user.
    similarity = rbf_features.mean(axis=1)

    priorities = np.asarray([
        TRAFFIC_PROFILES[class_name]["priority"]
        for class_name in user_classes
    ], dtype=np.float32)

    priority_norm = priorities / max(
        max(p["priority"] for p in TRAFFIC_PROFILES.values()),
        1.0,
    )

    user_scores = 0.5 * similarity + 0.5 * priority_norm

    # Higher-priority/high-score users are considered first.
    processing_order = np.argsort(-user_scores)

    rb_occupancy = np.zeros(num_rbs, dtype=np.int32)
    assignments = np.full(n_users, -1, dtype=np.int32)

    # Deterministic tie-breaking via a rotating RB preference.
    for user_index in processing_order:
        start_rb = int(user_index % num_rbs)

        candidate_rbs = (
            np.arange(num_rbs) + start_rb
        ) % num_rbs

        # Prefer the least occupied eligible RB.
        eligible = candidate_rbs[
            rb_occupancy[candidate_rbs] < max_users_per_rb
        ]

        if len(eligible) == 0:
            continue

        chosen_rb = eligible[
