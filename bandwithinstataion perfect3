# BLOCK 12: SHARED RAN SLICING ENVIRONMENT AND KPI EVALUATION
# ============================================================

import numpy as np
import pandas as pd

class RANSlicingEnvironment:
    """
    Dataset-driven RAN resource-allocation environment.

    Each action is an integer PRB allocation per user.
    The environment enforces the total PRB budget and calculates
    model-based rate, latency, utility, acceptance and QoS metrics.

    These KPI equations are experimental proxies, not direct
    Py5cheSim measurements or calibrated propagation models.
    """

    def __init__(self, total_rbs=TOTAL_RBS,
                 total_bandwidth_mhz=TOTAL_BANDWIDTH_MHZ):
        self.total_rbs = int(total_rbs)
        self.total_bandwidth_mhz = float(total_bandwidth_mhz)
        self.bandwidth_per_rb = (
            self.total_bandwidth_mhz / self.total_rbs
        )

    def project_allocation(self, proposed_rbs, workload):
        """Project a proposed allocation onto the PRB budget."""
        n = len(workload["class_names"])
        allocation = np.asarray(proposed_rbs, dtype=np.float64)

        if allocation.shape != (n,):
            raise ValueError(
                f"Expected {n} per-user allocations; "
                f"received shape {allocation.shape}."
            )

        allocation = np.nan_to_num(
            allocation, nan=0.0, posinf=0.0, neginf=0.0
        )
        allocation = np.maximum(np.rint(allocation), 0).astype(int)

        # Cap every user's allocation before enforcing the global budget.
        allocation = np.minimum(allocation, self.total_rbs)

        # Deterministic priority-based budget projection.
        # Higher-priority users receive PRBs first; ties are stable.
        priorities = np.asarray(workload["priority"])
        order = np.argsort(-priorities, kind="stable")

        projected = np.zeros(n, dtype=int)
        remaining = self.total_rbs

        for i in order:
            if remaining <= 0:
                break
            granted = min(int(allocation[i]), remaining)
            projected[i] = granted
            remaining -= granted

        return projected

    def evaluate(self, workload, proposed_rbs):
        """Return projected allocation, per-user KPIs and aggregate KPIs."""
        rb_alloc = self.project_allocation(proposed_rbs, workload)

        demand = np.asarray(workload["demand_mbps"], dtype=float)
        min_rate = np.asarray(workload["min_rate_mbps"], dtype=float)
        max_latency = np.asarray(workload["max_latency_ms"], dtype=float)
        channel = np.asarray(workload["channel_factor"], dtype=float)
        class_names = np.asarray(workload["class_names"], dtype=object)
        priority = np.asarray(workload["priority"], dtype=float)

        # Assumed spectral-efficiency proxy. Calibrate against actual
        # SINR/MCS data before interpreting these rates as physical KPIs.
        spectral_efficiency = np.clip(
            0.5 + 2.0 * channel, 0.5, 4.0
        )

        rate_mbps = (
            rb_alloc
            * self.bandwidth_per_rb
            * spectral_efficiency
        )

        rate_satisfaction = np.clip(
            rate_mbps / np.maximum(demand, 1e-9), 0.0, 1.0
        )

        # Model-based latency proxy: base delay plus load-related delay.
        # This is not a packet-level delay measurement.
        latency_ms = (
            0.5
            + 2.0 * np.maximum(demand - rate_mbps, 0.0)
              / np.maximum(demand, 1e-9)
            + 0.1 * demand / np.maximum(rate_mbps, 0.05)
        )

        served = rb_alloc > 0
        rate_met = rate_mbps >= min_rate
        latency_met = latency_ms <= max_latency

        user_satisfied = served & rate_met & latency_met
        qos_violation = ~(rate_met & latency_met)

        # Demand-weighted utility with priority weighting.
        normalized_priority = priority / max(
            float(np.max(priority)), 1.0
        )
        utility_per_user = (
            rate_satisfaction * (0.5 + 0.5 * normalized_priority)
        )

        metrics = {
            "acceptance_ratio": float(np.mean(served)),
            "utility": float(np.mean(utility_per_user)),
            "service_satisfaction_ratio": float(np.mean(user_satisfied)),
            "qos_violation_ratio": float(np.mean(qos_violation)),
            "mean_data_rate_mbps": float(np.mean(rate_mbps)),
            "mean_latency_ms": float(np.mean(latency_ms)),
            "total_data_rate_mbps": float(np.sum(rate_mbps)),
            "allocated_rbs": int(np.sum(rb_alloc)),
            "rb_utilization": float(np.sum(rb_alloc) / self.total_rbs),
            "mean_user_rate_satisfaction": float(np.mean(rate_satisfaction)),
        }

        user_df = pd.DataFrame({
            "traffic_class": class_names,
            "priority": priority,
            "allocated_rbs": rb_alloc,
            "target_rate_mbps": demand,
            "minimum_rate_mbps": min_rate,
            "estimated_rate_mbps": rate_mbps,
            "estimated_latency_ms": latency_ms,
            "rate_satisfaction": rate_satisfaction,
            "accepted": served,
            "satisfied": user_satisfied,
            "qos_violation": qos_violation,
            "utility": utility_per_user,
        })

        # Per-class summaries for analysis.
        class_rows = []
        for traffic_class in TRAFFIC_NAMES:
            mask = class_names == traffic_class
            if not np.any(mask):
                continue

            class_rows.append({
                "traffic_class": traffic_class,
                "users": int(np.sum(mask)),
                "mean_rbs_per_user": float(np.mean(rb_alloc[mask])),
                "mean_rate_mbps": float(np.mean(rate_mbps[mask])),
                "mean_latency_ms": float(np.mean(latency_ms[mask])),
                "acceptance_ratio": float(np.mean(served[mask])),
                "satisfaction_ratio": float(np.mean(user_satisfied[mask])),
                "qos_violation_ratio": float(np.mean(qos_violation[mask])),
            })

        class_df = pd.DataFrame(class_rows)

        return {
            "metrics": metrics,
            "users": user_df,
            "classes": class_df,
            "allocation": rb_alloc,
        }


