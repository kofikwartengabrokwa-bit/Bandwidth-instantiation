        rb_occupancy[chosen_rb] += 1

    accepted = assignments >= 0

    return {
        "assignments": assignments,
        "accepted": accepted,
        "acceptance_ratio": float(accepted.mean()),
        "rb_occupancy": rb_occupancy,
        "rbf_features": rbf_features,
