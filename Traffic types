        )

        print(
            f"Traffic type {traffic_type} | "
            f"Demand: {user['demand_mbps']:.3f} Mbps | "
            f"Latency limit: {user['latency_limit_ms']:.1f} ms | "
            f"Channel: {user['channel_quality']:.3f} | "
            f"State shape: {state.shape}"
        )

        assert state.shape == (12,)
        assert np.isfinite(state).all()

    print("\nSimulated-user verification passed.")


