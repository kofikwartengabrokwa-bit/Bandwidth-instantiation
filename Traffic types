EVALUATION_USER_COUNTS = [100, 200, 400, 600, 800, 1000]
EVALUATION_TRAFFIC_TYPES = [1, 2, 3]


# ------------------------------------------------------------
# 11.2: Calculate distinct physical-layer metrics
# ------------------------------------------------------------

def calculate_simulated_data_rate_mbps(
    allocated_rbs,
    channel_quality,
    allocated_power,
):
    """
    Estimate achievable physical-layer data rate in Mbps.

    This is a simulation-derived estimate, not a measured
    dataset value.

    The spectral-efficiency function is an explicit simplified
    simulation assumption and should be calibrated against the
    physical-layer model used in the research.
    """

    allocated_rbs = max(0, int(allocated_rbs))
    channel_quality = float(np.clip(channel_quality, 0.0, 1.0))
    allocated_power = max(0.0, float(allocated_power))

    if allocated_rbs == 0 or allocated_power <= 0:
        return 0.0

    # Assumed bandwidth per RB, based on the configured total.
    bandwidth_per_rb_mhz = (
        TOTAL_BANDWIDTH_MHZ / TOTAL_RBS
    )

    allocated_bandwidth_mhz = (
        allocated_rbs * bandwidth_per_rb_mhz
    )

    # Simplified channel-dependent spectral efficiency.
    # Replace this with a validated link-adaptation model
    # if one is available in your simulator.
    spectral_efficiency_bps_hz = (
        0.5 + 4.5 * channel_quality
    )

    # Approximate power-dependent transmission factor.
    power_factor = min(
        np.sqrt(allocated_power / 4.0),
        2.0
    )

    data_rate_mbps = (
        allocated_bandwidth_mhz
        * spectral_efficiency_bps_hz
        * power_factor
    )

    return max(0.0, float(data_rate_mbps))


def calculate_simulated_throughput_mbps(
    data_rate_mbps,
    packet_loss_factor,
    allocation_succeeded,
):
    """
    Estimate delivered throughput in Mbps.

    Throughput is lower than or equal to the achievable data
    rate because it accounts for packet loss and failed allocation.

    packet_loss_factor is expected to be normalized to [0, 1].
    """

    if not allocation_succeeded:
        return 0.0

    data_rate_mbps = max(0.0, float(data_rate_mbps))

    packet_loss_factor = float(
        np.clip(packet_loss_factor, 0.0, 1.0)
    )

    delivery_fraction = 1.0 - packet_loss_factor

    throughput_mbps = (
        data_rate_mbps * delivery_fraction
    )

    return max(0.0, float(throughput_mbps))


# ------------------------------------------------------------
# 11.3: Evaluate one scenario
# ------------------------------------------------------------

def evaluate_one_scenario(agent, scenarios, environment):

    environment.reset()

    total_reward = 0.0
    total_data_rate_mbps = 0.0
    total_throughput_mbps = 0.0
    total_latency_ms = 0.0

    successful_allocations = 0
    qos_satisfied = 0
    total_allocated_rbs = 0
    total_allocated_power = 0.0

    number_of_users = len(scenarios)

    if number_of_users == 0:
        raise ValueError("Cannot evaluate an empty scenario.")

    for user in scenarios:

        state = build_simulation_state(user, environment)

        # Greedy policy evaluation without exploration.
        action = agent.select_action(
            state,
            evaluate=True
        )

        allocation = environment.allocate(
            action=action,
            channel_quality=user["channel_quality"]
        )

        allocated = bool(allocation["allocated"])

        allocated_rbs = int(
            allocation.get("allocated_rbs", 0)
        )

        allocated_power = float(
            allocation.get("allocated_power", 0.0)
        )

        # ----------------------------------------------------
        # Distinct metric 1: achievable data rate
        # ----------------------------------------------------

        data_rate_mbps = calculate_simulated_data_rate_mbps(
            allocated_rbs=allocated_rbs,
            channel_quality=user["channel_quality"],
            allocated_power=allocated_power,
        )

        # ----------------------------------------------------
        # Distinct metric 2: delivered throughput
        # ----------------------------------------------------

        throughput_mbps = calculate_simulated_throughput_mbps(
            data_rate_mbps=data_rate_mbps,
            packet_loss_factor=user["packet_loss_factor"],
            allocation_succeeded=allocated,
        )

        latency_ms = estimate_simulated_latency_ms(
            user=user,
            allocation=allocation
        )

        reward = calculate_reward(
            throughput_mbps=throughput_mbps,
            demand_mbps=user["demand_mbps"],
            allocated_rbs=allocated_rbs,
            allocated_power=allocated_power,
            latency=latency_ms,
            latency_limit=user["latency_limit_ms"],
            allocation_succeeded=allocated,
        )

        total_reward += float(reward)
        total_data_rate_mbps += data_rate_mbps
        total_throughput_mbps += throughput_mbps
        total_latency_ms += latency_ms

        successful_allocations += int(allocated)
        total_allocated_rbs += allocated_rbs
        total_allocated_power += allocated_power

        if (
            allocated
            and throughput_mbps >= user["demand_mbps"]
            and latency_ms <= user["latency_limit_ms"]
        ):
            qos_satisfied += 1

    return {
        "mean_reward": total_reward / number_of_users,

        # Achievable physical-layer rate per user.
        "data_rate_mbps": (
            total_data_rate_mbps / number_of_users
        ),

        # Delivered throughput per user after packet-loss effects.
        "throughput_mbps": (
            total_throughput_mbps / number_of_users
        ),

        "mean_latency_ms": (
            total_latency_ms / number_of_users
        ),

        "allocation_success_rate": (
            successful_allocations / number_of_users
        ),

        "qos_satisfaction_rate": (
            qos_satisfied / number_of_users
        ),

        "mean_allocated_rbs": (
            total_allocated_rbs / number_of_users
        ),

        "mean_allocated_power": (
            total_allocated_power / number_of_users
        ),
    }


