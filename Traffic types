def normalize_column_name(name):
    """Normalize a column name for matching only."""
    return (
        str(name)
        .strip()
        .lower()
        .replace(" ", "_")
        .replace("-", "_")
    )


def find_traffic_column(columns):
    """Find a recognized traffic-type column without renaming it."""
    normalized = {
        normalize_column_name(col): col
        for col in columns
    }

    if TRAFFIC_TYPE_COLUMN is not None:
        requested = normalize_column_name(TRAFFIC_TYPE_COLUMN)

        if requested in normalized:
            return normalized[requested]

        raise KeyError(
            f"Configured traffic-type column "
            f"'{TRAFFIC_TYPE_COLUMN}' was not found. "
            f"Available columns: {list(columns)}"
        )

    candidates = [
        "traffic_type",
        "traffic_type_id",
        "traffictype",
        "traffic_class",
        "traffic_class_id",
        "type_of_traffic",
    ]

    for candidate in candidates:
        if candidate in normalized:
            return normalized[candidate]

    return None


