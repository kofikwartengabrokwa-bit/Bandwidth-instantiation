import pandas as pd


# ------------------------------------------------------------
# 10.1: Training configuration
# ------------------------------------------------------------

TRAINING_EPISODES = max(1, int(NUM_EPISODES))
TRAINING_USER_LOADS = list(USER_LOADS_TRAIN)

TRAINING_RESULT_DIR = RESULT_DIR / "block10_training"
TRAINING_CSV_DIR = TRAINING_RESULT_DIR / "csv"
TRAINING_CHECKPOINT_DIR = TRAINING_RESULT_DIR / "checkpoints"

TRAINING_CSV_DIR.mkdir(parents=True, exist_ok=True)
TRAINING_CHECKPOINT_DIR.mkdir(parents=True, exist_ok=True)


# ------------------------------------------------------------
# 10.2: Generate common scenarios for fair model comparison
# ------------------------------------------------------------

def generate_training_scenarios(
    number_of_users,
    traffic_type,
    seed
):
    """
    Generate a fixed scenario shared by all four models.

    Dataset throughput measurements are never used here.
    """

    rng = np.random.default_rng(seed)

    return [
        create_simulated_user(
            traffic_type=traffic_type,
            rng=rng
        )
        for _ in range(number_of_users)
    ]


# ------------------------------------------------------------
# 10.3: Run one training episode
# ------------------------------------------------------------

def train_one_episode(agent, scenarios, environment):
    environment.reset()

    episode_reward = 0.0
    episode_losses = []
    successful_allocations = 0

    for index, user in enumerate(scenarios):

        state = build_simulation_state(user, environment)

        # Training uses epsilon-greedy exploration.
        action = agent.select_action(state, evaluate=False)

        allocation = environment.allocate(
            action=action,
            channel_quality=user["channel_quality"]
        )

        allocated = bool(allocation["allocated"])

        throughput_mbps = float(
            allocation.get("throughput_mbps", 0.0)
        )

        allocated_rbs = int(
            allocation.get("allocated_rbs", 0)
        )

        allocated_power = float(
            allocation.get("allocated_power", 0.0)
        )

        latency_ms = estimate_simulated_latency_ms(
            user=user,
            allocation=allocation
        )

        reward = calculate_reward(
            throughput_mbps=throughput_mbps,
            demand_mbps=user["demand_mbps"],
            allocated_rbs=allocated_rbs,
            allocated_power=allocated_power,
            latency=latency_ms,
            latency_limit=user["latency_limit_ms"],
            allocation_succeeded=allocated
        )

        episode_reward += float(reward)
        successful_allocations += int(allocated)

        # Construct the next state after resource allocation.
        done = index == len(scenarios) - 1

        if not done:
            next_state = build_simulation_state(
                user=scenarios[index + 1],
                environment=environment
            )
        else:
            next_state = np.zeros(STATE_DIM, dtype=np.float32)

        agent.remember(
            state,
            int(action),
            float(reward),
            next_state,
            bool(done)
        )

        loss = agent.learn()

        if loss is not None:
            episode_losses.append(float(loss))

    agent.decay_epsilon()

    return {
        "episode_reward": episode_reward,
        "mean_loss": (
            float(np.mean(episode_losses))
            if episode_losses else np.nan
        ),
        "successful_allocations": successful_allocations,
        "number_of_users": len(scenarios),
        "success_rate": (
            successful_allocations / len(scenarios)
            if scenarios else 0.0
        ),
        "epsilon": float(agent.epsilon),
    }


# ------------------------------------------------------------
# 10.4: Train one model across traffic types and user loads
# ------------------------------------------------------------

def train_agent(agent, model_name, episodes=TRAINING_EPISODES):

    history = []
    environment = ORANEnvironment()

    for episode in range(1, episodes + 1):

        for traffic_type in EVALUATION_TRAFFIC_TYPES:

            for number_of_users in TRAINING_USER_LOADS:

                # Identical seed means identical generated scenarios
                # for the corresponding model, episode, traffic type,
                # and user load.
                scenario_seed = (
                    int(SEED)
                    + episode * 100_000
                    + traffic_type * 10_000
                    + number_of_users
                )

                scenarios = generate_training_scenarios(
                    number_of_users=number_of_users,
                    traffic_type=traffic_type,
                    seed=scenario_seed
                )

                result = train_one_episode(
                    agent=agent,
                    scenarios=scenarios,
                    environment=environment
                )

                history.append({
                    "model": model_name,
                    "episode": episode,
                    "traffic_type": traffic_type,
                    "number_of_users": number_of_users,
                    **result
                })

        if episode == 1 or episode % 10 == 0 or episode == episodes:
            episode_rows = [
                row for row in history
                if row["episode"] == episode
            ]

            mean_reward = np.mean([
                row["episode_reward"] for row in episode_rows
            ])

            print(
                f"{model_name} | Episode {episode}/{episodes} | "
                f"Mean reward: {mean_reward:.4f} | "
                f"Epsilon: {agent.epsilon:.4f}"
            )

    return pd.DataFrame(history)


# ------------------------------------------------------------
# 10.5: Initialize and train the four models
# ------------------------------------------------------------

def run_block10_training():

    all_histories = []

    for model_index, model_name in enumerate(MODELS):

        print("\n" + "=" * 72)
