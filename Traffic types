import torch
import torch.nn as nn
import torch.nn.functional as F


# ------------------------------------------------------------
# 3.1: Radial Basis Function (RBF) Q-Network
# ------------------------------------------------------------

class RBFQNetwork(nn.Module):
    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        num_centers=RBF_CENTERS,
        hidden_dim=HIDDEN_DIM
    ):
        super().__init__()

        self.register_buffer(
            "centers",
            torch.randn(num_centers, state_dim)
        )

        self.log_gamma = nn.Parameter(torch.tensor(4.0))

        self.fc1 = nn.Linear(num_centers, 128)
        self.fc2 = nn.Linear(128, hidden_dim)
        self.fc3 = nn.Linear(hidden_dim, num_actions)

    def forward(self, state):
        # Ensure state has shape [batch_size, state_dim].
        if state.dim() == 1:
            state = state.unsqueeze(0)

        # Calculate squared distance to each RBF center.
        distances = torch.sum(
            (state.unsqueeze(1) - self.centers.unsqueeze(0)) ** 2,
            dim=2
        )

        # Positive gamma keeps the RBF width parameter valid.
        gamma = F.softplus(self.log_gamma) + 1e-8
        rbf_features = torch.exp(-gamma * distances)

        x = F.relu(self.fc1(rbf_features))
        x = F.relu(self.fc2(x))
        q_values = self.fc3(x)

        return q_values


# ------------------------------------------------------------
# 3.2: Conventional DDQN Q-Network
# ------------------------------------------------------------

class DDQNQNetwork(nn.Module):
    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS
    ):
        super().__init__()

        self.fc1 = nn.Linear(state_dim, 128)
        self.fc2 = nn.Linear(128, 128)
        self.fc3 = nn.Linear(128, 64)
        self.fc4 = nn.Linear(64, num_actions)

    def forward(self, state):
        if state.dim() == 1:
            state = state.unsqueeze(0)

        x = F.relu(self.fc1(state))
        x = F.relu(self.fc2(x))
        x = F.relu(self.fc3(x))

        return self.fc4(x)


# ------------------------------------------------------------
# 3.3: Graph Generative Network (GGN)-DDQN
# ------------------------------------------------------------

class GGNQNetwork(nn.Module):
    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM
    ):
        super().__init__()

        # Encode each state feature as a graph node.
        self.node_encoder = nn.Linear(1, hidden_dim)

        # Combine each node representation with its
        # aggregated neighboring-node representation.
        self.message_layer = nn.Linear(
            hidden_dim * 2,
            hidden_dim
        )

        self.q_head = nn.Sequential(
            nn.Linear(hidden_dim, 128),
            nn.ReLU(),
            nn.Linear(128, num_actions)
        )

        # A chain graph with self-connections.
        # This keeps the graph construction deterministic.
        adjacency = torch.eye(state_dim)

        for i in range(state_dim - 1):
            adjacency[i, i + 1] = 1.0
            adjacency[i + 1, i] = 1.0

        # Symmetric degree normalization.
        degree = adjacency.sum(dim=1).clamp(min=1.0)
        inv_sqrt_degree = degree.pow(-0.5)

        normalized_adjacency = (
            inv_sqrt_degree.unsqueeze(1)
            * adjacency
            * inv_sqrt_degree.unsqueeze(0)
        )

        self.register_buffer(
            "adjacency",
            normalized_adjacency
        )

    def forward(self, state):
        if state.dim() == 1:
            state = state.unsqueeze(0)

        # [batch_size, state_dim, 1]
        nodes = state.unsqueeze(-1)

        # [batch_size, state_dim, hidden_dim]
        embeddings = F.relu(self.node_encoder(nodes))

        # Aggregate neighboring node representations.
        neighbors = torch.matmul(
            self.adjacency,
            embeddings
        )

        # Message passing.
        updated = torch.cat(
            [embeddings, neighbors],
            dim=-1
        )

        updated = F.relu(self.message_layer(updated))

        # Graph-level representation.
        graph_embedding = updated.mean(dim=1)

        return self.q_head(graph_embedding)


# ------------------------------------------------------------
# 3.4: Graph Convolutional Network (GCN)-DDQN
# ------------------------------------------------------------

class GCNQNetwork(nn.Module):
    def __init__(
        self,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM
    ):
        super().__init__()

        self.input_projection = nn.Linear(1, hidden_dim)

        self.gcn1 = nn.Linear(hidden_dim, hidden_dim)
        self.gcn2 = nn.Linear(hidden_dim, hidden_dim)

        self.q_head = nn.Sequential(
            nn.Linear(hidden_dim, 128),
            nn.ReLU(),
            nn.Linear(128, num_actions)
        )

        # Construct the same normalized chain graph.
        adjacency = torch.eye(state_dim)

        for i in range(state_dim - 1):
            adjacency[i, i + 1] = 1.0
            adjacency[i + 1, i] = 1.0

        degree = adjacency.sum(dim=1).clamp(min=1.0)
        inv_sqrt_degree = degree.pow(-0.5)

        normalized_adjacency = (
            inv_sqrt_degree.unsqueeze(1)
            * adjacency
            * inv_sqrt_degree.unsqueeze(0)
        )

        self.register_buffer(
            "adjacency",
            normalized_adjacency
        )

    def forward(self, state):
        if state.dim() == 1:
            state = state.unsqueeze(0)

        # Convert each state feature into a node representation.
        nodes = state.unsqueeze(-1)
        x = F.relu(self.input_projection(nodes))

        # First graph convolution.
        x = torch.matmul(self.adjacency, x)
        x = F.relu(self.gcn1(x))

        # Second graph convolution.
        x = torch.matmul(self.adjacency, x)
        x = F.relu(self.gcn2(x))

        # Pool node representations into a graph embedding.
        graph_embedding = x.mean(dim=1)

        return self.q_head(graph_embedding)


# ------------------------------------------------------------
# 3.5: Model factory
# ------------------------------------------------------------

NETWORK_FACTORIES = {
    "RBF-DDQN": lambda: RBFQNetwork(),
    "DDQN": lambda: DDQNQNetwork(),
    "GGN-DDQN": lambda: GGNQNetwork(),
    "GCN-DDQN": lambda: GCNQNetwork(),
}


# ------------------------------------------------------------
# 3.6: Architecture verification
# ------------------------------------------------------------

def verify_network_architectures():
    print("\n" + "=" * 65)
    print("BLOCK 3: NEURAL NETWORK VERIFICATION")
    print("=" * 65)

    test_state = torch.zeros(1, STATE_DIM)

    for model_name, factory in NETWORK_FACTORIES.items():
        model = factory()
        model.eval()

        with torch.no_grad():
            q_values = model(test_state)

        assert q_values.shape == (1, NUM_ACTIONS), (
            f"{model_name}: expected output shape "
            f"(1, {NUM_ACTIONS}), got {tuple(q_values.shape)}"
        )

        parameter_count = sum(
            parameter.numel()
            for parameter in model.parameters()
        )

        print(
            f"{model_name:12s} | "
            f"Input: {STATE_DIM:2d} | "
            f"Actions: {NUM_ACTIONS:2d} | "
            f"Parameters: {parameter_count:,} | "
            f"Output: {tuple(q_values.shape)}"
        )

    print("\nAll four network architectures passed verification.")


if __name__ == "__main__":
    verify_network_architectures()

