def read_sqlite_tables(file_path):
    """Read tables from a SQLite database."""
    tables = []

    with sqlite3.connect(str(file_path)) as connection:
        table_names = pd.read_sql_query(
            """
            SELECT name
            FROM sqlite_master
            WHERE type = 'table'
              AND name NOT LIKE 'sqlite_%'
            ORDER BY name
            """,
            connection,
        )["name"].tolist()

        for table_name in table_names:
            if DATA_TABLE is not None and table_name != DATA_TABLE:
                continue

            # Quote table identifiers safely.
            escaped_name = table_name.replace('"', '""')

            try:
                frame = pd.read_sql_query(
                    f'SELECT * FROM "{escaped_name}"',
                    connection,
                )

                tables.append(
                    (table_name, frame)
                )

            except Exception as exc:
                print(
                    f"Could not read table '{table_name}': {exc}"
                )

    return tables


