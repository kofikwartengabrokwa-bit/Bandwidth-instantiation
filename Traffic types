# ------------------------------------------------------------
# 12.4: Plot one metric for one traffic type
# ------------------------------------------------------------

def plot_metric_for_traffic(
    summary_df,
    metric,
    traffic_type,
):
    mean_col = f"{metric}_mean"
    std_col = f"{metric}_std"

    required = {
        "model",
        "traffic_type",
        "number_of_users",
        mean_col,
        std_col,
    }

    if not required.issubset(summary_df.columns):
        raise ValueError(
            f"Missing plot columns: {sorted(required - set(summary_df.columns))}"
        )

    fig, ax = plt.subplots(figsize=(10, 6))

    traffic_df = summary_df[
        summary_df["traffic_type"] == traffic_type
    ]

    for model_name in MODEL_ORDER:
        model_df = traffic_df[
            traffic_df["model"] == model_name
        ].sort_values("number_of_users")

        if model_df.empty:
            print(
                f"Warning: no results for {model_name}, "
                f"traffic type {traffic_type}."
            )
            continue

        x = model_df["number_of_users"].to_numpy(dtype=float)
        y = model_df[mean_col].to_numpy(dtype=float)
        yerr = model_df[std_col].to_numpy(dtype=float)

        ax.errorbar(
            x,
            y,
            yerr=yerr,
            label=MODEL_LABELS[model_name],
            marker=MARKERS[model_name],
            linestyle=LINESTYLES[model_name],
            linewidth=2.0,
            markersize=7,
            capsize=4,
            elinewidth=1.2,
        )

    ax.set_xlabel("Number of Users", fontsize=23)
    #ax.set_ylabel(METRIC_LABELS[metric], fontsize=23)
    ax.set_ylabel(
        f"{METRIC_LABELS[metric]}- TP{traffic_type}",
        fontsize=26,
    )

    ax.set_xticks(PLOT_USER_COUNTS)
    ax.set_xlim(0, 1050)

    # Throughput and data rate cannot be negative.
    ax.set_ylim(bottom=0)

    ax.tick_params(axis="both", labelsize=20)
    ax.grid(True, linestyle="--", linewidth=0.6, alpha=0.6)
    #ax.legend(
    #    loc="lower center",
    #    bbox_to_anchor=(0.5, 1.02),
    #    fontsize=26,
    #    frameon=True,
    #    ncol=4,
    #)
    ax.legend(
        loc="best",
        fontsize=26,
        frameon=True,
        ncol=1,
    )

    fig.tight_layout()

    filename = f"{metric}_traffic_type_{traffic_type}"

    fig.savefig(
        PLOT_PNG_DIR / f"{filename}.png",
        dpi=600,
        bbox_inches="tight",
    )

    fig.savefig(
        PLOT_PDF_DIR / f"{filename}.pdf",
        bbox_inches="tight",
    )

    fig.savefig(
        PLOT_EPS_DIR / f"{filename}.eps",
        format="eps",
        dpi=600,
        bbox_inches="tight",
    )

    plt.show()
    plt.close(fig)

    print(f"Saved figures for {filename}")


