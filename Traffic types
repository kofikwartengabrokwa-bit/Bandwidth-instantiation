# ------------------------------------------------------------
# 8.2: Extract radio-environment profiles from the dataset
# ------------------------------------------------------------

def build_radio_environment_profiles(traffic_data):
    """
    Summarize the observed environment for traffic types 1, 2, and 3.

    The summary provides scenario characteristics for simulation.
    It does not supply the plotted performance measurements.
    """

    profiles = {}

    for traffic_type in EVALUATION_TRAFFIC_TYPES:
        if traffic_type not in traffic_data:
            raise KeyError(
                f"Traffic type {traffic_type} is missing from traffic_data."
            )

        frame = traffic_data[traffic_type].copy()

        missing = [
            col for col in RADIO_PROFILE_FEATURES
            if col not in frame.columns
        ]

        if missing:
            raise ValueError(
                f"Traffic type {traffic_type} is missing environment "
                f"features: {missing}"
            )

        numeric = frame[RADIO_PROFILE_FEATURES].apply(
            pd.to_numeric,
            errors="coerce"
        )

        profile = {}

        for column in RADIO_PROFILE_FEATURES:
            values = numeric[column].replace(
                [np.inf, -np.inf],
                np.nan
            ).dropna()

            if values.empty:
                raise ValueError(
                    f"Feature '{column}' contains no valid numeric values "
                    f"for traffic type {traffic_type}."
                )

            profile[column] = {
                "mean": float(values.mean()),
                "std": float(values.std(ddof=0)),
                "min": float(values.min()),
                "max": float(values.max()),
                "median": float(values.median()),
            }

        profiles[traffic_type] = profile

    return profiles


# ------------------------------------------------------------
# 8.3: Convert a profile into normalized environment factors
# ------------------------------------------------------------

def _minmax(value, minimum, maximum):
    span = maximum - minimum

    if span <= 1e-12:
        return 0.5

    return float(np.clip(
        (value - minimum) / span,
        0.0,
        100.0
    ))


def derive_traffic_environment_factors(profiles):
    """
    Derive bounded scenario factors from the observed environment.

    These factors characterize traffic scenarios; they do not
    reproduce the dataset's throughput measurements.
    """

    factors = {}

    for traffic_type, profile in profiles.items():
        utilization = profile["Network Utilization (%)"]["mean"]
        signal_dbm = profile["Signal Strength (dBm)"]["mean"]
        latency_ms = profile["Latency (ms)"]["mean"]
        loss_pct = profile["Packet Loss Rate (%)"]["mean"]
        traffic_load = profile["Traffic Load (bps)"]["mean"]

        # Convert measured signal strength to a bounded relative factor.
        # A higher dBm value means stronger received signal.
        signal_factor = _minmax(
            signal_dbm,
            -120.0,
            -50.0
        )

        utilization_factor = _minmax(
            utilization,
            0.0,
            100.0
        )

        loss_factor = _minmax(
            loss_pct,
            0.0,
            100.0
        )

        # Preserve latency as a scenario characteristic.
        # It is not used as measured simulation output.
        latency_factor = _minmax(
            latency_ms,
            0.0,
            max(
                profile["Latency (ms)"]["max"],
                1.0
            )
        )

        factors[traffic_type] = {
            "signal_quality": signal_factor,
            "background_load": utilization_factor,
            "packet_loss_factor": loss_factor,
            "latency_pressure": latency_factor,
            "mean_traffic_load_bps": traffic_load,
        }

    return factors


# ------------------------------------------------------------
# 8.4: Generate repeatable radio conditions
# ------------------------------------------------------------

def sample_radio_condition(
    traffic_type,
    environment_factors,
    rng
):
    """
    Sample a bounded channel condition for a simulated user.

    The channel-quality value is a normalized simulation variable,
    not an observed throughput measurement.
    """

    if traffic_type not in environment_factors:
        raise ValueError(
            f"Unknown traffic type: {traffic_type}"
        )

    factors = environment_factors[traffic_type]

    # The dataset-derived signal and load factors set the scenario
    # center. Random variation represents changing radio conditions.
    signal_center = factors["signal_quality"]
    background_load = factors["background_load"]

    channel_quality = rng.normal(
        loc=signal_center,
        scale=0.10
    )

    channel_quality = np.clip(
        channel_quality,
        0.05,
        10.0
    )

    return {
        "channel_quality": float(channel_quality),
        "background_load": float(background_load),
        "packet_loss_factor": float(
            factors["packet_loss_factor"]
        ),
        "latency_pressure": float(
            factors["latency_pressure"]
        ),
        "mean_traffic_load_bps": float(
            factors["mean_traffic_load_bps"]
        ),
    }


