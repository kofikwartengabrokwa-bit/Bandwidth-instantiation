import numpy as np


# ------------------------------------------------------------
# 9.1: Simulation traffic profiles
# ------------------------------------------------------------

# These are explicit simulation assumptions, not measurements
# extracted from the dataset. Adjust them only when justified
# by your experimental design.

SIMULATION_TRAFFIC_CONFIG = {
    1: {
        "name": "Traffic Type 1",
        "demand_mbps": 2.0,
        "latency_limit_ms": 5.0,
        "demand_variation": 0.520,
    },
    2: {
        "name": "Traffic Type 2",
        "demand_mbps": 5.0,
        "latency_limit_ms": 2.0,
        "demand_variation": 0.20,
    },
    3: {
        "name": "Traffic Type 3",
        "demand_mbps": 10.0,
        "latency_limit_ms": 1.0,
        "demand_variation": 0.720,
    },
}


# ------------------------------------------------------------
# 9.2: Create a simulated user
# ------------------------------------------------------------

def create_simulated_user(
    traffic_type,
    rng,
    environment_factors=TRAFFIC_ENVIRONMENT_FACTORS
):
    if traffic_type not in SIMULATION_TRAFFIC_CONFIG:
        raise ValueError(
            f"Unsupported traffic type: {traffic_type}"
        )

    config = SIMULATION_TRAFFIC_CONFIG[traffic_type]

    radio = sample_radio_condition(
        traffic_type=traffic_type,
        environment_factors=environment_factors,
        rng=rng
    )

    demand = config["demand_mbps"] * rng.uniform(
        1.0 - config["demand_variation"],
        1.0 + config["demand_variation"]
    )

    return {
        "traffic_type": traffic_type,
        "channel_quality": radio["channel_quality"],
        "background_load": radio["background_load"],
        "packet_loss_factor": radio["packet_loss_factor"],
        "latency_pressure": radio["latency_pressure"],
        "demand_mbps": float(demand),
        "latency_limit_ms": config["latency_limit_ms"],
    }


# ------------------------------------------------------------
# 9.3: Build a 12-dimensional state for Block 3 networks
# ------------------------------------------------------------

def build_simulation_state(user, environment):
    """
    State layout:
      0: traffic-type indicator for type 1
      1: traffic-type indicator for type 2
      2: traffic-type indicator for type 3
      3: simulated channel quality
      4: normalized demand
      5: normalized latency limit
      6: normalized background load
      7: normalized packet-loss factor
      8: normalized latency pressure
      9: remaining RB fraction
     10: remaining power fraction
     11: remaining bandwidth fraction
    """

    traffic_type = user["traffic_type"]

    traffic_one_hot = np.zeros(3, dtype=np.float32)
    traffic_one_hot[traffic_type - 1] = 1.0

    demand_norm = np.clip(
        user["demand_mbps"] / 10.0,
        0.0,
        100.0
    )

    latency_limit_norm = np.clip(
        user["latency_limit_ms"] / 50.0,
        0.0,
        1.0
    )

    state = np.array(
        [
            *traffic_one_hot,
            user["channel_quality"],
            demand_norm,
            latency_limit_norm,
            user["background_load"],
            user["packet_loss_factor"],
            user["latency_pressure"],
            environment.remaining_rbs / environment.total_rbs,
            environment.remaining_power / environment.total_power_budget,
            environment.remaining_rbs / environment.total_rbs,
        ],
        dtype=np.float32
    )

    if state.shape != (STATE_DIM,):
        raise ValueError(
            f"Expected state shape ({STATE_DIM},), got {state.shape}. "
            "Set STATE_DIM = 12 in Block 1."
        )

    if not np.isfinite(state).all():
        raise ValueError("State contains NaN or infinity.")

    return state


# ------------------------------------------------------------
# 9.4: Simulate latency for one allocation decision
# ------------------------------------------------------------

def estimate_simulated_latency_ms(user, allocation):
    """
    Simulated latency model for experiment comparison.
    This is not measured latency from the dataset.
    """

    if not allocation["allocated"]:
        return float(user["latency_limit_ms"] * 2.0)

    rb_fraction = (
        allocation["allocated_rbs"] / max(TOTAL_RBS, 1)
    )

    channel_quality = max(
        user["channel_quality"],
        0.05
    )

    base_latency_ms = (
        2.0
        + 8.0 * user["background_load"]
        + 5.0 * user["packet_loss_factor"]
        + 5.0 * user["latency_pressure"]
    )

    resource_delay_ms = (
        3.0 * (1.0 / channel_quality)
        + 10.0 * (1.0 - rb_fraction)
    )

    return float(
        max(0.1, base_latency_ms + resource_delay_ms)
    )


# ------------------------------------------------------------
# 9.5: Verify state and traffic profiles
# ------------------------------------------------------------

def verify_simulated_users():
    print("\n" + "=" * 72)
    print("BLOCK 9: SIMULATED USER AND STATE VERIFICATION")
    print("=" * 72)

    rng = np.random.default_rng(SIMULATION_SEED)

    for traffic_type in EVALUATION_TRAFFIC_TYPES:
        environment = ORANEnvironment()
        environment.reset()

        user = create_simulated_user(
