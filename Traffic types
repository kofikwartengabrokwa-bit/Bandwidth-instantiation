                f"{checkpoint_path}\n"
                "Run Block 10 successfully before Block 11."
            )

        print(f"\nEvaluating {model_name}...")

        agent = DDQNAgent(model_name=model_name)
        agent.load_checkpoint(str(checkpoint_path))
        agent.epsilon = 0.0

        model_results = evaluate_agent(
            agent=agent,
            model_name=model_name
        )

        model_csv = (
            EVALUATION_CSV_DIR
            / f"{model_name}_evaluation.csv"
        )

        model_results.to_csv(model_csv, index=False)
        all_results.append(model_results)

        print(f"Saved: {model_csv}")

    combined_results = pd.concat(
        all_results,
        ignore_index=True
    )

    combined_csv = (
        EVALUATION_CSV_DIR / "all_models_evaluation.csv"
    )

    combined_results.to_csv(
        combined_csv,
        index=False
    )

    # Aggregate the five repeats.
    metric_columns = [
        "mean_reward",
        "data_rate_mbps",
        "throughput_mbps",
        "mean_latency_ms",
        "allocation_success_rate",
        "qos_satisfaction_rate",
        "mean_allocated_rbs",
        "mean_allocated_power",
    ]

    summary = (
        combined_results
        .groupby(
            ["model", "traffic_type", "number_of_users"]
        )[metric_columns]
        .agg(["mean", "std"])
        .reset_index()
    )

    # Flatten the MultiIndex column names.
    summary.columns = [
        "_".join(
            str(part)
            for part in column
            if str(part) != ""
        )
        if isinstance(column, tuple)
        else str(column)
        for column in summary.columns
    ]

    # Replace undefined standard deviations for single observations.
    for metric in metric_columns:
        std_col = f"{metric}_std"

        if std_col in summary.columns:
            summary[std_col] = summary[std_col].fillna(0.0)

    summary_csv = (
        EVALUATION_CSV_DIR / "evaluation_summary.csv"
    )

    summary.to_csv(summary_csv, index=False)

    print("\nEvaluation completed.")
    print(f"Raw results: {combined_csv}")
    print(f"Summary:     {summary_csv}")

    return combined_results, summary


