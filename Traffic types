# ------------------------------------------------------------
# 7.1: Dataset feature definitions
# ------------------------------------------------------------

TRAFFIC_COLUMN = "Traffic Type"

STATE_FEATURES = [
    "Traffic Load (bps)",
    "Network Utilization (%)",
    "Latency (ms)",
    "Packet Loss Rate (%)",
    "Signal Strength (dBm)",
    "Bandwidth Utilization (%)",
    "QoS Metric (Throughput)",
    "Network Failure Count",
]

CATEGORICAL_FEATURES = [
    "Device Type",
    "Region",
    "Time of Day",
    "Weather Conditions",
]


# ------------------------------------------------------------
# 7.2: Validate dataset columns and values
# ------------------------------------------------------------

def validate_dataset_features(traffic_data):
    print("\n" + "=" * 72)
    print("BLOCK 7: DATASET FEATURE VALIDATION")
    print("=" * 72)

    for traffic_type in [1, 2, 3]:
        frame = traffic_data[traffic_type]

        missing_columns = [
            column for column in
            STATE_FEATURES + CATEGORICAL_FEATURES
            if column not in frame.columns
        ]

        if missing_columns:
            raise ValueError(
                f"Traffic type {traffic_type} is missing columns: "
                f"{missing_columns}"
            )

        print(
            f"Traffic type {traffic_type}: "
            f"{len(frame)} rows; all required columns exist."
        )

    print("\nNumeric feature summary for traffic type 1:")
    print(traffic_data[1][STATE_FEATURES].describe().to_string())


# ------------------------------------------------------------
# 7.3: Prepare numeric features using source-dataset statistics
# ------------------------------------------------------------

def prepare_feature_scaling(traffic_data):
    """
    Fit scaling statistics on the combined available records
    from traffic types 1, 2, and 3.

    This uses the actual dataset values. Scaling statistics are
    shared across traffic types so that their states are comparable.
    """

    combined = pd.concat(
        [traffic_data[t] for t in [1, 2, 3]],
        ignore_index=True
    )

    numeric = combined[STATE_FEATURES].apply(
        pd.to_numeric,
        errors="coerce"
    )

    medians = numeric.median().fillna(0.0)
    numeric = numeric.fillna(medians)

    means = numeric.mean()
    stds = numeric.std(ddof=0).replace(0.0, 1.0)

    return {
        "medians": medians,
        "means": means,
        "stds": stds,
    }


# ------------------------------------------------------------
# 7.4: Construct a 12-dimensional state
# ------------------------------------------------------------

def build_state_from_record(record, scaling):
    """
    State layout:
       0-7: standardized numeric dataset features
       8-11: one-hot traffic-type indicators for types 0-3

    The traffic-type indicator is derived from the dataset's
    original 'Traffic Type' column.
    """

    numeric_values = pd.to_numeric(
        record[STATE_FEATURES],
        errors="coerce"
    )

    numeric_values = numeric_values.fillna(
        scaling["medians"]
    )

    standardized = (
        numeric_values - scaling["means"]
    ) / scaling["stds"]

    standardized = np.clip(
        standardized.to_numpy(dtype=np.float32),
        -5.0,
        5.0
    )

    traffic_type = int(record[TRAFFIC_COLUMN])

    if traffic_type not in [0, 1, 2, 3]:
        raise ValueError(
            f"Unexpected traffic type: {traffic_type}"
        )

    traffic_one_hot = np.zeros(4, dtype=np.float32)
    traffic_one_hot[traffic_type] = 1.0

    state = np.concatenate(
        [standardized, traffic_one_hot]
    ).astype(np.float32)

    if state.shape != (STATE_DIM,):
        raise ValueError(
            f"Expected state shape ({STATE_DIM},), "
            f"received {state.shape}. Check Block 1 STATE_DIM."
        )

    if not np.isfinite(state).all():
        raise ValueError("Constructed state contains NaN or infinity.")

    return state


# ------------------------------------------------------------
# 7.5: Verify feature scaling and state construction
# ------------------------------------------------------------

def verify_state_construction(traffic_data):
    validate_dataset_features(traffic_data)

    scaling = prepare_feature_scaling(traffic_data)

    print("\nState-construction tests:")

    for traffic_type in [1, 2, 3]:
        record = traffic_data[traffic_type].iloc[0]

        state = build_state_from_record(record, scaling)

        print(
            f"Traffic type {traffic_type}: "
            f"state shape={state.shape}, "
            f"finite={np.isfinite(state).all()}"
        )

    print("\nState construction verified.")

    return scaling


