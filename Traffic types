import numpy as np


# ------------------------------------------------------------
# 5.1: Environment configuration
# ------------------------------------------------------------

class ORANEnvironment:
    def __init__(
        self,
        total_rbs=TOTAL_RBS,
        total_bandwidth_mhz=TOTAL_BANDWIDTH_MHZ,
        total_power_budget=TOTAL_POWER_BUDGET,
        slot_seconds=SLOT_SECONDS
    ):
        self.total_rbs = total_rbs
        self.total_bandwidth_mhz = total_bandwidth_mhz
        self.total_power_budget = total_power_budget
        self.slot_seconds = slot_seconds

        self.remaining_rbs = total_rbs
        self.remaining_power = total_power_budget

        self.allocated_rbs = 0
        self.allocated_power = 0.0

    def reset(self):
        self.remaining_rbs = self.total_rbs
        self.remaining_power = self.total_power_budget

        self.allocated_rbs = 0
        self.allocated_power = 0.0

    # --------------------------------------------------------
    # Convert a discrete action into RB and power allocations
    # --------------------------------------------------------
    def decode_action(self, action):
        if not 0 <= int(action) < len(ACTIONS):
            raise ValueError(
                f"Action {action} is outside the valid action range."
            )

        requested_rbs, requested_power = ACTIONS[int(action)]

        return int(requested_rbs), float(requested_power)

    # --------------------------------------------------------
    # Allocate available radio resources
    # --------------------------------------------------------
    def allocate(self, action, channel_quality):
        requested_rbs, requested_power = self.decode_action(action)

        # Reject an allocation that exceeds available resources.
        if (
            requested_rbs > self.remaining_rbs
            or requested_power > self.remaining_power
        ):
            return {
                "allocated": False,
                "allocated_rbs": 0,
                "allocated_power": 0.0,
                "throughput_mbps": 0.0,
                "bandwidth_mhz": 0.0,
            }

        # Allocate the requested RBs and power.
        self.remaining_rbs -= requested_rbs
        self.remaining_power -= requested_power

        self.allocated_rbs += requested_rbs
        self.allocated_power += requested_power

        bandwidth_mhz = (
            self.total_bandwidth_mhz
            * requested_rbs
            / self.total_rbs
        )

        # Preserve the channel-quality throughput formulation
        # from the earlier simulation.
        channel_quality = float(
            np.clip(channel_quality, 2.0, 10.0)
        )

        spectral_efficiency = 0.5 + 4.5 * channel_quality

        power_factor = min(
            np.sqrt(max(requested_power, 0.0) / 4.0),
            2.0
        )

        throughput_mbps = (
            bandwidth_mhz
            * spectral_efficiency
            * power_factor
        )

        return {
            "allocated": True,
            "allocated_rbs": requested_rbs,
            "allocated_power": requested_power,
            "throughput_mbps": float(throughput_mbps),
            "bandwidth_mhz": float(bandwidth_mhz),
        }


# ------------------------------------------------------------
# 5.2: Reward function
# ------------------------------------------------------------

def calculate_reward(
    throughput_mbps,
    demand_mbps,
    allocated_rbs,
    allocated_power,
    latency,
    latency_limit,
    allocation_succeeded
):
    """
    Calculate the reward for one allocation decision.

    The reward preserves the earlier structure:
        2 * normalized throughput
        - 0.25 * normalized RB usage
        - 0.20 * normalized power usage
        - 0.50 * latency violation
    """

    demand_mbps = max(float(demand_mbps), 1e-8)
    latency_limit = max(float(latency_limit), 1e-8)

    throughput_score = min(
        float(throughput_mbps) / demand_mbps,
        1.0
    )

    rb_cost = float(allocated_rbs) / max(TOTAL_RBS, 1)

    power_cost = (
        float(allocated_power)
        / max(TOTAL_POWER_BUDGET, 1e-8)
    )

    latency_violation = float(
        float(latency) > float(latency_limit)
    )

    reward = (
        2.0 * throughput_score
        - 0.25 * rb_cost
        - 0.20 * power_cost
        - 0.50 * latency_violation
    )

    # Failed allocations receive no throughput reward.
    if not allocation_succeeded:
        reward = -0.5

    return float(reward)


# ------------------------------------------------------------
# 5.3: Environment smoke test
# ------------------------------------------------------------

def verify_environment():
    print("\n" + "=" * 65)
    print("BLOCK 5: ENVIRONMENT VERIFICATION")
    print("=" * 65)

    env = ORANEnvironment()
    env.reset()

    test_action = 0
    test_channel_quality = 0.8

    result = env.allocate(
        action=test_action,
        channel_quality=test_channel_quality
    )

    print("Test allocation:", result)
    print("Remaining RBs:", env.remaining_rbs)
    print("Remaining power:", env.remaining_power)

    assert 0 <= env.remaining_rbs <= env.total_rbs
    assert 0 <= env.remaining_power <= env.total_power_budget

    if result["allocated"]:
        reward = calculate_reward(
            throughput_mbps=result["throughput_mbps"],
            demand_mbps=10.0,
            allocated_rbs=result["allocated_rbs"],
            allocated_power=result["allocated_power"],
            latency=5.0,
            latency_limit=10.0,
            allocation_succeeded=True
        )

        print(f"Test reward: {reward:.4f}")

    print("\nEnvironment verification completed.")


if __name__ == "__main__":
    verify_environment()

