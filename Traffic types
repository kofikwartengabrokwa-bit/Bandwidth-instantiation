import torch.optim as optim


# ------------------------------------------------------------
# 4.1: Experience Replay Buffer
# ------------------------------------------------------------

class ReplayBuffer:
    def __init__(self, capacity=REPLAY_BUFFER_SIZE):
        self.buffer = deque(maxlen=capacity)

    def push(
        self,
        state,
        action,
        reward,
        next_state,
        done
    ):
        self.buffer.append(
            (
                np.asarray(state, dtype=np.float32).copy(),
                int(action),
                float(reward),
                np.asarray(next_state, dtype=np.float32).copy(),
                float(done)
            )
        )

    def sample(self, batch_size):
        batch = random.sample(self.buffer, batch_size)

        states, actions, rewards, next_states, dones = zip(*batch)

        return (
            torch.as_tensor(
                np.asarray(states),
                dtype=torch.float32
            ),
            torch.as_tensor(
                actions,
                dtype=torch.long
            ),
            torch.as_tensor(
                rewards,
                dtype=torch.float32
            ),
            torch.as_tensor(
                np.asarray(next_states),
                dtype=torch.float32
            ),
            torch.as_tensor(
                dones,
                dtype=torch.float32
            )
        )

    def __len__(self):
        return len(self.buffer)


# ------------------------------------------------------------
# 4.2: DDQN Agent
# ------------------------------------------------------------

class DDQNAgent:
    def __init__(
        self,
        model_name,
        state_dim=STATE_DIM,
        num_actions=NUM_ACTIONS,
        learning_rate=LEARNING_RATE,
        gamma=GAMMA,
        batch_size=BATCH_SIZE,
        target_update_frequency=TARGET_UPDATE_FREQUENCY,
        epsilon_start=EPSILON_START,
        epsilon_end=EPSILON_END,
        epsilon_decay=EPSILON_DECAY,
        device=None
    ):
        if model_name not in NETWORK_FACTORIES:
            raise ValueError(
                f"Unknown model '{model_name}'. "
                f"Available models: {list(NETWORK_FACTORIES)}"
            )

        self.model_name = model_name
        self.state_dim = state_dim
        self.num_actions = num_actions
        self.gamma = gamma
        self.batch_size = batch_size
        self.target_update_frequency = target_update_frequency

        self.epsilon = epsilon_start
        self.epsilon_end = epsilon_end
        self.epsilon_decay = epsilon_decay

        self.device = torch.device(
            device or ("cuda" if torch.cuda.is_available() else "cpu")
        )

        # Online network and target network.
        self.online_network = NETWORK_FACTORIES[model_name]().to(
            self.device
        )
        self.target_network = NETWORK_FACTORIES[model_name]().to(
            self.device
        )

        self.target_network.load_state_dict(
            self.online_network.state_dict()
        )
        self.target_network.eval()

        self.optimizer = optim.Adam(
            self.online_network.parameters(),
            lr=learning_rate
        )

        self.loss_function = nn.SmoothL1Loss()
        self.replay_buffer = ReplayBuffer(
            capacity=REPLAY_BUFFER_SIZE
        )

        self.learn_steps = 0

    # --------------------------------------------------------
    # Select an action using epsilon-greedy exploration
    # --------------------------------------------------------
    def select_action(self, state, evaluate=False):
        if not evaluate and random.random() < self.epsilon:
            return random.randrange(self.num_actions)

        state_tensor = torch.as_tensor(
            np.asarray(state, dtype=np.float32),
            dtype=torch.float32,
            device=self.device
        ).unsqueeze(0)

        self.online_network.eval()

        with torch.no_grad():
            q_values = self.online_network(state_tensor)
            action = int(q_values.argmax(dim=1).item())

        self.online_network.train()

        return action

    # --------------------------------------------------------
    # Store one transition
    # --------------------------------------------------------
    def remember(
        self,
        state,
        action,
        reward,
        next_state,
        done
    ):
        self.replay_buffer.push(
            state,
            action,
            reward,
            next_state,
            done
        )

    # --------------------------------------------------------
    # Double DQN optimization step
    # --------------------------------------------------------
    def learn(self):
        if len(self.replay_buffer) < self.batch_size:
            return None

        (
            states,
            actions,
            rewards,
            next_states,
            dones
        ) = self.replay_buffer.sample(self.batch_size)

        states = states.to(self.device)
        actions = actions.to(self.device)
        rewards = rewards.to(self.device)
        next_states = next_states.to(self.device)
        dones = dones.to(self.device)

        # Q(s, a) from the online network.
        current_q_values = self.online_network(states).gather(
            1,
            actions.unsqueeze(1)
        ).squeeze(1)

        # Double DQN:
        # online network selects the next action;
        # target network evaluates that action.
        with torch.no_grad():
            next_actions = self.online_network(
                next_states
            ).argmax(dim=1, keepdim=True)

            next_q_values = self.target_network(
                next_states
            ).gather(
                1,
                next_actions
            ).squeeze(1)

            target_q_values = rewards + (
                self.gamma
                * next_q_values
                * (1.0 - dones)
            )

        loss = self.loss_function(
            current_q_values,
            target_q_values
        )

        self.optimizer.zero_grad()
        loss.backward()

        # Stabilize optimization by limiting gradient magnitude.
        torch.nn.utils.clip_grad_norm_(
            self.online_network.parameters(),
            max_norm=10.0
        )

        self.optimizer.step()

        self.learn_steps += 1

        # Periodically synchronize the target network.
        if self.learn_steps % self.target_update_frequency == 0:
            self.target_network.load_state_dict(
                self.online_network.state_dict()
            )

        return float(loss.item())

    # --------------------------------------------------------
    # Decay exploration after a training episode
    # --------------------------------------------------------
    def decay_epsilon(self):
        self.epsilon = max(
            self.epsilon_end,
            self.epsilon * self.epsilon_decay
        )

    # --------------------------------------------------------
    # Save model and optimizer checkpoint
    # --------------------------------------------------------
    def save_checkpoint(self, filepath):
        filepath = str(filepath)

        torch.save(
            {
                "model_name": self.model_name,
                "state_dim": self.state_dim,
                "num_actions": self.num_actions,
                "online_network": self.online_network.state_dict(),
                "target_network": self.target_network.state_dict(),
                "optimizer": self.optimizer.state_dict(),
                "epsilon": self.epsilon,
                "learn_steps": self.learn_steps
            },
            filepath
        )

    # --------------------------------------------------------
    # Load a saved checkpoint
    # --------------------------------------------------------
    def load_checkpoint(self, filepath):
        checkpoint = torch.load(
            filepath,
            map_location=self.device
        )

        if checkpoint["model_name"] != self.model_name:
            raise ValueError(
                "Checkpoint model does not match the agent model."
            )

        if checkpoint["state_dim"] != self.state_dim:
            raise ValueError(
                "Checkpoint state dimension does not match."
            )

        if checkpoint["num_actions"] != self.num_actions:
            raise ValueError(
                "Checkpoint action dimension does not match."
            )

        self.online_network.load_state_dict(
            checkpoint["online_network"]
        )
        self.target_network.load_state_dict(
            checkpoint["target_network"]
        )
        self.optimizer.load_state_dict(
            checkpoint["optimizer"]
        )

        self.epsilon = checkpoint["epsilon"]
        self.learn_steps = checkpoint["learn_steps"]

        self.target_network.eval()


