# ------------------------------------------------------------
# 4. LOSS EXTRACTION
# ------------------------------------------------------------

def extract_training_loss(result):

    if isinstance(result, dict):

        for key in ["loss", "train_loss", "q_loss"]:

            if key in result:

                result = result[key]
                break

    if isinstance(result, torch.Tensor):

        result = result.detach().cpu().item()

    if isinstance(result, (int, float, np.number)):

        value = float(result)

        if np.isfinite(value):
            return value

    return np.nan


