def normalize_packet_loss(value):

    """

    Return packet loss as a fraction between 0 and 1.

    """

    value = float(value)

    if not np.isfinite(value):

        return 0.0

    if value > 1.0:

        value = value / 100.0

    return float(np.clip(value, 0.0, 1.0))


def normalize_signal(value):

    """

    Preserve the original signal measurement.

    Convert dBm to a normalized [0,1] channel-quality
    indicator using a bounded transformation.

    If the input is already in [0,1], retain it.

    """

    value = float(value)

    if not np.isfinite(value):

        return 0.5

    if 0.0 <= value <= 1.0:

        return value

    # Bounded transformation for negative dBm measurements.

    return float(

        np.clip((value + 120.0) / 100.0, 0.0, 1.0)

    )


def normalize_bandwidth_utilization(value):

    """

    Convert bandwidth utilization to a fraction.

    """

    value = float(value)

    if not np.isfinite(value):

        return 0.0

    if value > 1.0:

        value = value / 100.0

    return float(np.clip(value, 0.0, 1.0))


