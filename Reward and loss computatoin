    # Actual stored rewards, not fabricated episode rewards.
    stored_rewards = []

    for record in all_transitions:

        if record["algorithm"] != algorithm:
            continue

        transition = record["transition"]

        stored_rewards.append(float(transition[2]))

    replay_mean_reward = (
        float(np.mean(stored_rewards))
        if stored_rewards else np.nan
    )

    successful_updates = 0

    for episode in range(1, NUM_EPISODES + 1):

        try:

            parameters = list(
                signature.parameters.values()
            )

            required = [
                p for p in parameters
                if p.default is inspect.Parameter.empty
                and p.kind not in (
                    inspect.Parameter.VAR_POSITIONAL,
                    inspect.Parameter.VAR_KEYWORD
                )
            ]

            if len(required) == 0:

                result = learning_method()

            elif len(required) == 1:

                result = learning_method(
                    effective_batch_size
                )

            else:

                raise RuntimeError(
                    "Unsupported learning method signature."
                )

            loss_value = extract_training_loss(result)

            if np.isfinite(loss_value):

                successful_updates += 1

            history["episode"].append(episode)

            history["loss"].append(loss_value)

            history["replay_mean_reward"].append(
                replay_mean_reward
            )

        except Exception as exc:

            raise RuntimeError(
                f"{algorithm} training failed at "
                f"episode {episode}: {exc}"
