def validate_transition(row):

    """
    Validate a genuine reinforcement-learning transition.

    Transition format:
    (state, action, reward, next_state, done)
    """

    # Current state
    state = np.asarray(
        row["state"],
        dtype=np.float32
    ).reshape(-1)

    # Next state
    next_state = np.asarray(
        row["next_state"],
        dtype=np.float32
    ).reshape(-1)

    # Action
    action = int(row["action_id"])

    # Reward
    reward = float(row["reward"])

    # Terminal flag
    done_value = row["done"]

    if pd.isna(done_value):
        raise ValueError("Missing terminal flag.")

    if isinstance(done_value, (bool, np.bool_)):
        done = bool(done_value)

    elif done_value in (0, 1, 0.0, 1.0):
        done = bool(done_value)

    else:
        raise ValueError(
            f"Invalid terminal flag: {done_value}"
        )

    # State dimension validation
    if state.shape != (STATE_DIM,):
        raise ValueError(
            f"Invalid state shape: {state.shape}"
        )

    if next_state.shape != (STATE_DIM,):
        raise ValueError(
            f"Invalid next-state shape: {next_state.shape}"
        )

    # Numerical validation
    if not np.isfinite(state).all():
        raise ValueError("Invalid current state.")

    if not np.isfinite(next_state).all():
        raise ValueError("Invalid next state.")

    if not np.isfinite(reward):
        raise ValueError("Invalid reward.")

    # Action validation
    if not 0 <= action < ACTION_DIM:
