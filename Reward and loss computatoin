        exist_ok=True
    )


    # --------------------------------------------------------
    # GENERATE EACH METRIC
    # --------------------------------------------------------

    for metric in PLOT_METRICS:

        fig, ax = plt.subplots(
            figsize=(10, 7)
        )


        # ----------------------------------------------------
        # PLOT FOUR MODELS
        # ----------------------------------------------------

        for model_name in MODELS:

            history = TRAFFIC_TRAINING_HISTORY[
                traffic_id
            ][model_name]


            episodes = np.asarray(
                history["episode"],
                dtype=float
            )

            values = np.asarray(
                history[metric],
                dtype=float
            )


            # Validate data
            if len(episodes) != len(values):

                raise ValueError(
                    f"Length mismatch: {traffic_label}, "
                    f"{model_name}, {metric}"
                )


            if len(values) == 0:
                continue


            # Handle invalid numerical values
            values = np.nan_to_num(
                values,
                nan=0.0,
                posinf=0.0,
                neginf=0.0
            )


            # Ten-episode moving average
            smoothed = pd.Series(
                values
            ).rolling(

                window=METRIC_SMOOTHING_WINDOW,

                min_periods=1

            ).mean().to_numpy()


            style = MODEL_STYLES[model_name]


            ax.plot(

                episodes,

                smoothed,

                label=model_name,

                linestyle=style["linestyle"],

                marker=style["marker"],

                markevery=max(
                    1,
                    len(episodes) // 15
                ),

                markersize=6

            )


        # ----------------------------------------------------
        # AXIS CONFIGURATION
        # ----------------------------------------------------

        ax.set_xlabel(
            "Training Episodes"
        )

        ax.set_ylabel(
            METRIC_LABELS[metric]
        )

        ax.set_xlim(
            left=0
        )

        ax.set_ylim(
            bottom=0
        )

        ax.xaxis.set_major_locator(
            MaxNLocator(integer=True)
        )

        ax.grid(
            True,
            linestyle="--",
            linewidth=0.7,
            alpha=0.45
        )


        # ----------------------------------------------------
        # TOP LEGEND
        # ----------------------------------------------------

        ax.legend(

            loc="lower center",

            bbox_to_anchor=(0.5, 1.02),

            ncol=4,

            frameon=False

        )


        # ----------------------------------------------------
        # SAVE FIGURES
        # ----------------------------------------------------

        fig.tight_layout()


        png_file = (
            traffic_plot_dir
            / f"{traffic_label}_{metric}.png"
        )

        eps_file = (
            traffic_plot_dir
            / f"{traffic_label}_{metric}.eps"
        )


        fig.savefig(

            png_file,

            dpi=600,

            bbox_inches="tight"

        )


        fig.savefig(

            eps_file,

            format="eps",

            dpi=600,

            bbox_inches="tight"

        )


        plt.close(fig)


        print(
            f"Saved: {traffic_label} | {metric}"
        )


