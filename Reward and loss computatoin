# ------------------------------------------------------------
# 1. HELPER: CONVERT LOSS TO SCALAR
# ------------------------------------------------------------

def extract_loss_value(loss):

    if isinstance(loss, dict):

        loss = loss.get(
            "loss",
            loss.get("critic_loss", 0.0)
        )

    if isinstance(loss, (tuple, list)):

        loss = loss[0] if len(loss) else 0.0

    return safe_float(loss)


# ------------------------------------------------------------
# 2. HELPER: COMPUTE MEAN Q-VALUE
# ------------------------------------------------------------

def calculate_mean_q_value(agent, state):

    try:

        network = agent.online_network

        device = next(network.parameters()).device

        state_tensor = torch.as_tensor(
            state,
            dtype=torch.float32,
            device=device
        ).reshape(1, -1)

        with torch.no_grad():

            q_values = network(state_tensor)

            return safe_float(
                q_values.max(dim=1).values.mean()
            )

    except Exception:

        return 0.0


# ------------------------------------------------------------
# 3. HELPER: TRAIN ONE MODEL FOR ONE TRAFFIC TYPE
# ------------------------------------------------------------

def train_single_model(
    model_name,
    traffic_name,
    traffic_index
):

    print("\n" + "-" * 75)

    print(
        f"TRAINING: {model_name} | {traffic_name}"
    )

    print("-" * 75)

    history = TRAFFIC_TRAINING_HISTORY[
        traffic_name
    ][model_name]


    # --------------------------------------------------------
    # A. CREATE INDEPENDENT AGENT
    # --------------------------------------------------------

    agent = DDQNAgent(
        model_name=model_name
    )


    # --------------------------------------------------------
    # B. CONNECT THE CORRECT REPLAY BUFFER
    # --------------------------------------------------------

    replay_buffer = REPLAY_BUFFERS[model_name]

    if not hasattr(replay_buffer, "clear"):

        raise AttributeError(
            f"{model_name}: replay buffer has no clear() method."
        )

    replay_buffer.clear()

    agent.replay_buffer = replay_buffer

    agents[model_name] = agent


    # --------------------------------------------------------
    # C. TRAINING EPISODES
    # --------------------------------------------------------

    for episode in range(1, TRAINING_EPISODES + 1):

        episode_seed = (
            TRAINING_SEED
            + traffic_index * 100000
            + episode
        )

        random.seed(episode_seed)

        np.random.seed(episode_seed)

        torch.manual_seed(episode_seed)


        # ----------------------------------------------------
        # INITIALIZE A FRESH RADIO ENVIRONMENT
        # ----------------------------------------------------

        environment = initialize_environment(

            traffic_name=traffic_name,

            num_users=TRAINING_NUM_USERS,

            seed=episode_seed

        )

        odu = environment["odu"]

        users = environment["users"]


        if len(users) == 0:

            raise RuntimeError(
                f"No users generated for {traffic_name}"
            )


        # ----------------------------------------------------
        # EPISODE ACCUMULATORS
        # ----------------------------------------------------

        episode_reward = 0.0

        episode_losses = []

        episode_q_values = []

        episode_updates = 0


        # ----------------------------------------------------
        # INTERACT WITH THE O-DU
        # ----------------------------------------------------

        for user_index, user in enumerate(users):

            # -----------------------------------------------
            # 1. OBSERVE CURRENT STATE
            # -----------------------------------------------

            state = make_state(
                user,
                odu
            )

            state = np.asarray(
                state,
                dtype=np.float32
            ).reshape(-1)


            # -----------------------------------------------
            # 2. SELECT ACTION USING THE CURRENT MODEL
            # -----------------------------------------------

            action_id = agent.select_action(
                state,
                explore=True
            )

            action_id = int(action_id)


            # -----------------------------------------------
            # 3. EXECUTE THE EXISTING ACTION FUNCTION
            # -----------------------------------------------

            transition = execute_agent_action(

                odu,
                user,
                action_id

            )


            if not isinstance(transition, dict):

                raise TypeError(
                    "execute_agent_action must return a dictionary."
                )


            # -----------------------------------------------
            # 4. EXTRACT TRANSITION
            # -----------------------------------------------

            transition_state = np.asarray(

                transition.get("state", state),

                dtype=np.float32

            ).reshape(-1)


            next_state = transition.get(
                "next_state"
            )

            if next_state is None:

                next_state = make_state(
                    user,
                    odu
                )

            next_state = np.asarray(
                next_state,
                dtype=np.float32
            ).reshape(-1)


            reward = extract_scalar_reward(
                transition.get("reward", 0.0)
            )


            done = (
                user_index == len(users) - 1
            )


            # -----------------------------------------------
            # 5. STORE REAL EXPERIENCE
            # -----------------------------------------------

            replay_buffer.add(

                transition_state,

                action_id,

                reward,

                next_state,

                done

            )


            episode_reward += reward


            # -----------------------------------------------
            # 6. RECORD Q-VALUE
            # -----------------------------------------------

            episode_q_values.append(
                calculate_mean_q_value(
                    agent,
                    transition_state
                )
            )


            # -----------------------------------------------
            # 7. UPDATE THE NETWORK
            # -----------------------------------------------

            if get_buffer_size(replay_buffer) >= TRAINING_BATCH_SIZE:

                loss = agent.learn()

                loss_value = extract_loss_value(
                    loss
                )

                if np.isfinite(loss_value):

                    episode_losses.append(
                        loss_value
                    )

                    episode_updates += 1


        # ----------------------------------------------------
        # END OF EPISODE: EXTRACT RESOURCE METRICS
        # ----------------------------------------------------

        episode_metrics = calculate_episode_metrics(

            odu=odu,

            users=users,

            episode_reward=episode_reward

        )


        # ----------------------------------------------------
        # EPSILON DECAY
        # ----------------------------------------------------

        agent.decay_epsilon()

        epsilon_value = safe_float(
            getattr(agent, "epsilon", 0.0)
        )


        # ----------------------------------------------------
        # TRAINING DIAGNOSTICS
        # ----------------------------------------------------

        mean_loss = (

            float(np.mean(episode_losses))

            if episode_losses

            else 0.0

        )

        mean_q_value = (

            float(np.mean(episode_q_values))

            if episode_q_values

            else 0.0

        )


        # ----------------------------------------------------
        # SAVE EPISODE HISTORY
        # ----------------------------------------------------

        history["episode"].append(
            episode
        )


        for metric in PLOT_METRICS:

            history[metric].append(
                episode_metrics[metric]
            )


        history["loss"].append(
            mean_loss
        )

        history["epsilon"].append(
            epsilon_value
        )

        history["q_value"].append(
            mean_q_value
        )

        history["updates"].append(
            episode_updates
        )


        # ----------------------------------------------------
        # TRAINING PROGRESS
        # ----------------------------------------------------

        if episode % 25 == 0 or episode == 1:

            print(

                f"{model_name:12s} | "

                f"{traffic_name} | "

                f"Episode {episode:4d}/{TRAINING_EPISODES} | "

                f"Reward: {episode_reward:10.4f} | "

                f"Throughput: "
                f"{episode_metrics['throughput_mbps']:9.4f} Mbps | "

                f"Served: "
                f"{episode_metrics['users_served']:4d}/"
                f"{episode_metrics['users_requested']:4d} | "

                f"Loss: {mean_loss:.6f} | "

                f"Epsilon: {epsilon_value:.5f} | "

                f"Updates: {episode_updates}"

            )


    # --------------------------------------------------------
    # MODEL TRAINING COMPLETED
    # --------------------------------------------------------

    print("\nCompleted:", model_name, "|", traffic_name)

    print(
        "Total episodes:",
        len(history["episode"])
    )

    print(
        "Total learning updates:",
        sum(history["updates"])
    )

    return agent


