        return default

    for key in keys:

        if key in data and data[key] is not None:
            return data[key]

    return default


def extract_scalar_reward(reward):

    if isinstance(reward, dict):

        for key in [
            "reward",
            "episode_reward",
            "total_reward",
            "user_reward"
        ]:

            if key in reward:
                return extract_scalar_reward(reward[key])

        return 0.0

    return safe_float(reward)


def get_buffer_size(buffer):

    try:
        return len(buffer)

    except TypeError:

        for attribute in ["memory", "buffer", "storage"]:

            value = getattr(buffer, attribute, None)

            if value is not None:
                return len(value)

    return 0


def calculate_episode_metrics(
    odu,
    users,
    episode_reward
):

    # --------------------------------------------------------
    # 1. O-DU SUMMARY
    # --------------------------------------------------------

    odu_summary = odu.get_summary()

    if not isinstance(odu_summary, dict):
        odu_summary = {}


    # --------------------------------------------------------
    # 2. USER-LEVEL RESOURCE STATISTICS
    # --------------------------------------------------------

    allocated_rbs_user = sum(

        safe_float(user.get("allocated_rbs", 0))

        for user in users

    )

    requested_rbs_user = sum(

        safe_float(user.get("requested_rbs", 0))

        for user in users

    )

    allocated_power_user = sum(

        safe_float(user.get("allocated_power_w", 0))

        for user in users

    )

    throughput_user = sum(

        safe_float(user.get("achieved_rate_mbps", 0))

        for user in users

    )

    latency_values = [

        safe_float(
            user.get(
                "transmission_latency_ms",
                user.get("latency_ms", 0)
            )
        )

        for user in users

        if safe_float(
            user.get(
                "transmission_latency_ms",
                user.get("latency_ms", 0)
            )
        ) > 0

    ]

    energy_user = sum(

        safe_float(
            user.get(
                "energy_j",
                user.get("energy_proxy_joules", 0)
            )
        )

        for user in users

    )


    # --------------------------------------------------------
    # 3. SERVICE SUCCESS
    # --------------------------------------------------------

    users_requested = len(users)

    users_served = sum(

        bool(user.get("served", False))

        for user in users

    )


    # --------------------------------------------------------
    # 4. O-DU RESOURCE METRICS
    # --------------------------------------------------------

    allocated_rbs = safe_float(

        get_first_value(
            odu_summary,
            ["allocated_rbs", "total_allocated_rbs"],
            allocated_rbs_user
        )

    )

    total_rbs = safe_float(

        get_first_value(
            odu_summary,
            ["total_rbs", "available_rbs", "rb_capacity"],
            globals().get("TOTAL_RBS", 100)
        )

    )

    remaining_rbs = safe_float(

        get_first_value(
            odu_summary,
            ["remaining_rbs", "available_remaining_rbs"],
            max(total_rbs - allocated_rbs, 0)
        )

    )


    # --------------------------------------------------------
    # 5. BANDWIDTH METRICS
    # --------------------------------------------------------

    rb_bandwidth_mhz = 0.18

    allocated_bandwidth = safe_float(

        get_first_value(
            odu_summary,
            ["allocated_bandwidth_mhz"],
            allocated_rbs * rb_bandwidth_mhz
        )

    )

    requested_bandwidth = (
        requested_rbs_user * rb_bandwidth_mhz
    )

    requested_bandwidth = safe_float(

        get_first_value(
            odu_summary,
            ["requested_bandwidth_mhz"],
            requested_bandwidth
        )

    )

    bandwidth_acceptance = (

        allocated_bandwidth / requested_bandwidth

        if requested_bandwidth > 0

        else 0.0

    )


    # --------------------------------------------------------
    # 6. POWER AND THROUGHPUT
    # --------------------------------------------------------

    total_power = safe_float(

        get_first_value(
            odu_summary,
            ["total_power", "total_power_w", "allocated_power_w"],
            allocated_power_user
        )

    )

    throughput = safe_float(

        get_first_value(
            odu_summary,
            ["throughput_mbps", "total_throughput_mbps"],
            throughput_user
        )

    )


    # --------------------------------------------------------
    # 7. LATENCY AND ENERGY
    # --------------------------------------------------------

    mean_latency = (

        float(np.mean(latency_values))

        if latency_values

        else 0.0

    )

    energy = energy_user


    # --------------------------------------------------------
    # 8. RESOURCE UTILIZATION
    # --------------------------------------------------------

    rb_utilization = (

        allocated_rbs / total_rbs

        if total_rbs > 0

        else 0.0

    )


    # --------------------------------------------------------
    # 9. FINAL EPISODE METRICS
    # --------------------------------------------------------

    metrics = {

        "allocated_rbs": allocated_rbs,

        "remaining_rbs": remaining_rbs,

        "allocated_bandwidth_mhz": allocated_bandwidth,

        "requested_bandwidth_mhz": requested_bandwidth,

        "bandwidth_acceptance_ratio": bandwidth_acceptance,

        "total_power": total_power,

        "throughput_mbps": throughput,

        "transmission_latency_ms": mean_latency,

        "energy_proxy_joules": energy,

        "users_requested": users_requested,

        "users_served": users_served,

        "rb_utilization": rb_utilization,

        "episode_reward": safe_float(episode_reward)

    }

    return metrics


