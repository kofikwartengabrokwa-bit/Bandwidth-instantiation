def generate_users(

    num_users,

    traffic_name,

    seed=SEED

):

    """

    Generate users from the actual dataset.

    Each generated user inherits the radio and QoS
    characteristics of a sampled dataset observation.

    Sampling with replacement allows experiments
    with user loads exceeding individual class sizes.

    """

    if traffic_name not in TRAFFIC_NAMES:

        raise ValueError(

            f"Invalid traffic type: {traffic_name}"

        )


    rng = np.random.default_rng(seed)

    # ============================================================
    # ROBUST TRAFFIC TYPE IDENTIFICATION
    # Supports both integer IDs (1, 2, 3) and names (TP1, TP2, TP3)
    # ============================================================

    if isinstance(traffic_name, (int, np.integer)):

        traffic_id = int(traffic_name)

        if traffic_id not in TRAFFIC_TYPES:
            raise ValueError(
                f"Unknown traffic ID: {traffic_id}. "
                f"Valid IDs: {list(TRAFFIC_TYPES.keys())}"
            )

    else:

        traffic_label = str(traffic_name).strip().upper()

        traffic_id = next(
            (
                tid
                for tid, config in TRAFFIC_TYPES.items()
                if str(config["name"]).strip().upper() == traffic_label
            ),
            None
        )

        if traffic_id is None:
            raise ValueError(
                f"Unknown traffic type: {traffic_name}. "
                f"Valid traffic names: "
                f"{[config['name'] for config in TRAFFIC_TYPES.values()]}"
            )

    traffic_config = TRAFFIC_TYPES[traffic_id]
    traffic_label = traffic_config["name"]

    # ============================================================
    # RETRIEVE TRAFFIC DATA
    # ============================================================

    if traffic_label not in TRAFFIC_DATA:
        raise KeyError(
            f"Traffic data for {traffic_label} not found. "
            f"Available keys: {list(TRAFFIC_DATA.keys())}"
        )

    traffic_df = TRAFFIC_DATA[traffic_label]

    if len(traffic_df) == 0:
        raise ValueError(
            f"No observations available for {traffic_label}"
        )

    sampled_indices = rng.choice(
        traffic_df.index.to_numpy(),
        size=num_users,
        replace=True
    )

    sampled_data = traffic_df.loc[
        sampled_indices
    ].reset_index(drop=True)

    users = []

    # ============================================================
    # DATASET-DRIVEN USER GENERATION
    # ============================================================

    import re

    # ------------------------------------------------------------
    # Normalize dataset column names once
    # ------------------------------------------------------------

    def normalize_column_name(column):

        return re.sub(
            r"[^a-z0-9]+",
            "_",
            str(column).strip().lower()
        ).strip("_")

    COLUMN_MAP = {
        normalize_column_name(column): column
        for column in sampled_data.columns
    }

    def get_dataset_value(row, aliases, field_name):

        for alias in aliases:

            normalized_alias = normalize_column_name(alias)

            if normalized_alias in COLUMN_MAP:
                return float(
                    row[COLUMN_MAP[normalized_alias]]
                )

        raise KeyError(
            f"{field_name} column not found. "
            f"Available columns: {list(sampled_data.columns)}"
        )

    # ------------------------------------------------------------
    # Signal-strength range for channel-quality normalization
    # ------------------------------------------------------------

    signal_values = pd.to_numeric(
        sampled_data[COL_SIGNAL],
        errors="coerce"
    ).dropna()

    if signal_values.empty:
        raise ValueError("Signal-strength column contains no valid values.")

    signal_min = float(signal_values.min())
    signal_max = float(signal_values.max())

    # ------------------------------------------------------------
    # Generate users from sampled dataset records
    # ------------------------------------------------------------

    for uid, row in sampled_data.iterrows():

        # --------------------------------------------------------
        # 1. Traffic demand
        # --------------------------------------------------------

        if "traffic_load_bps" in COLUMN_MAP:

            demand = (
                    get_dataset_value(
                        row,
                        ["traffic_load_bps"],
                        "Traffic load"
                    ) / 1_000_000.0
            )

        elif "traffic_load_mbps" in COLUMN_MAP:

            demand = get_dataset_value(
                row,
                ["traffic_load_mbps"],
                "Traffic load"
            )

        else:

            raise KeyError(
                "Traffic-load column not found. "
                f"Available columns: {list(sampled_data.columns)}"
            )

        # --------------------------------------------------------
        # 2. Observed throughput
        # --------------------------------------------------------

        observed_throughput = get_dataset_value(
            row,
            [
                "throughput_mbps",
                "QoS Metric (Throughput)",
                "throughput_bps"
            ],
            "Throughput"
        )

        # Convert bps to Mbps only when the source is explicitly bps.
        if "throughput_bps" in COLUMN_MAP:
            observed_throughput /= 1_000_000.0

        # --------------------------------------------------------
        # 3. Observed latency
        # --------------------------------------------------------

        observed_latency = get_dataset_value(
            row,
            [
                "observed_latency_ms",
                "Latency",
                "latency_ms"
            ],
            "Latency"
        )

        # --------------------------------------------------------
        # 4. Packet loss
        # --------------------------------------------------------

        packet_loss = get_dataset_value(
            row,
            [
                "packet_loss_fraction",
                "Packet Loss Rate",
                "packet_loss_rate"
            ],
            "Packet loss"
        )

        # Convert percentage to fraction when necessary.
        if packet_loss > 1.0:
            packet_loss /= 100.0

        packet_loss = float(np.clip(packet_loss, 0.0, 1.0))

        # --------------------------------------------------------
        # 5. Signal strength and channel quality
        # --------------------------------------------------------

        signal_strength = float(row[COL_SIGNAL])

        if "channel_quality" in COLUMN_MAP:

            channel = get_dataset_value(
                row,
                ["channel_quality"],
                "Channel quality"
            )

        else:

            # Normalize signal strength to [0, 1].
            if signal_max > signal_min:

                channel = (
                        (signal_strength - signal_min)
                        / (signal_max - signal_min)
                )

            else:

                channel = 0.5

        channel = float(np.clip(channel, 0.0, 1.0))

        # --------------------------------------------------------
        # 6. Observed bandwidth utilization
        # --------------------------------------------------------

        bandwidth_util = get_dataset_value(
            row,
            [
                "observed_bandwidth_utilization",
                "Bandwidth Utilization",
                "bandwidth_utilization"
            ],
            "Bandwidth utilization"
        )

        # --------------------------------------------------------
        # 7. Estimate required RBs
        # --------------------------------------------------------

        estimated_spectral_efficiency = (
                0.5 + 4.5 * channel
        )

        estimated_rb_capacity = (
                ODU_BANDWIDTH_PER_RB_MHZ
                * estimated_spectral_efficiency
        )

        requested_rbs = (

            int(
                np.ceil(
                    demand / max(estimated_rb_capacity, 1e-8)
                )
            )

            if demand > 0

            else 0
        )

        # --------------------------------------------------------
        # 8. Construct user record
        # --------------------------------------------------------

        users.append({

            "user_id": int(uid),

            "traffic_type": int(traffic_id),

            "traffic_name": traffic_name,

            "priority": TRAFFIC_TYPES[traffic_id]["priority"],

            "demand_mbps": demand,

            "observed_throughput_mbps": observed_throughput,

            "observed_latency_ms": observed_latency,

            "packet_loss": packet_loss,

            "channel": channel,

            "original_signal_strength": signal_strength,

            "bandwidth_utilization": bandwidth_util,

            "requested_rbs": requested_rbs,

            "requested_power": 4.0,

            "data_volume_mbits": demand * SLOT_SECONDS,

            "source_dataset_index": int(sampled_indices[uid])

        })

    return users


# ============================================================
# 6. O-RU RADIO INTERFACE
# ============================================================

class ORU:

    """

    Dataset-driven O-RU interface.

    Connects users belonging to one traffic type.

    """

    def __init__(self, seed=SEED):

        self.seed = seed


    def connect_users(

        self,

        num_users,

        traffic_name,

        seed=None

    ):

        if seed is None:

            seed = self.seed


        return generate_users(

            num_users=num_users,

            traffic_name=traffic_name,

            seed=seed

        )


# ============================================================
# 7. O-DU RESOURCE CONTROLLER
# ============================================================

ODU_BANDWIDTH_PER_RB_MHZ = (

    TOTAL_BANDWIDTH_MHZ / TOTAL_RBS

)


class ODU:

    """

    Shared O-DU radio resource controller.

    Tracks:
       - RB allocation
       - Bandwidth allocation
       - Power allocation
       - Throughput
       - Energy
       - Served users
       - Transmission latency
       - Bandwidth acceptance

    """

    def __init__(

        self,

        total_rbs=TOTAL_RBS,

        total_bandwidth_mhz=TOTAL_BANDWIDTH_MHZ,

        power_budget=TOTAL_POWER_BUDGET

    ):

        self.total_rbs = int(total_rbs)

        self.total_bandwidth_mhz = float(

            total_bandwidth_mhz

        )

        self.power_budget = float(power_budget)

        self.bandwidth_per_rb = (

            self.total_bandwidth_mhz /

            max(self.total_rbs, 1)

        )

        self.reset()


    def reset(self):

        """

        Reset resource budgets for a new scheduling interval.

        """

        self.remaining_rbs = self.total_rbs

        self.remaining_power = self.power_budget

        self.total_allocated_rbs = 0

        self.total_allocated_bandwidth_mhz = 0.0

        self.total_allocated_power = 0.0

        self.total_throughput_mbps = 0.0

        self.total_energy_proxy = 0.0

        self.total_requested_bandwidth_mhz = 0.0

        self.total_requested_rbs = 0

        self.users_requested = 0

        self.users_served = 0

        self.user_latencies_ms = []

        self.user_computation_latencies_ms = []

        self.user_results = []


    # --------------------------------------------------------
    # RESOURCE ALLOCATION
    # --------------------------------------------------------

    def allocate(

        self,

        user,

        requested_rbs=None,

        requested_power=None

    ):

        """

        Allocate available RBs and power to a user.

        """

        if requested_rbs is None:

            requested_rbs = user["requested_rbs"]


        if requested_power is None:

            requested_power = user["requested_power"]


        requested_rbs = max(

            0,

            int(requested_rbs)

        )


        requested_power = max(

            0.0,

            float(requested_power)

        )


        # Record requested resources before allocation.

        self.total_requested_rbs += requested_rbs

        self.total_requested_bandwidth_mhz += (

            requested_rbs * self.bandwidth_per_rb

        )

        self.users_requested += 1


        # Enforce O-DU resource constraints.

        allocated_rbs = min(

            requested_rbs,

            self.remaining_rbs

        )


        allocated_power = min(

            requested_power,

            self.remaining_power

        )


        if allocated_rbs == 0:

            allocated_power = 0.0


        # Calculate allocated bandwidth.

        allocated_bandwidth = (

            allocated_rbs * self.bandwidth_per_rb

        )


        # Dataset-driven channel quality.

        channel = float(

            np.clip(user["channel"], 0.0, 1.0)

        )


        spectral_efficiency = (

            0.5 + 4.5 * channel

        )


        # Simplified power-dependent rate model.

        power_factor = (

            min(np.sqrt(allocated_power / 4.0), 2.0)

            if allocated_power > 0

            else 0.0

        )


        data_rate_mbps = (

            allocated_bandwidth *

            spectral_efficiency *

            power_factor

        )


        # Transmission latency.

        data_volume = float(

            user["data_volume_mbits"]

        )


        if data_rate_mbps > 0:

            transmission_latency_ms = (

                data_volume / data_rate_mbps

            ) * 1000.0

        else:

            transmission_latency_ms = np.nan


        # Scheduling energy.

        energy_proxy = (

            allocated_power * SLOT_SECONDS

        )


        # Successful service.

        served = (

            allocated_rbs > 0 and

            data_rate_mbps >= user["demand_mbps"]

        )


        # Update O-DU resource budgets.

        self.remaining_rbs -= allocated_rbs

        self.remaining_power -= allocated_power


        # Accumulate scheduling statistics.

        self.total_allocated_rbs += allocated_rbs

        self.total_allocated_bandwidth_mhz += (

            allocated_bandwidth

        )

        self.total_allocated_power += allocated_power

        self.total_throughput_mbps += data_rate_mbps

        self.total_energy_proxy += energy_proxy


        if served:

            self.users_served += 1


        if np.isfinite(transmission_latency_ms):

            self.user_latencies_ms.append(

                transmission_latency_ms

            )


        result = {

            "user_id": user["user_id"],

            "requested_rbs": requested_rbs,

            "allocated_rbs": allocated_rbs,

            "requested_power": requested_power,

            "allocated_power": allocated_power,

            "bandwidth_mhz": allocated_bandwidth,

            "data_rate_mbps": data_rate_mbps,

            "throughput_mbps": data_rate_mbps,

            "demand_mbps": user["demand_mbps"],

            "transmission_latency_ms": transmission_latency_ms,

            "energy_proxy": energy_proxy,

            "served": bool(served),

            "packet_loss": user["packet_loss"],

            "traffic_name": user["traffic_name"]

        }


        self.user_results.append(result)


        return result


    # --------------------------------------------------------
    # RESOURCE SUMMARY
    # --------------------------------------------------------

    def get_summary(self):

        """

        Return aggregate scheduling-interval metrics.

        """

        mean_latency = (

            float(np.mean(self.user_latencies_ms))

            if self.user_latencies_ms

            else np.nan

        )


        bandwidth_acceptance = (

            self.total_allocated_bandwidth_mhz /

            self.total_requested_bandwidth_mhz

            if self.total_requested_bandwidth_mhz > 0

            else 0.0

        )


        service_success_probability = (

            self.users_served /

            self.users_requested

            if self.users_requested > 0

            else 0.0

        )


        rb_utilization = (

            self.total_allocated_rbs /

            max(self.total_rbs, 1)

        )


        return {

            "allocated_rbs": self.total_allocated_rbs,

            "remaining_rbs": self.remaining_rbs,

            "allocated_bandwidth_mhz":

                self.total_allocated_bandwidth_mhz,

            "requested_bandwidth_mhz":

                self.total_requested_bandwidth_mhz,

            "bandwidth_acceptance_ratio":

                bandwidth_acceptance,

            "total_power":

                self.total_allocated_power,

            "throughput_mbps":

                self.total_throughput_mbps,

            "transmission_latency_ms":

                mean_latency,

            "energy_proxy_joules":

                self.total_energy_proxy,

            "users_requested":

                self.users_requested,

            "users_served":

                self.users_served,

            "service_success_probability":

                service_success_probability,

            "rb_utilization":

                rb_utilization

        }


