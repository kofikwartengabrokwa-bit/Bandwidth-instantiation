def calculate_action_allocation(user, action_id):

    """
    Calculate the requested RB and power allocation
    corresponding to the selected RL action.
    """

    action = decode_action(action_id)

    # Original RB requirement calculated from user demand.
    requested_rbs = max(
        int(user.get("requested_rbs", 0)),
        0
    )

    # Apply the action's RB allocation ratio.
    action_requested_rbs = int(
        np.ceil(
            requested_rbs * action["rb_ratio"]
        )
    )

    # A zero RB ratio means no radio resource allocation.
    if action["rb_ratio"] == 0.0:

        action_requested_rbs = 0

    # Requested transmission power.
    action_requested_power = action["power_w"]

    return {

        "action_id": action_id,

        "requested_rbs": requested_rbs,

        "action_requested_rbs": action_requested_rbs,

        "action_requested_power_w": action_requested_power,

        "rb_ratio": action["rb_ratio"],

        "power_w": action_requested_power
    }


