def allocate_user_with_action(odu, user, action_id):
    """
    Apply an RL-selected action to one user and execute
    resource allocation through the existing ODU.allocate().
    """

    # --------------------------------------------------------
    # 1. Preserve the original user requirements
    # --------------------------------------------------------

    original_requested_rbs = int(
        user.get("requested_rbs", 0)
    )

    original_requested_power = float(
        user.get("requested_power_w", 4.0)
    )

    # --------------------------------------------------------
    # 2. Decode the selected RL action
    # --------------------------------------------------------

    allocation = calculate_action_allocation(
        user,
        action_id
    )

    action_requested_rbs = allocation[
        "action_requested_rbs"
    ]

    action_requested_power = allocation[
        "action_requested_power_w"
    ]

    # --------------------------------------------------------
    # 3. Apply the action to the user's allocation request
    # --------------------------------------------------------

    user["requested_rbs"] = action_requested_rbs

    user["requested_power_w"] = action_requested_power

    user["selected_action"] = int(action_id)

    user["action_rb_ratio"] = allocation["rb_ratio"]

    user["action_power_w"] = action_requested_power

    # --------------------------------------------------------
    # 4. Execute O-DU resource allocation
    # --------------------------------------------------------

    try:

        odu.allocate(user)

    finally:

        # Restore the original requirements.
        # Keep the actual allocation results unchanged.

        user["requested_rbs"] = original_requested_rbs

        user["requested_power_w"] = original_requested_power

    # --------------------------------------------------------
    # 5. Calculate reward using the actual allocation results
    # --------------------------------------------------------

    reward_details = calculate_user_reward(user)

    # --------------------------------------------------------
    # 6. Return action and allocation information
    # --------------------------------------------------------

    return {

        "action_id": int(action_id),

        "action_requested_rbs": action_requested_rbs,

        "action_requested_power_w": action_requested_power,

        "allocated_rbs": user.get("allocated_rbs", 0),

        "allocated_power_w": user.get(
            "allocated_power_w", 0.0
        ),

        "achieved_rate_mbps": user.get(
            "achieved_rate_mbps", 0.0
        ),

        "transmission_latency_ms": user.get(
            "transmission_latency_ms", 0.0
        ),

        "energy_j": user.get("energy_j", 0.0),

        "served": user.get("served", False),

        "reward": reward_details["reward"],

        "reward_details": reward_details
    }


