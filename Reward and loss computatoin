import copy


# ------------------------------------------------------------
# 1. TRAINING PARAMETERS
# ------------------------------------------------------------

GAMMA = 0.99

TARGET_UPDATE_STEPS = 100

EPSILON_START = 1.0
EPSILON_END = 0.05
EPSILON_DECAY = 0.995


# ------------------------------------------------------------
# 2. DDQN AGENT
# ------------------------------------------------------------

class DDQNAgent:

    def __init__(self, model_name):

        self.model_name = model_name

        # Independent online network
        self.online = NETWORK_FACTORIES[
            model_name
        ]().to(DEVICE)

        # Independent target network
        self.target = copy.deepcopy(
            self.online
        ).to(DEVICE)

        self.target.eval()

        # Independent optimizer
        self.optimizer = optim.Adam(
            self.online.parameters(),
            lr=LEARNING_RATE
        )

        self.loss_fn = nn.SmoothL1Loss()

        # Reuse existing independent replay buffer
        self.memory = REPLAY_BUFFERS[
            model_name
        ]

        self.epsilon = EPSILON_START

        self.steps = 0

    # --------------------------------------------------------
    # ACTION SELECTION
    # --------------------------------------------------------

    def select_action(self, state, explore=True):

        if (
            explore and
            random.random() < self.epsilon
        ):

            return random.randrange(
                NUM_ACTIONS
            )

        state_tensor = torch.as_tensor(
            state,
            dtype=torch.float32,
            device=DEVICE
        ).reshape(1, STATE_DIM)

        self.online.eval()

        with torch.no_grad():

            q_values = self.online(
                state_tensor
            )

        self.online.train()

        return int(
            q_values.argmax(dim=1).item()
        )

    # --------------------------------------------------------
    # DDQN LEARNING
    # --------------------------------------------------------

    def learn(self):

        if len(self.memory) < BATCH_SIZE:

            return None

        sample = self.memory.sample(
            BATCH_SIZE
        )

        states, actions, rewards, next_states, dones = sample

        states = torch.as_tensor(
            states,
            dtype=torch.float32,
            device=DEVICE
        )

        actions = torch.as_tensor(
            actions,
            dtype=torch.long,
            device=DEVICE
        ).reshape(-1, 1)

        rewards = torch.as_tensor(
            rewards,
            dtype=torch.float32,
            device=DEVICE
        ).reshape(-1)

        next_states = torch.as_tensor(
            next_states,
            dtype=torch.float32,
            device=DEVICE
        )

        dones = torch.as_tensor(
            dones,
            dtype=torch.float32,
            device=DEVICE
        ).reshape(-1)

        # Current Q-values
        current_q = self.online(
            states
        ).gather(
            1,
            actions
        ).squeeze(1)

        # Double DQN target calculation
        with torch.no_grad():

            next_actions = self.online(
                next_states
            ).argmax(
                dim=1,
                keepdim=True
            )

            next_q = self.target(
                next_states
            ).gather(
                1,
                next_actions
            ).squeeze(1)

            target_q = (
                rewards +
                GAMMA * (1.0 - dones) * next_q
            )

        # Calculate loss
        loss = self.loss_fn(
            current_q,
            target_q
        )

        self.optimizer.zero_grad()

        loss.backward()

        nn.utils.clip_grad_norm_(
            self.online.parameters(),
            max_norm=1.0
        )

        self.optimizer.step()

        self.steps += 1

        # Synchronize target network
        if self.steps % TARGET_UPDATE_STEPS == 0:

            self.target.load_state_dict(
                self.online.state_dict()
            )

        return float(loss.item())

    # --------------------------------------------------------
    # EXPLORATION DECAY
    # --------------------------------------------------------

    def decay_epsilon(self):

        self.epsilon = max(
            EPSILON_END,
            self.epsilon * EPSILON_DECAY
        )


