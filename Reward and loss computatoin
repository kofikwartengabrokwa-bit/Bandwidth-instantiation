def convert_to_mbps(values, column_name):

    """

    Convert traffic load or throughput to Mbps.

    Unit inference:
      - Explicit bps column: divide by 1e6.
      - Explicit kbps column: divide by 1e3.
      - Explicit Mbps column: retain.
      - Otherwise inspect magnitude and use a conservative
        automatic conversion.

    """

    name = str(column_name).lower()

    values = np.asarray(values, dtype=float)

    if "mbps" in name:

        return values

    if "kbps" in name:

        return values / 1e3

    if "bps" in name:

        return values / 1e6

    finite = values[np.isfinite(values)]

    if len(finite) == 0:

        return values

    if np.nanmedian(np.abs(finite)) > 1e5:

        return values / 1e6

    return values


def convert_latency_to_ms(values, column_name):

    """

    Convert latency to milliseconds when the dataset
    explicitly identifies its unit.

    """

    name = str(column_name).lower()

    values = np.asarray(values, dtype=float)

    if "(s)" in name or "seconds" in name:

        return values * 1000.0

    return values


