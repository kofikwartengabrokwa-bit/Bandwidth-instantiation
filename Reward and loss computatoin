# ============================================================
# BLOCK 11A: MODEL ARCHITECTURES
# Four independent DDQN-based architectures
#
# Ours           : RBF-DDQN
# GGN-MADDQN     : Graph-Neighborhood DDQN
# GCN-MADDQN     : Graph Convolutional DDQN
# MADDQN         : Conventional DDQN
# ============================================================

import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import random


# ------------------------------------------------------------
# 1. CURRENT ENVIRONMENT DIMENSIONS
# ------------------------------------------------------------

assert STATE_DIM == 12, (
    f"Expected STATE_DIM=12, got {STATE_DIM}"
)

ACTION_DIM = 20
NUM_ACTIONS = ACTION_DIM

RBF_CENTERS = 64
HIDDEN_DIM = 64


# ------------------------------------------------------------
# 2. RBF-DDQN: OUR PROPOSED MODEL
# ------------------------------------------------------------

class RBFQNetwork(nn.Module):

    def __init__(self):

        super().__init__()

        self.register_buffer(
            "centers",
            torch.rand(RBF_CENTERS, STATE_DIM)
        )

        self.gamma_rbf = 4.0

        self.head = nn.Sequential(
            nn.Linear(RBF_CENTERS, 128),
            nn.ReLU(),
            nn.Linear(128, 64),
            nn.ReLU(),
            nn.Linear(64, NUM_ACTIONS)
        )

    def forward(self, x):

        distance = (
            x.unsqueeze(1) -
            self.centers.unsqueeze(0)
        ).pow(2).sum(dim=2)

        features = torch.exp(
            -self.gamma_rbf * distance
        )

        return self.head(features)


# ------------------------------------------------------------
# 3. CONVENTIONAL DDQN: MADDQN BASELINE
# ------------------------------------------------------------

class DDQNQNetwork(nn.Module):

    def __init__(self):

        super().__init__()

        self.network = nn.Sequential(
            nn.Linear(STATE_DIM, 128),
            nn.ReLU(),

            nn.Linear(128, 128),
            nn.ReLU(),

            nn.Linear(128, 64),
            nn.ReLU(),

            nn.Linear(64, NUM_ACTIONS)
        )

    def forward(self, x):

        return self.network(x)


# ------------------------------------------------------------
# 4. FEATURE GRAPH CONSTRUCTION
# ------------------------------------------------------------

def make_feature_adjacency(n_features):

    adjacency = torch.eye(n_features)

    for i in range(n_features - 1):

        adjacency[i, i + 1] = 1.0
        adjacency[i + 1, i] = 1.0

    degree = adjacency.sum(dim=1).clamp(min=1.0)

    inv_sqrt = torch.diag(
        degree.pow(-0.50)
    )

    normalized = (
        inv_sqrt @ adjacency @ inv_sqrt
    )

    return normalized


# ------------------------------------------------------------
# 5. GGN-MADDQN: GRAPH-NEIGHBORHOOD NETWORK
# ------------------------------------------------------------

class GGNQNetwork(nn.Module):

    def __init__(self):

        super().__init__()

        self.register_buffer(
            "adjacency",
            make_feature_adjacency(STATE_DIM)
        )

        self.node_encoder = nn.Linear(
            1, HIDDEN_DIM
        )

        self.neighbor_update = nn.Sequential(
            nn.Linear(HIDDEN_DIM * 2, HIDDEN_DIM),
            nn.ReLU(),

            nn.Linear(HIDDEN_DIM, HIDDEN_DIM),
            nn.ReLU()
        )

        self.q_head = nn.Sequential(
            nn.Linear(HIDDEN_DIM, 128),
            nn.ReLU(),

            nn.Linear(128, NUM_ACTIONS)
        )

    def forward(self, x):

        node_values = x.unsqueeze(-1)

        node_embeddings = torch.relu(
            self.node_encoder(node_values)
        )

        neighbors = torch.einsum(
            "ij,bjh->bih",
            self.adjacency,
            node_embeddings
        )

        combined = torch.cat(
            [node_embeddings, neighbors],
            dim=-1
        )

        updated = self.neighbor_update(
            combined
        )

        graph_embedding = updated.mean(dim=1)

        return self.q_head(graph_embedding)


# ------------------------------------------------------------
# 6. GCN-MADDQN: GRAPH CONVOLUTIONAL NETWORK
# ------------------------------------------------------------

class GCNQNetwork(nn.Module):

    def __init__(self):

        super().__init__()

        self.register_buffer(
            "adjacency",
            make_feature_adjacency(STATE_DIM)
        )

        self.input_projection = nn.Linear(
            1, HIDDEN_DIM
        )

        self.graph_conv1 = nn.Linear(
            HIDDEN_DIM, HIDDEN_DIM
        )

        self.graph_conv2 = nn.Linear(
            HIDDEN_DIM, HIDDEN_DIM
        )

        self.q_head = nn.Sequential(
            nn.Linear(HIDDEN_DIM, 128),
            nn.ReLU(),

            nn.Linear(128, NUM_ACTIONS)
        )

    def forward(self, x):

        h = torch.relu(
            self.input_projection(
                x.unsqueeze(-1)
            )
        )

        h = torch.einsum(
            "ij,bjh->bih",
            self.adjacency,
            h
        )

        h = torch.relu(
            self.graph_conv1(h)
        )

        h = torch.einsum(
            "ij,bjh->bih",
            self.adjacency,
            h
        )

        h = torch.relu(
            self.graph_conv2(h)
        )

        graph_embedding = h.mean(dim=1)

        return self.q_head(graph_embedding)


