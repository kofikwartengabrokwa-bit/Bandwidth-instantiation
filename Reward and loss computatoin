# 3. DETERMINE DATASET-BASED NORMALIZATION LIMITS
# ============================================================

def safe_scale(values, percentile=99):

    """

    Calculate a robust positive normalization scale.

    Uses the 99th percentile to reduce the influence
    of extreme observations.

    """

    values = np.asarray(values, dtype=float)

    values = values[np.isfinite(values)]

    if len(values) == 0:

        return 1.0

    scale = float(

        np.percentile(

            np.abs(values),

            percentile

        )

    )

    return max(scale, 1e-8)


STATE_SCALES = {

    "demand": safe_scale(

        df["traffic_load_mbps"]

    ),

    "throughput": safe_scale(

        df["throughput_mbps"]

    ),

    "latency": safe_scale(

        df["observed_latency_ms"]

    )

}


