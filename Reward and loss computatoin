    users = oru.connect_users(

        num_users=num_users,

        traffic_name=traffic_name,

        seed=seed

    )


    return {

        "traffic_name": traffic_name,

        "num_users": num_users,

        "users": users,

        "oru": oru,

        "odu": odu

    }



