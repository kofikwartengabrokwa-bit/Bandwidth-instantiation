    episode_results = {

        "traffic_name": traffic_name,

        "num_users": len(users),

        "episode_reward": episode_reward,

        "odu_summary": odu_summary,

        "user_results": user_results,

        "states": state_records,

        "users": users,

        "odu": odu
    }

    return episode_results


