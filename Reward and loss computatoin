import random
from collections import deque

import numpy as np


print("\nInitializing experience replay memory...")


# ------------------------------------------------------------
# 8.1: REPLAY MEMORY CONFIGURATION
# ------------------------------------------------------------

REPLAY_CAPACITY = 50000
BATCH_SIZE = 64

assert STATE_DIM == 12, "Unexpected state dimension."
assert ACTION_DIM == 20, "Unexpected action dimension."

assert REPLAY_CAPACITY >= BATCH_SIZE, (
    "Replay capacity must be greater than or equal to batch size."
)


# ------------------------------------------------------------
# 8.2: EXPERIENCE REPLAY BUFFER
# ------------------------------------------------------------

class ExperienceReplayBuffer:

    def __init__(self, capacity, state_dim, action_dim):

        self.capacity = capacity
        self.state_dim = state_dim
        self.action_dim = action_dim

        self.memory = deque(maxlen=capacity)


    def add(
        self,
        state,
        action,
        reward,
        next_state,
        done
    ):

        state = np.asarray(
            state,
            dtype=np.float32
        ).reshape(-1)

        next_state = np.asarray(
            next_state,
            dtype=np.float32
        ).reshape(-1)

        action = int(action)
        reward = float(reward)
        done = bool(done)


        # Validate state dimensions.
        if state.shape[0] != self.state_dim:
            raise ValueError(
                f"Invalid state dimension: {state.shape[0]}"
            )

        if next_state.shape[0] != self.state_dim:
            raise ValueError(
                f"Invalid next-state dimension: "
                f"{next_state.shape[0]}"
            )


        # Validate action.
        if not 0 <= action < self.action_dim:
            raise ValueError(
                f"Invalid action ID: {action}"
            )


        # Validate numerical values.
        if not np.isfinite(state).all():
            raise ValueError("Non-finite state detected.")

        if not np.isfinite(next_state).all():
            raise ValueError("Non-finite next state detected.")

        if not np.isfinite(reward):
            raise ValueError("Non-finite reward detected.")


        transition = (
            state.copy(),
            action,
            reward,
            next_state.copy(),
            done
        )

        self.memory.append(transition)


    def sample(self, batch_size):

        if len(self.memory) < batch_size:
            raise ValueError(
                "Insufficient experiences for sampling."
            )

        batch = random.sample(
            self.memory,
            batch_size
        )

        states, actions, rewards, next_states, dones = zip(
            *batch
        )

        return (
            np.asarray(states, dtype=np.float32),
            np.asarray(actions, dtype=np.int64),
            np.asarray(rewards, dtype=np.float32),
            np.asarray(next_states, dtype=np.float32),
            np.asarray(dones, dtype=np.float32)
        )


    def __len__(self):

        return len(self.memory)


    def clear(self):

        self.memory.clear()


