# ------------------------------------------------------------
# 4. SMOOTHING FUNCTION
# ------------------------------------------------------------

def smooth_series(values, window=25):
    values = np.asarray(values, dtype=float)

    if len(values) < 2 or window <= 1:
        return values

    return (
        pd.Series(values)
        .rolling(
            window=min(window, len(values)),
            min_periods=1
        )
        .mean()
        .to_numpy()
    )


# ------------------------------------------------------------
# 5. GENERAL CONVERGENCE PLOT FUNCTION
# ------------------------------------------------------------

def plot_training_metric(
    metric_column,
    y_label,
    filename,
    user_count,
    use_smoothing=True
):
    fig, ax = plt.subplots(figsize=(10, 6.5))

    subset = TRAINING_HISTORY_DF[
        TRAINING_HISTORY_DF["user_count"] == user_count
    ]

