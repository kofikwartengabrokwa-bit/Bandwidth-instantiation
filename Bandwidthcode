def plot_metric(data, metric, users, output_dir):

    """
    Generate a four-model comparison figure.

    metric: 'reward' or 'loss'
    users: actual user load for the figure
    """

    output_dir.mkdir(parents=True, exist_ok=True)

    fig, ax = plt.subplots(figsize=(11, 7))

    plotted_models = 0

    # Explicit order ensures Ours appears first in the legend.
    for model in MODEL_ORDER:

        model_data = data[
            data["model"] == model
        ].copy()

        if model_data.empty:
            print(
                f"Missing model: {model}, "
                f"metric={metric}, users={users}"
            )
            continue

        # Combine multiple logged observations for the same
        # episode when multiple files contain that model/load.
        model_data = (
            model_data.groupby("episode", as_index=False)
            .agg(value=(metric, "mean"))
            .sort_values("episode")
        )

        model_data = model_data[
            np.isfinite(model_data["value"])
        ]

        if model_data.empty:
            continue

        x = model_data["episode"].to_numpy()
        y = model_data["value"].to_numpy()

        # AUTOMATIC USER COUNT IN LEGEND
        legend_label = get_legend_label(model, users)

        if PLOT_RAW_CURVES:

            ax.plot(
                x,
                y,
                linewidth=1.4,
                alpha=0.35,
                label="_nolegend_"
            )

            y_smooth = smooth_series(
                pd.Series(y),
                window=SMOOTH_WINDOW
            ).to_numpy()

            ax.plot(
                x,
                y_smooth,
                linewidth=2.8,
                label=legend_label
            )

        else:

            ax.plot(
                x,
                y,
                linewidth=2.6,
                label=legend_label
            )

        plotted_models += 1

    if plotted_models == 0:
        plt.close(fig)
        print(
            f"No valid {metric} data for {users} users."
        )
        return

    # Axis labels.
    ax.set_xlabel("Training Episode")

    if metric == "reward":
        ax.set_ylabel("Mean Episode Reward")

    elif metric == "loss":
        ax.set_ylabel("Training Loss")
        ax.set_ylim(bottom=0)

    ax.set_xlim(left=0)
    ax.margins(x=0.02)

    ax.grid(
        True,
        linestyle="--",
        alpha=0.30
    )

    # The legend now displays the actual user count.
    ax.legend(
        loc="best",
        frameon=True,
        ncol=1
    )

    fig.tight_layout()

    # File names automatically reflect the load.
    png_file = output_dir / f"{metric}_{users}_users.png"
    eps_file = output_dir / f"{metric}_{users}_users.eps"

    fig.savefig(
        png_file,
        dpi=DPI,
        bbox_inches="tight"
    )

    fig.savefig(
        eps_file,
        format="eps",
        dpi=DPI,
        bbox_inches="tight"
    )

    plt.close(fig)

    print(f"Saved PNG: {png_file}")
    print(f"Saved EPS: {eps_file}")


