            errors="replace"
        ) as file:
            lines = file.readlines()

    except OSError as exc:
        warnings.warn(f"Cannot read {log_file}: {exc}")
        continue

    for line_number, line in enumerate(lines, start=1):

        load_match = USER_LOAD_PATTERN.search(line)

        if load_match:
            current_users = int(load_match.group(1))

        algorithm_match = ALGORITHM_PATTERN.search(line)

        if algorithm_match:

            algorithm_name = algorithm_match.group(1).strip()
            recognized_model = identify_model(algorithm_name)

            # Update only when the algorithm is recognized.
            if recognized_model is not None:
                current_model = recognized_model

            current_users = int(algorithm_match.group(2))

        episode_match = EPISODE_PATTERN.search(line)

        if not episode_match:
            continue

        if current_model is None or current_users is None:
            continue

        records.append({
            "source_file": str(log_file),
            "line_number": line_number,
            "model": current_model,
            "users": current_users,
            "episode": int(episode_match.group(1)),
            "total_episodes": int(episode_match.group(2)),
            "reward": safe_float(episode_match.group(3)),
            "loss": safe_float(episode_match.group(4)),
            "epsilon": safe_float(episode_match.group(5)),
        })

