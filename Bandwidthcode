def allocate_users_by_profile(total_users):
    """Distribute users according to configured traffic proportions."""
    total_users = int(total_users)

    if total_users < 1:
        raise ValueError("total_users must be greater than zero.")

    exact_counts = (
        total_users * SLICE_WEIGHTS / SLICE_WEIGHTS.sum()
    )
    counts = np.floor(exact_counts).astype(int)
    remainder = total_users - counts.sum()

    if remainder > 0:
        order = np.argsort(-(exact_counts - counts))
        counts[order[:remainder]] += 1

    assert counts.sum() == total_users
    return counts


# ------------------------------------------------------------
# 3.4 SHARED ENVIRONMENT
# ------------------------------------------------------------
class RANSlicingEnvironment:
    """
    Shared custom RAN slicing environment.

    Action:
        Allocate the next RB to one of five traffic classes.

    Observation:
        Per-class user share, RB share, radio-quality proxy,
        demand share, remaining resources, and episode progress.

    Rate, latency, and energy are modeled estimates. They are not
    direct measurements of physical-layer performance.
    """

    def __init__(self, total_users, seed=SEED):
        self.total_users = int(total_users)
        self.seed = int(seed)
        self.rng = np.random.default_rng(self.seed)
        self.num_users_per_slice = allocate_users_by_profile(
            self.total_users
        )

        # 5 vectors of length NUM_SLICES plus 3 global scalars.
        self.state_dim = 5 * NUM_SLICES + 3
        self.action_dim = NUM_SLICES
        self.reset(seed=self.seed)

    def _sample_radio_conditions(self):
        idx = self.rng.integers(
            0, len(RADIO_MATRIX_NORM), size=NUM_SLICES
        )
        features = RADIO_MATRIX_NORM[idx]
        quality = RADIO_QUALITY_PROXY[idx]
        return features, quality

    def _get_state(self):
        user_share = (
            self.num_users_per_slice / max(self.total_users, 1)
        )
        rb_share = self.rb_allocation / TOTAL_RBS

        demand_share = user_share.copy()
        power_share = self.power_allocation_w / TOTAL_POWER_W

        state = np.concatenate([
            user_share,
            rb_share,
            self.radio_quality,
            demand_share,
            power_share,
            np.array([
                self.remaining_rbs / TOTAL_RBS,
                self.remaining_power_w / TOTAL_POWER_W,
                self.steps / MAX_STEPS_PER_EPISODE
            ])
        ]).astype(np.float32)

        if state.shape != (self.state_dim,):
            raise RuntimeError(
                f"Unexpected state shape {state.shape}; "
                f"expected {(self.state_dim,)}"
            )

        return state

    def reset(self, seed=None):
        if seed is not None:
            self.rng = np.random.default_rng(int(seed))

        self.steps = 0
        self.remaining_rbs = TOTAL_RBS
        self.remaining_power_w = TOTAL_POWER_W

        self.rb_allocation = np.zeros(
            NUM_SLICES, dtype=np.int32
        )
        self.power_allocation_w = np.zeros(
            NUM_SLICES, dtype=np.float64
        )

        self.radio_features, self.radio_quality = (
            self._sample_radio_conditions()
        )

        self.done = False
        return self._get_state()

    def _estimate_metrics(self):
        rb = self.rb_allocation.astype(np.float64)
        users = self.num_users_per_slice.astype(np.float64)

        rb_share = rb / TOTAL_RBS
        bandwidth_mhz = rb_share * TOTAL_BANDWIDTH_MHZ

        # Simplified rate model. Replace with calibrated SINR/MCS
        # mapping when the dataset's physical radio fields are verified.
        spectral_efficiency = 0.5 + 3.0 * self.radio_quality
        contention = np.maximum(
            users / MAX_USERS_PER_RB, 1.0
        )

        data_rate_mbps = (
            bandwidth_mhz * spectral_efficiency / contention
        )
        data_rate_mbps = np.where(
            rb > 0, data_rate_mbps, 0.0
        )

        # Simplified load-dependent latency model.
        base_latency_ms = np.array([
            2.0, 0.15, 20.0, 10.0, 0.5
        ])

        load_pressure = users / np.maximum(
            rb * MAX_USERS_PER_RB, 1.0
        )

        latency_ms = base_latency_ms * (
            1.0 + 4.0 * load_pressure
        )

        latency_ms = np.where(
            rb > 0,
            latency_ms,
            2.0 * SLICE_MAX_LATENCY
        )

        # Split the total 40-W power budget across allocated RBs.
        # Energy is reported for one modeled 1-ms interval.
        power_w = np.zeros(NUM_SLICES, dtype=np.float64)

        if rb.sum() > 0:
            power_w = TOTAL_POWER_W * rb / rb.sum()

        energy_j = power_w * SLOT_DURATION_S

        return {
            "data_rate_mbps": data_rate_mbps,
            "latency_ms": latency_ms,
            "power_w": power_w,
            "energy_j": energy_j,
            "bandwidth_mhz": bandwidth_mhz,
            "rb_allocation": rb.astype(int),
            "user_counts": users.astype(int)
        }

    def _calculate_reward(self):
        metrics = self._estimate_metrics()

        rate = metrics["data_rate_mbps"]
        latency = metrics["latency_ms"]

        target_satisfaction = np.clip(
            rate / np.maximum(SLICE_TARGET_RATE, NUMERICAL_EPS),
            0.0, 1.0
        )

        minimum_rate_satisfaction = np.clip(
            rate / np.maximum(SLICE_MIN_RATE, NUMERICAL_EPS),
            0.0, 1.0
        )

        latency_satisfaction = (
            latency <= SLICE_MAX_LATENCY
        ).astype(np.float64)

        reliability_weight = (
            SLICE_RELIABILITY / SLICE_RELIABILITY.max()
        )

        slice_reward = (
            0.50 * target_satisfaction
            + 0.25 * minimum_rate_satisfaction
            + 0.15 * latency_satisfaction
            + 0.10 * reliability_weight * target_satisfaction
        )

        reward = float(
            np.sum(NORMALIZED_PRIORITY * slice_reward)
            / np.sum(NORMALIZED_PRIORITY)
        )

        return reward, metrics

    def step(self, action):
        if self.done:
            raise RuntimeError(
                "Episode finished; call reset() before step()."
            )

        action = int(action)

        if not 0 <= action < NUM_SLICES:
            raise ValueError(
                f"Action must be between 0 and {NUM_SLICES - 1}."
            )

        if self.remaining_rbs <= 0:
            raise RuntimeError("No RBs remain to allocate.")

        # One action assigns exactly one RB to a slice.
        self.rb_allocation[action] += 1
        self.remaining_rbs -= 1
        self.steps += 1

        # The 40-W total power budget is fully distributed once
        # the first RB is assigned.
        if self.rb_allocation.sum() > 0:
            self.power_allocation_w = (
                TOTAL_POWER_W
                * self.rb_allocation
                / self.rb_allocation.sum()
            )
        else:
            self.power_allocation_w.fill(0.0)

        self.remaining_power_w = max(
            TOTAL_POWER_W - self.power_allocation_w.sum(), 0.0
        )

        reward, metrics = self._calculate_reward()

        self.done = (
            self.remaining_rbs == 0
            or self.steps >= MAX_STEPS_PER_EPISODE
        )

        next_state = self._get_state()

        info = {
            "metrics": metrics,
            "rb_allocation": self.rb_allocation.copy(),
            "power_allocation_w": self.power_allocation_w.copy(),
            "remaining_rbs": self.remaining_rbs
        }

        return next_state, reward, self.done, info


