def run_training_episode(env, agent, episode_seed, train=True):
    """
    Run one complete episode.

    Returns:
        episode_reward: cumulative episode reward
        mean_loss: mean optimization loss, or NaN if no update
        final_info: metrics from the final environment step
    """

    state = env.reset(seed=int(episode_seed))
    episode_reward = 0.0
    episode_losses = []
    done = False
    final_info = {}

    while not done:
        action = agent.select_action(
            state,
            env,
            explore=train
        )

        next_state, reward, done, info = env.step(action)

        if train:
            agent.remember(
                state,
                action,
                reward,
                next_state,
                done,
                env
            )

            # Reduce update frequency to limit training time.
            if (
                agent.steps >= AGENT_WARMUP_STEPS
                and agent.steps % LEARN_EVERY == 0
            ):
                loss = agent.optimize_model()

                if loss is not None and np.isfinite(loss):
                    episode_losses.append(float(loss))

        episode_reward += float(reward)
        state = next_state
        final_info = info

    mean_loss = (
        float(np.mean(episode_losses))
        if episode_losses else np.nan
    )

    return episode_reward, mean_loss, final_info


# ------------------------------------------------------------
# 4. HELPER: EXTRACT FINAL SLICE METRICS
# ------------------------------------------------------------

def extract_final_metrics(info):
    """
    Convert final environment metrics into a flat result row.
    Uses the metric names returned by RANSlicingEnvironment.
    """

    row = {}

    for metric_name in [
        "data_rate_mbps",
        "latency_ms",
        "energy_j",
        "rb_allocation",
        "bandwidth_mhz",
        "power_w"
    ]:
        if metric_name in info:
            values = np.asarray(info[metric_name]).reshape(-1)

            for slice_idx, slice_name in enumerate(SLICE_NAMES):
                if slice_idx < len(values):
                    row[f"{slice_name}_{metric_name}"] = float(
                        values[slice_idx]
                    )

    # Preserve additional scalar diagnostics, if present.
    for key, value in info.items():
        if key not in [
            "data_rate_mbps",
            "latency_ms",
            "energy_j",
            "rb_allocation",
            "bandwidth_mhz",
            "power_w"
        ]:
            if np.isscalar(value) and isinstance(
                value, (int, float, np.integer, np.floating)
            ):
                row[key] = float(value)

    return row


# ------------------------------------------------------------
# 5. HELPER: EVALUATE A TRAINED AGENT
# ------------------------------------------------------------

def evaluate_agent(agent, total_users, base_seed, num_episodes=20):
    """
    Evaluate without exploration or replay-buffer updates.
    The same evaluation seeds are reused across algorithms.
    """

    evaluation_rows = []

    for eval_episode in range(num_episodes):
        eval_seed = base_seed + 900000 + eval_episode

        eval_env = RANSlicingEnvironment(
