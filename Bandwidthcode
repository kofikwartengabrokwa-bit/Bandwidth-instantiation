def find_log_files(base_dir):
    """
    Find BIRL.tx, BIRL.txt, or similarly named training logs.
    Searches subdirectories recursively.
    """

    if not base_dir.exists():
        raise FileNotFoundError(
            f"Project directory does not exist: {base_dir}"
        )

    supported_extensions = {".tx", ".txt", ".log", ".out"}

    candidates = []

    for path in base_dir.rglob("*"):

        if not path.is_file():
            continue

        if OUTPUT_DIR in path.parents:
            continue

        if path.suffix.lower() not in supported_extensions:
            continue

        # Include files whose names contain BIRL.
        if "birl" in path.stem.lower():
            candidates.append(path)

    # If no BIRL-named file exists, search other supported logs.
    if not candidates and SEARCH_ALL_BIRL_FILES:

        print(
            "\nNo BIRL-named file found. "
            "Searching other supported text logs..."
        )

        candidates = [
            p for p in base_dir.rglob("*")
            if p.is_file()
            and p.suffix.lower() in supported_extensions
            and OUTPUT_DIR not in p.parents
        ]

    # Exclude virtual environments and generated output folders.
    excluded_parts = {
        "venv",
        ".venv",
        "__pycache__",
        ".git",
        "site-packages",
    }

    candidates = [
        p for p in candidates
        if not any(part.lower() in excluded_parts
                   for part in p.parts)
    ]

    # Prefer BIRL-named files if any exist.
    birl_candidates = [
        p for p in candidates
        if "birl" in p.stem.lower()
    ]

    if birl_candidates:
        candidates = birl_candidates

    return sorted(set(candidates))


