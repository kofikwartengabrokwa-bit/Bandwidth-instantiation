# ------------------------------------------------------------
# 4.2 EXPERIENCE REPLAY BUFFER
# ------------------------------------------------------------
class ReplayBuffer:
    """Stores state-transition experiences for off-policy DDQN."""

    def __init__(self, capacity=REPLAY_CAPACITY, seed=SEED):
        self.buffer = deque(maxlen=int(capacity))
        self.rng = random.Random(seed)

    def push(self, state, action, reward, next_state, done):
        self.buffer.append((
            np.asarray(state, dtype=np.float32).copy(),
            int(action),
            float(reward),
            np.asarray(next_state, dtype=np.float32).copy(),
            float(done)
        ))

    def sample(self, batch_size):
        if len(self.buffer) < batch_size:
            raise ValueError(
                f"Need {batch_size} transitions; "
                f"buffer currently contains {len(self.buffer)}."
            )

        batch = self.rng.sample(list(self.buffer), batch_size)

        states, actions, rewards, next_states, dones = zip(*batch)

        return (
            np.stack(states).astype(np.float32),
            np.asarray(actions, dtype=np.int64),
            np.asarray(rewards, dtype=np.float32),
            np.stack(next_states).astype(np.float32),
            np.asarray(dones, dtype=np.float32)
        )

    def __len__(self):
        return len(self.buffer)


# ------------------------------------------------------------
# 4.3 STANDARD DDQN MLP
# ------------------------------------------------------------
class DDQNNetwork(nn.Module):
    """Baseline MLP Q-network."""

    def __init__(
        self,
        state_dim=STATE_DIM,
        action_dim=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM
    ):
        super().__init__()

        self.network = nn.Sequential(
            nn.Linear(state_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, action_dim)
        )

    def forward(self, state):
        return self.network(state)


# ------------------------------------------------------------
# 4.4 GRAPH STRUCTURE FOR GCN/GGN ENCODERS
# ------------------------------------------------------------
def build_slice_adjacency():
    """
    Construct a fixed undirected slice-interaction graph.

    eMBB, uRLLC, and Vehicular have stronger modeled interactions
    with one another because their service allocations compete
    for the same radio-resource pool. Every slice also has a
    self-loop.

    This is a configured interaction graph, not a graph learned
    from the database.
    """
    adjacency = np.eye(NUM_SLICES, dtype=np.float32)

    edges = [
        (0, 1),  # eMBB <-> uRLLC
        (0, 4),  # eMBB <-> Vehicular
        (1, 4),  # uRLLC <-> Vehicular
        (0, 2),  # eMBB <-> MTM
        (2, 3),  # MTM <-> IoT
        (3, 4),  # IoT <-> Vehicular
        (1, 3)   # uRLLC <-> IoT
    ]

    for i, j in edges:
        adjacency[i, j] = 1.0
        adjacency[j, i] = 1.0

    degree = adjacency.sum(axis=1)
    inv_sqrt_degree = 1.0 / np.sqrt(np.maximum(degree, 1.0))

    normalized = (
        inv_sqrt_degree[:, None]
        * adjacency
        * inv_sqrt_degree[None, :]
    )

    return torch.tensor(normalized, dtype=torch.float32)


SLICE_ADJACENCY = build_slice_adjacency().to(DEVICE)


# ------------------------------------------------------------
# 4.5 STATE-TO-GRAPH CONVERSION
# ------------------------------------------------------------
def state_to_slice_nodes(state):
    """
    Convert the environment observation into five slice nodes.

    Block 3's state contains:
      [user share, RB share, radio quality, demand share,
       power share] for each of the five slices, followed by
       three global scalars.

    Returns a matrix with shape (batch, number_of_slices, 5).
    """
    if state.ndim == 1:
        state = state.unsqueeze(0)

    batch_size = state.shape[0]
    expected_dim = 5 * NUM_SLICES + 3

    if state.shape[1] != expected_dim:
        raise ValueError(
            f"Expected state dimension {expected_dim}, "
            f"received {state.shape[1]}."
        )

    per_slice = state[:, :5 * NUM_SLICES].reshape(
        batch_size, 5, NUM_SLICES
    )

    node_features = per_slice.transpose(1, 2).contiguous()

    return node_features


# ------------------------------------------------------------
# 4.6 GCN-DDQN NETWORK
# ------------------------------------------------------------
class GCNLayer(nn.Module):
    """One normalized graph-convolution layer."""

    def __init__(self, input_dim, output_dim):
        super().__init__()
        self.linear = nn.Linear(input_dim, output_dim)

    def forward(self, node_features, adjacency):
        # node_features: batch x nodes x feature_dim
        aggregated = torch.matmul(adjacency, node_features)
        return torch.relu(self.linear(aggregated))


class GCNDDQNNetwork(nn.Module):
    """Graph-convolution encoder followed by a Q-value head."""

    def __init__(
        self,
        action_dim=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM
    ):
        super().__init__()

        self.gcn1 = GCNLayer(5, hidden_dim)
        self.gcn2 = GCNLayer(hidden_dim, hidden_dim)

        # Five node embeddings are pooled into one state embedding.
        self.q_head = nn.Sequential(
            nn.Linear(hidden_dim + 3, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, action_dim)
        )

    def forward(self, state):
        if state.ndim == 1:
            state = state.unsqueeze(0)

        node_features = state_to_slice_nodes(state)

        node_embeddings = self.gcn1(
            node_features, SLICE_ADJACENCY
        )
        node_embeddings = self.gcn2(
            node_embeddings, SLICE_ADJACENCY
        )

        pooled = node_embeddings.mean(dim=1)
        global_features = state[:, 5 * NUM_SLICES:]

        combined = torch.cat(
            [pooled, global_features], dim=1
        )

        return self.q_head(combined)


# ------------------------------------------------------------
# 4.7 GGN-DDQN NETWORK
# ------------------------------------------------------------
class GatedGraphLayer(nn.Module):
    """
    Gated message-passing layer.

    The graph neighborhood produces a message for each slice;
    a learned gate controls how much of that message updates
    the current node representation.
    """

    def __init__(self, input_dim, hidden_dim):
        super().__init__()

        self.message_linear = nn.Linear(
            input_dim, hidden_dim
        )
        self.self_linear = nn.Linear(
            input_dim, hidden_dim
        )
        self.gate_linear = nn.Linear(
            2 * hidden_dim, hidden_dim
        )

    def forward(self, node_features, adjacency):
        neighbors = torch.matmul(
            adjacency, node_features
        )

        message = torch.tanh(
            self.message_linear(neighbors)
        )

        self_information = torch.tanh(
            self.self_linear(node_features)
        )

        gate = torch.sigmoid(
            self.gate_linear(
                torch.cat([message, self_information], dim=-1)
            )
        )

        return gate * message + (1.0 - gate) * self_information


class GGNDDQNNetwork(nn.Module):
    """Gated graph-neural-network encoder with DDQN Q-values."""

    def __init__(
        self,
        action_dim=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM
    ):
        super().__init__()

        self.input_linear = nn.Linear(5, hidden_dim)
        self.ggn1 = GatedGraphLayer(hidden_dim, hidden_dim)
        self.ggn2 = GatedGraphLayer(hidden_dim, hidden_dim)

        self.q_head = nn.Sequential(
            nn.Linear(hidden_dim + 3, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, action_dim)
        )

    def forward(self, state):
        if state.ndim == 1:
            state = state.unsqueeze(0)

        node_features = state_to_slice_nodes(state)
        node_features = torch.relu(
            self.input_linear(node_features)
        )

        node_embeddings = self.ggn1(
            node_features, SLICE_ADJACENCY
        )
        node_embeddings = self.ggn2(
            node_embeddings, SLICE_ADJACENCY
        )

        pooled = node_embeddings.mean(dim=1)
        global_features = state[:, 5 * NUM_SLICES:]

        combined = torch.cat(
            [pooled, global_features], dim=1
        )

        return self.q_head(combined)


# ------------------------------------------------------------
# 4.8 RBF STATE ENCODER FOR OUR METHOD
# ------------------------------------------------------------
class RBFStateEncoder(nn.Module):
    """
    Gaussian RBF state encoder.

    Centers are initialized from sampled training states in
    the next block. This class supports either fixed centers
    or trainable centers.
    """

    def __init__(
        self,
        input_dim=STATE_DIM,
        num_centers=RBF_NUM_CENTERS,
        sigma=RBF_SIGMA,
        trainable_centers=False
    ):
        super().__init__()

        self.input_dim = int(input_dim)
        self.num_centers = int(num_centers)
        self.sigma = sigma

        self.centers = nn.Parameter(
            torch.zeros(num_centers, input_dim),
            requires_grad=trainable_centers
        )

        self.output_dim = num_centers

    def initialize_centers(self, state_samples):
        """
        Initialize centers from observed states.

        state_samples: NumPy array with shape (N, input_dim).
        """
        state_samples = np.asarray(
            state_samples, dtype=np.float32
        )

        if state_samples.ndim != 2:
            raise ValueError(
                "state_samples must be a two-dimensional array."
            )

        if state_samples.shape[1] != self.input_dim:
            raise ValueError(
                f"Expected {self.input_dim} state features; "
                f"received {state_samples.shape[1]}."
            )

        rng = np.random.default_rng(SEED)

        if len(state_samples) >= self.num_centers:
            indices = rng.choice(
                len(state_samples),
                size=self.num_centers,
                replace=False
            )
        else:
            indices = rng.choice(
                len(state_samples),
                size=self.num_centers,
                replace=True
            )

        center_values = state_samples[indices]

        with torch.no_grad():
            self.centers.copy_(
                torch.as_tensor(
                    center_values,
                    dtype=torch.float32,
                    device=self.centers.device
                )
            )

        # Estimate width from the median positive pairwise
        # center distance, unless sigma was configured explicitly.
        if self.sigma is None:
            center_tensor = self.centers.detach()
            distances = torch.cdist(
                center_tensor, center_tensor, p=2
            )

            positive_distances = distances[
                distances > RBF_EPS
            ]

            if positive_distances.numel() > 0:
                estimated_sigma = torch.median(
                    positive_distances
                ).item()
            else:
                estimated_sigma = 1.0

            self.sigma = max(
                float(estimated_sigma), 1e-3
            )

        return self

    def forward(self, state):
        if state.ndim == 1:
            state = state.unsqueeze(0)

        distances_sq = torch.sum(
            (
                state.unsqueeze(1)
                - self.centers.unsqueeze(0)
            ) ** 2,
            dim=2
        )

        width = max(float(self.sigma or 1.0), 1e-3)

        return torch.exp(
            -distances_sq / (2.0 * width ** 2)
        )


class RBFEdgeCoverDDQNNetwork(nn.Module):
    """RBF feature map followed by a DDQN Q-value head."""

    def __init__(
        self,
        state_dim=STATE_DIM,
        action_dim=NUM_ACTIONS,
        hidden_dim=HIDDEN_DIM,
        num_centers=RBF_NUM_CENTERS
    ):
        super().__init__()

        self.encoder = RBFStateEncoder(
            input_dim=state_dim,
            num_centers=num_centers,
            sigma=RBF_SIGMA,
            trainable_centers=False
        )

        self.q_head = nn.Sequential(
            nn.Linear(num_centers, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, action_dim)
        )

    def initialize_centers(self, state_samples):
        self.encoder.initialize_centers(state_samples)
        return self

    def forward(self, state):
        features = self.encoder(state)
        return self.q_head(features)


# ------------------------------------------------------------
# 4.9 NETWORK FACTORY
# ------------------------------------------------------------
def create_q_network(algorithm):
    """
    Return an uninitialized algorithm-specific Q-network.
    The RBF centers for Ours must be initialized from states
    before meaningful training.
    """
    if algorithm == "DDQN":
        model = DDQNNetwork()

    elif algorithm == "GCN-DDQN":
        model = GCNDDQNNetwork()

    elif algorithm == "GGN-DDQN":
        model = GGNDDQNNetwork()

    elif algorithm == "RBF-EdgeCover-DDQN":
        model = RBFEdgeCoverDDQNNetwork()

    else:
        raise ValueError(
            f"Unknown algorithm: {algorithm}"
        )

    return model.to(DEVICE)


