def find_log_files(base_dir):
    """
    Search recursively for BIRL.tx, BIRL.txt, BIRL.log,
    and similarly named files. If none are found, search
    other supported text logs in the project directory.
    """

    if not base_dir.exists():
        raise FileNotFoundError(
            f"Project directory does not exist: {base_dir}"
        )

    extensions = {".tx", ".txt", ".log", ".out"}

    excluded_parts = {
        "venv",
        ".venv",
        "__pycache__",
        ".git",
        "site-packages",
    }

    all_files = []

    for path in base_dir.rglob("*"):

        if not path.is_file():
            continue

        if path.suffix.lower() not in extensions:
            continue

        if OUTPUT_DIR in path.parents:
            continue

        if any(
            part.lower() in excluded_parts
            for part in path.parts
        ):
            continue

        all_files.append(path)

    birl_files = [
        path for path in all_files
        if "birl" in path.stem.lower()
    ]

    return sorted(birl_files if birl_files else all_files)


