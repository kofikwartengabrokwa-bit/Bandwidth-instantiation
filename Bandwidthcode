def smooth_series(series, window=25):
    """
    Trailing moving average for optional visualization.
    Original extracted statistics are never modified.
    """

    series = pd.to_numeric(series, errors="coerce")

    return series.rolling(
        window=window,
        min_periods=1
    ).mean()


