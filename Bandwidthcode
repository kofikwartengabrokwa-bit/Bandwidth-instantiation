def get_legend_label(model, users):
    """
    Automatically add the number of users to the model label.

    Example:
        Ours (100 users)
        GGN-DDQN (100 users)
    """

    if INCLUDE_USER_COUNT_IN_LEGEND:
        return f"{model} ({int(users)} users)"

    return model


