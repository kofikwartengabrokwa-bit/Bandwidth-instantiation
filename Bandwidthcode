        )

        row = {
            "user_count": total_users,
            "evaluation_episode": eval_episode + 1,
            "episode_reward": episode_reward
        }

        row.update(extract_final_metrics(final_info))
        evaluation_rows.append(row)

    return pd.DataFrame(evaluation_rows)


