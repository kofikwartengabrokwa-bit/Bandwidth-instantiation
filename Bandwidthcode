def smooth_series(series, window=25):
    """
    Apply a trailing moving average.

    NaN values remain missing and are not treated as zero.
    The raw extracted data remains unchanged.
    """

    series = pd.to_numeric(series, errors="coerce")

    return series.rolling(
        window=window,
        min_periods=1
    ).mean()


# ============================================================
# BLOCK 8: PLOTTING FUNCTION
# ============================================================

def plot_metric(data, metric, users, output_dir):
    """
    Plot one metric for all models at a specified user load.

    metric: reward or loss
    users: number of users, or None for all-load comparison
    """

    fig, ax = plt.subplots(figsize=(11, 7))

    plotted_models = 0

    for model in MODEL_ORDER:

        model_data = data[data["model"] == model].copy()

        if model_data.empty:
            continue

        # If several log files contain the same model, load, and
        # episode, average duplicate episode observations.
        model_data = (
            model_data.groupby("episode", as_index=False)
            .agg(
                value=(metric, "mean")
            )
            .sort_values("episode")
        )

        model_data = model_data[
            np.isfinite(model_data["value"])
        ]

        if model_data.empty:
            print(
                f"Skipping {model}: no valid {metric} values "
                f"for user load {users}."
            )
            continue

        x = model_data["episode"].to_numpy()
        y = model_data["value"].to_numpy()

        # Ours is deliberately plotted first in the legend.
        ax.plot(
            x,
            y,
            linewidth=2.3,
            label=model,
            alpha=0.30 if PLOT_RAW_CURVES else 1.0
        )

        if PLOT_RAW_CURVES:
            smoothed = smooth_series(
                pd.Series(y),
                window=SMOOTH_WINDOW
            )

            ax.plot(
                x,
                smoothed.to_numpy(),
                linewidth=2.8,
                label=f"{model} (smoothed)"
            )

        plotted_models += 1

    if plotted_models == 0:
        plt.close(fig)
        print(
            f"No valid data to plot for {metric}, users={users}."
        )
        return

    ax.set_xlabel("Training Episode")

    if metric == "reward":
        ax.set_ylabel("Mean Episode Reward")
    elif metric == "loss":
        ax.set_ylabel("Training Loss")

        # Loss should not have a negative axis range.
        ax.set_ylim(bottom=0)

    if users is None:
        suffix = "all_loads"
        ax.set_xlabel("Training Episode (mean across user loads)")
    else:
        suffix = f"{users}_users"

    ax.set_xlim(left=0)
    ax.margins(x=0.02)

    ax.grid(
        True,
        linestyle="--",
        alpha=0.30
    )

    ax.legend(
        loc="best",
        frameon=True,
        ncol=1
    )

    fig.tight_layout()

    # Save both publication-quality EPS and PNG.
    png_file = output_dir / f"{metric}_{suffix}.png"
    eps_file = output_dir / f"{metric}_{suffix}.eps"

    fig.savefig(
        png_file,
        dpi=DPI,
        bbox_inches="tight"
    )

    fig.savefig(
        eps_file,
        format="eps",
        dpi=DPI,
        bbox_inches="tight"
    )

    plt.close(fig)

    print(f"Saved: {png_file}")
    print(f"Saved: {eps_file}")


