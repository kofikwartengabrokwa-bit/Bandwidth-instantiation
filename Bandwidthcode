print("\n" + "=" * 80)
print("RELATIVE IMPROVEMENT OF OURS OVER THE BEST BASELINE")
print("=" * 80)

if not improvement_df.empty:
    print(
        improvement_df[
            [
                "user_count",
                "metric",
                "best_baseline",
                "relative_improvement_percent",
            ]
        ].to_string(index=False, float_format=lambda x: f"{x:.2f}")
    )
else:
    print("No comparable proposed-algorithm results were found.")

