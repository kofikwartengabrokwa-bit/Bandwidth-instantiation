    for algorithm in ALGORITHM_ORDER:

        algorithm_data = (
            subset[subset["algorithm"] == algorithm]
            .sort_values("episode")
        )

        if algorithm_data.empty:
            continue

        x = algorithm_data["episode"].to_numpy()
        y = pd.to_numeric(
            algorithm_data[metric_column],
            errors="coerce"
        ).to_numpy(dtype=float)

        valid = np.isfinite(y)
        x = x[valid]
        y = y[valid]

        if len(y) == 0:
            continue

        if use_smoothing:
            y = smooth_series(y, SMOOTH_WINDOW)

        marker, linestyle = LINE_STYLES[algorithm]

        ax.plot(
            x,
            y,
            linestyle=linestyle,
            marker=marker,
            markevery=max(1, len(x) // 12),
            label=ALGORITHM_LABELS.get(algorithm, algorithm)
        )

        plotted_any = True

    if not plotted_any:
        plt.close(fig)
