# ------------------------------------------------------------
# 5.2 EDGE-COVER-INSPIRED CANDIDATE ACTIONS
# ------------------------------------------------------------
def edge_cover_candidate_actions(env):
    """
    Return eligible traffic-slice actions for RBF-EdgeCover-DDQN.

    Stage 1:
        Prefer slices that have not received any RB, improving
        initial resource coverage across traffic classes.

    Stage 2:
        Prefer slices that have not met their modeled minimum
        rate or maximum latency requirements.

    Stage 3:
        If no slice violates these modeled conditions, retain
        all slice actions as candidates.

    This is a demand-aware heuristic. It is not an exact graph
    edge-cover algorithm or a guarantee of QoS feasibility.
    """
    if env.remaining_rbs <= 0:
        return np.ones(NUM_SLICES, dtype=bool)

    # Ensure every slice can become represented in the allocation.
    uncovered = env.rb_allocation == 0

    if uncovered.any():
        return uncovered.astype(bool)

    metrics = env._estimate_metrics()

    rate = metrics["data_rate_mbps"]
    latency = metrics["latency_ms"]

    below_minimum_rate = rate < SLICE_MIN_RATE
    latency_violation = latency > SLICE_MAX_LATENCY

    # Include slices with unmet demand or a QoS violation.
    eligible = below_minimum_rate | latency_violation

    if not eligible.any():
        eligible = np.ones(NUM_SLICES, dtype=bool)

    # When RBs are scarce, restrict candidates to the slices
    # with the largest normalized service deficits.
    rate_deficit = np.clip(
        (SLICE_MIN_RATE - rate)
        / np.maximum(SLICE_MIN_RATE, NUMERICAL_EPS),
        0.0,
        1.0
    )

    latency_deficit = np.clip(
        (latency - SLICE_MAX_LATENCY)
        / np.maximum(SLICE_MAX_LATENCY, NUMERICAL_EPS),
        0.0,
        1.0
    )

    deficit_score = (
        0.65 * rate_deficit
        + 0.35 * latency_deficit
    ) * NORMALIZED_PRIORITY

    # Keep at least one valid action.
    if not eligible.any():
        eligible[np.argmax(deficit_score)] = True

    return eligible.astype(bool)


def all_action_candidates(env):
    """All five actions are eligible for the baseline algorithms."""
    return np.ones(NUM_SLICES, dtype=bool)


# ------------------------------------------------------------
# 5.3 REPLAY BUFFER WITH NEXT-ACTION MASKS
# ------------------------------------------------------------
class MaskedReplayBuffer:
    """
    Stores transitions and the candidate-action mask for the
    next state. This permits masked Double-DQN next-action
    selection for the proposed method.
    """

    def __init__(self, capacity=AGENT_REPLAY_CAPACITY, seed=AGENT_SEED):
        self.buffer = deque(maxlen=int(capacity))
        self.rng = random.Random(seed)

    def push(
        self, state, action, reward, next_state, done, next_mask
    ):
        state = np.asarray(state, dtype=np.float32).copy()
        next_state = np.asarray(next_state, dtype=np.float32).copy()
        next_mask = np.asarray(next_mask, dtype=bool).copy()

        if next_mask.shape != (NUM_ACTIONS,):
            raise ValueError(
                f"Invalid action-mask shape: {next_mask.shape}"
            )

        # Every nonterminal next state must have at least one
        # eligible action.
        if not bool(next_mask.any()):
            raise ValueError("Next-state action mask has no valid actions.")

        self.buffer.append((
            state,
            int(action),
            float(reward),
            next_state,
            float(done),
            next_mask
        ))

    def sample(self, batch_size):
        if len(self.buffer) < batch_size:
            raise ValueError(
                f"Need {batch_size} transitions; "
                f"buffer has {len(self.buffer)}."
            )

        batch = self.rng.sample(list(self.buffer), batch_size)

        states, actions, rewards, next_states, dones, masks = zip(
            *batch
        )

        return (
            np.stack(states).astype(np.float32),
            np.asarray(actions, dtype=np.int64),
            np.asarray(rewards, dtype=np.float32),
            np.stack(next_states).astype(np.float32),
            np.asarray(dones, dtype=np.float32),
            np.stack(masks).astype(bool)
        )

    def __len__(self):
        return len(self.buffer)


# ------------------------------------------------------------
# 5.4 DOUBLE DQN AGENT
# ------------------------------------------------------------
class DDQNAgent:
    """
    Double DQN agent with:
      - online Q-network,
      - target Q-network,
      - epsilon-greedy exploration,
      - experience replay,
      - gradient clipping,
      - optional RBF/edge-cover behavior.

    All algorithms use the same optimization procedure.
    """

    def __init__(
        self,
        algorithm,
        state_dim=STATE_DIM,
        action_dim=NUM_ACTIONS,
        seed=AGENT_SEED,
        rbf_state_samples=None
    ):
        self.algorithm = algorithm
        self.state_dim = int(state_dim)
        self.action_dim = int(action_dim)
        self.device = AGENT_DEVICE
        self.rng = np.random.default_rng(seed)
        self.steps = 0
        self.learn_steps = 0

        random.seed(seed)
        torch.manual_seed(seed)

        self.online_net = create_q_network(
            algorithm
        ).to(self.device)

        # Initialize the RBF centers using states sampled from
        # the environment, rather than leaving them at zero.
        if algorithm == "RBF-EdgeCover-DDQN":
            if rbf_state_samples is None:
                raise ValueError(
                    "RBF-EdgeCover-DDQN requires rbf_state_samples."
                )

            self.online_net.initialize_centers(
                rbf_state_samples
            )

        self.target_net = copy.deepcopy(
            self.online_net
        ).to(self.device)

        self.target_net.eval()

        for parameter in self.target_net.parameters():
            parameter.requires_grad = False

        self.optimizer = optim.Adam(
            self.online_net.parameters(),
            lr=AGENT_LR
        )

        self.loss_function = nn.SmoothL1Loss()

        self.replay_buffer = MaskedReplayBuffer(
            capacity=AGENT_REPLAY_CAPACITY,
            seed=seed
        )

    def epsilon(self):
        """Exponential epsilon decay based on environment steps."""
        return AGENT_EPSILON_END + (
            AGENT_EPSILON_START - AGENT_EPSILON_END
        ) * np.exp(-self.steps / AGENT_EPSILON_DECAY)

    def candidate_mask(self, env):
        if self.algorithm == "RBF-EdgeCover-DDQN":
            return edge_cover_candidate_actions(env)

        return all_action_candidates(env)

    def select_action(self, state, env, explore=True):
        """
        Select an action from the current candidate set.

        Exploration and exploitation both respect the proposed
        method's action-candidate filter.
        """
        mask = self.candidate_mask(env)
        valid_actions = np.flatnonzero(mask)

        if len(valid_actions) == 0:
            valid_actions = np.arange(self.action_dim)

        epsilon = self.epsilon() if explore else 0.0

        if explore and self.rng.random() < epsilon:
            action = int(self.rng.choice(valid_actions))
        else:
            state_tensor = torch.as_tensor(
                state,
                dtype=torch.float32,
                device=self.device
            ).unsqueeze(0)

            self.online_net.eval()

            with torch.no_grad():
                q_values = self.online_net(state_tensor)[0].cpu().numpy()

            self.online_net.train()

            # Exclude actions outside the candidate set.
            q_values[~mask] = -np.inf
            action = int(np.argmax(q_values))

        if explore:
            self.steps += 1

        return action

    def remember(
        self, state, action, reward, next_state, done, env_after_step
    ):
        next_mask = self.candidate_mask(env_after_step)

        self.replay_buffer.push(
            state,
            action,
            reward,
            next_state,
            done,
            next_mask
        )

    def optimize_model(self):
        """Perform one Double-DQN optimization update."""
        if len(self.replay_buffer) < max(
            AGENT_BATCH_SIZE, AGENT_WARMUP_STEPS
        ):
            return None

        (
            states,
            actions,
            rewards,
            next_states,
            dones,
            next_masks
        ) = self.replay_buffer.sample(AGENT_BATCH_SIZE)

        states_t = torch.as_tensor(
            states, dtype=torch.float32, device=self.device
        )
        actions_t = torch.as_tensor(
            actions, dtype=torch.int64, device=self.device
        ).unsqueeze(1)
        rewards_t = torch.as_tensor(
            rewards, dtype=torch.float32, device=self.device
        )
        next_states_t = torch.as_tensor(
            next_states, dtype=torch.float32, device=self.device
        )
        dones_t = torch.as_tensor(
            dones, dtype=torch.float32, device=self.device
        )
        next_masks_t = torch.as_tensor(
            next_masks, dtype=torch.bool, device=self.device
        )

        # Q(s,a) from the online network.
        current_q = self.online_net(states_t).gather(
            1, actions_t
        ).squeeze(1)

        with torch.no_grad():
            # Double DQN: the online network selects the next action.
            online_next_q = self.online_net(next_states_t)

            # Apply candidate-action constraints for Ours.
            online_next_q = online_next_q.masked_fill(
                ~next_masks_t, -1e9
            )

            next_actions = online_next_q.argmax(
                dim=1, keepdim=True
            )

            # The target network evaluates the selected action.
            target_next_q = self.target_net(
                next_states_t
            ).gather(1, next_actions).squeeze(1)

            target_q = rewards_t + (
                AGENT_GAMMA
                * (1.0 - dones_t)
                * target_next_q
            )

        loss = self.loss_function(current_q, target_q)

        self.optimizer.zero_grad(set_to_none=True)
        loss.backward()

        nn.utils.clip_grad_norm_(
            self.online_net.parameters(),
            AGENT_GRAD_CLIP
        )

        self.optimizer.step()
        self.learn_steps += 1

        if self.learn_steps % AGENT_TARGET_UPDATE == 0:
            self.target_net.load_state_dict(
                self.online_net.state_dict()
            )

        return float(loss.item())


# ------------------------------------------------------------
# 5.5 INITIALIZE RBF CENTERS FROM ENVIRONMENT STATES
# ------------------------------------------------------------

def collect_initial_states(
    number_of_states=256,
    total_users=100,
    seed=AGENT_SEED
):
    """
    Collect states by taking random actions in the environment.
    These states are used only to initialize the RBF centers
    before agent training.
    """
    rng = np.random.default_rng(seed)

    # Reuse the supplied environment or create a new one.
    if isinstance(total_users, RANSlicingEnvironment):
        env = total_users
    else:
        env = RANSlicingEnvironment(
            total_users=int(total_users),
            seed=seed
        )

    collected = []

    while len(collected) < number_of_states:
        reset_result = env.reset(
            seed=int(rng.integers(0, 2**31 - 1))
        )

        # Support Gymnasium and traditional Gym reset formats.
        state = (
            reset_result[0]
            if isinstance(reset_result, tuple)
            else reset_result
        )

        collected.append(np.asarray(state).copy())

        done = False

        while not done and len(collected) < number_of_states:
            action = int(rng.integers(0, NUM_ACTIONS))
            step_result = env.step(action)

            # Support Gymnasium (5 values) and Gym (4 values).
            if len(step_result) == 5:
                state, _, terminated, truncated, _ = step_result
                done = terminated or truncated
            else:
                state, _, done, _ = step_result

            collected.append(np.asarray(state).copy())

    return np.asarray(
        collected[:number_of_states],
        dtype=np.float32
    )



