    if "loss" in metric_column.lower():
        ax.set_ylim(bottom=0)

    fig.tight_layout()

    png_path = PLOT_DIR / filename.replace(".eps", ".png")
    eps_path = PLOT_DIR / filename

    fig.savefig(
        png_path,
        dpi=600,
        bbox_inches="tight"
    )

