import os
import numpy as np
import pandas as pd

# ------------------------------------------------------------
# 1. PATHS AND CONFIGURATION
# ------------------------------------------------------------
RESULT_DIR = (
    r"E:\Abrokwa\PycharmProjects\pythonProject1"
    r"\pythonProject3\results\RBF_EdgeCover_DDQN"
)
CSV_DIR = os.path.join(RESULT_DIR, "csv")
os.makedirs(CSV_DIR, exist_ok=True)

RESULT_FILE = os.path.join(CSV_DIR, "evaluation_results.csv")

if not os.path.exists(RESULT_FILE):
    raise FileNotFoundError(
        f"Missing file: {RESULT_FILE}\n"
        "Run Block 6 successfully before executing Block 11."
    )

df = pd.read_csv(RESULT_FILE)

required_columns = {"algorithm", "user_count"}
missing = required_columns - set(df.columns)

if missing:
    raise ValueError(f"Missing required columns: {sorted(missing)}")

# Use manuscript terminology for the proposed algorithm.
df["algorithm"] = df["algorithm"].replace({
    "RBF-EdgeCover-DDQN": "Ours"
})

print("=" * 80)
print("FINAL RESULTS REPORT")
print("=" * 80)
print(f"Evaluation records: {len(df)}")
print(f"Algorithms: {df['algorithm'].unique().tolist()}")
print(f"User loads: {sorted(df['user_count'].dropna().unique().tolist())}")

# ------------------------------------------------------------
# 2. METRIC DEFINITIONS
# ------------------------------------------------------------
metric_directions = {
    "episode_reward": "max",
    "eMBB_data_rate_mbps": "max",
    "uRLLC_data_rate_mbps": "max",
    "eMBB_latency_ms": "min",
    "uRLLC_latency_ms": "min",
    "eMBB_energy_j": "min",
    "uRLLC_energy_j": "min",
    "eMBB_rb_allocation": None,
    "uRLLC_rb_allocation": None,
    "eMBB_bandwidth_mhz": None,
    "uRLLC_bandwidth_mhz": None,
    "eMBB_power_w": "min",
    "uRLLC_power_w": "min",
}

available_metrics = [
    metric for metric in metric_directions
    if metric in df.columns
]

if not available_metrics:
    raise ValueError(
        "No recognized evaluation metrics were found. "
        "Inspect evaluation_results.csv and update metric_directions."
    )

# ------------------------------------------------------------
# 3. SUMMARY BY USER LOAD AND ALGORITHM
# ------------------------------------------------------------
group_columns = ["user_count", "algorithm"]

summary = (
    df.groupby(group_columns)[available_metrics]
      .agg(["mean", "std"])
      .reset_index()
)

# Flatten the multi-level column names.
summary.columns = [
    "_".join(str(part) for part in col if str(part))
    if isinstance(col, tuple) else str(col)
    for col in summary.columns
]

summary_file = os.path.join(CSV_DIR, "final_results_by_load.csv")
summary.to_csv(summary_file, index=False)

print("\nSaved per-load summary:")
print(summary_file)

# ------------------------------------------------------------
# 4. IDENTIFY THE BEST ALGORITHM FOR EACH METRIC AND LOAD
# ------------------------------------------------------------
ranking_rows = []

for user_count in sorted(df["user_count"].dropna().unique()):
    subset = df[df["user_count"] == user_count]

    for metric in available_metrics:
        direction = metric_directions[metric]

        # RB and bandwidth allocation are descriptive metrics;
        # they are not ranked as universally better or worse.
        if direction is None:
            continue

        means = subset.groupby("algorithm")[metric].mean().dropna()

        if means.empty:
            continue

        best_algorithm = (
            means.idxmax() if direction == "max" else means.idxmin()
        )

        ranking_rows.append({
            "user_count": user_count,
            "metric": metric,
            "best_algorithm": best_algorithm,
            "best_mean": means.loc[best_algorithm],
            "direction": direction,
        })

ranking = pd.DataFrame(ranking_rows)
ranking_file = os.path.join(CSV_DIR, "best_algorithm_by_metric.csv")
ranking.to_csv(ranking_file, index=False)

# ------------------------------------------------------------
# 5. RELATIVE IMPROVEMENT OF OURS OVER THE BEST BASELINE
# ------------------------------------------------------------
improvement_rows = []

for user_count in sorted(df["user_count"].dropna().unique()):
    subset = df[df["user_count"] == user_count]

    for metric in available_metrics:
        direction = metric_directions[metric]

        if direction is None:
            continue

        means = subset.groupby("algorithm")[metric].mean().dropna()

        if "Ours" not in means.index:
            continue

        baseline_means = means.drop(index="Ours", errors="ignore")

        if baseline_means.empty:
            continue

        if direction == "max":
            best_baseline_algorithm = baseline_means.idxmax()
            baseline_value = baseline_means.loc[best_baseline_algorithm]
            ours_value = means.loc["Ours"]

            improvement = (
                (ours_value - baseline_value) / abs(baseline_value) * 100
                if abs(baseline_value) > 1e-12 else np.nan
            )

        else:
            best_baseline_algorithm = baseline_means.idxmin()
            baseline_value = baseline_means.loc[best_baseline_algorithm]
            ours_value = means.loc["Ours"]

            improvement = (
                (baseline_value - ours_value) / abs(baseline_value) * 100
                if abs(baseline_value) > 1e-12 else np.nan
            )

        improvement_rows.append({
            "user_count": user_count,
            "metric": metric,
            "ours_mean": ours_value,
            "best_baseline": best_baseline_algorithm,
            "best_baseline_mean": baseline_value,
            "relative_improvement_percent": improvement,
            "direction": direction,
        })

improvement_df = pd.DataFrame(improvement_rows)
improvement_file = os.path.join(
    CSV_DIR, "ours_relative_improvement_by_load.csv"
)
improvement_df.to_csv(improvement_file, index=False)

# ------------------------------------------------------------
# 6. AVERAGE PERFORMANCE ACROSS ALL USER LOADS
# ------------------------------------------------------------
overall_rows = []

for metric in available_metrics:
    direction = metric_directions[metric]

    for algorithm, values in df.groupby("algorithm"):
        overall_rows.append({
            "algorithm": algorithm,
            "metric": metric,
            "mean": values[metric].mean(),
            "std": values[metric].std(),
            "direction": direction if direction else "descriptive",
            "number_of_records": values[metric].count(),
        })

overall = pd.DataFrame(overall_rows)
overall_file = os.path.join(CSV_DIR, "overall_algorithm_summary.csv")
overall.to_csv(overall_file, index=False)

# ------------------------------------------------------------
# 7. EXCEL WORKBOOK WITH ALL TABLES
# ------------------------------------------------------------
excel_file = os.path.join(CSV_DIR, "final_manuscript_results.xlsx")

with pd.ExcelWriter(excel_file, engine="openpyxl") as writer:
    summary.to_excel(
        writer, sheet_name="Results_By_Load", index=False
