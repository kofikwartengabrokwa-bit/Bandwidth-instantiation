EPISODE_PATTERN = re.compile(
    r"Episode\s+(\d+)\s*/\s*(\d+)"
    r"\s*\|\s*Mean\s+reward\s*=\s*"
    r"([-+\d.eE]+|nan|inf|-inf)"
    r"\s*\|\s*Loss\s*=\s*"
    r"([-+\d.eE]+|nan|inf|-inf)"
    r"\s*\|\s*Epsilon\s*=\s*"
    r"([-+\d.eE]+|nan|inf|-inf)",
    flags=re.IGNORECASE,
)

ALGORITHM_PATTERN = re.compile(
    r"Algorithm\s*:\s*(.*?)\s*\|\s*Users\s*:\s*(\d+)",
    flags=re.IGNORECASE,
)

USER_LOAD_PATTERN = re.compile(
    r"TRAINING\s+FOR\s+USER\s+LOAD\s*:\s*(\d+)",
    flags=re.IGNORECASE,
)


def safe_float(value):
    """Convert a log value into a float."""

    try:
        return float(value)
    except (ValueError, TypeError):
        return np.nan


def identify_model(algorithm_name):
    """Map a logged algorithm name to the comparison label."""

    normalized = re.sub(
        r"\s+", " ", algorithm_name.strip().lower()
    )

    if normalized in MODEL_ALIASES:
        return MODEL_ALIASES[normalized]

    if "rbf" in normalized and "ddqn" in normalized:
        return "Ours"

    if "ggn" in normalized and "ddqn" in normalized:
        return "GGN-DDQN"

    if "gcn" in normalized and "ddqn" in normalized:
        return "GCN-DDQN"

    if normalized == "ddqn":
        return "DDQN"

    return None


