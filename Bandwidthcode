    "GCN-DDQN",
    "DDQN"
]

ALGORITHMS = [
    OUR_ALGORITHM,
    "GGN-DDQN",
    "GCN-DDQN",
    "DDQN"
]

USER_LOADS = [100, 200, 300, 400, 500, 600, 800, 1000]

# True means lower values are better; False means higher values are better.
METRIC_DIRECTIONS = {
    "episode_reward": False,
    "eMBB_data_rate_mbps": False,
    "uRLLC_data_rate_mbps": False,
    "eMBB_latency_ms": True,
    "uRLLC_latency_ms": True,
    "eMBB_energy_j": True,
    "uRLLC_energy_j": True,
    "eMBB_rb_allocation": None,
    "uRLLC_rb_allocation": None
}

# ------------------------------------------------------------
# 2. LOAD DATA
# ------------------------------------------------------------

if not RESULTS_FILE.exists():
    raise FileNotFoundError(
        f"Evaluation results not found: {RESULTS_FILE}"
    )

RESULTS_DF = pd.read_csv(RESULTS_FILE)

required_columns = {"algorithm", "user_count"}

if not required_columns.issubset(RESULTS_DF.columns):
    raise ValueError(
        "Evaluation CSV must contain 'algorithm' and 'user_count'."
    )

print("=" * 72)
print("BLOCK 10: PERFORMANCE SUMMARY AND ALGORITHM RANKING")
print("=" * 72)
print(f"Evaluation rows: {len(RESULTS_DF)}")

# ------------------------------------------------------------
# 3. SELECT AVAILABLE PERFORMANCE METRICS
# ------------------------------------------------------------

available_metrics = [
    metric
    for metric in METRIC_DIRECTIONS
    if metric in RESULTS_DF.columns
]

if not available_metrics:
    print("Available columns:", RESULTS_DF.columns.tolist())
    raise ValueError("No expected performance metrics were found.")

# ------------------------------------------------------------
# 4. COMPUTE MEANS AND STANDARD DEVIATIONS
# ------------------------------------------------------------

summary_rows = []

for (algorithm, user_count), group in RESULTS_DF.groupby(
    ["algorithm", "user_count"]
):
    row = {
        "algorithm": algorithm,
        "user_count": int(user_count),
        "evaluation_episodes": len(group)
    }

    for metric in available_metrics:
        values = pd.to_numeric(
            group[metric],
            errors="coerce"
        ).dropna()

        row[f"{metric}_mean"] = (
            float(values.mean()) if len(values) else np.nan
        )

        row[f"{metric}_std"] = (
            float(values.std(ddof=1))
            if len(values) > 1 else 0.0 if len(values) == 1 else np.nan
        )

    summary_rows.append(row)

PERFORMANCE_SUMMARY_DF = pd.DataFrame(summary_rows)

summary_path = CSV_DIR / "performance_summary.csv"

PERFORMANCE_SUMMARY_DF.to_csv(
    summary_path,
    index=False
)

# ------------------------------------------------------------
# 5. COMPUTE OUR IMPROVEMENT OVER THE BEST BASELINE
# ------------------------------------------------------------

improvement_rows = []

for user_count in sorted(RESULTS_DF["user_count"].unique()):

    load_summary = PERFORMANCE_SUMMARY_DF[
        PERFORMANCE_SUMMARY_DF["user_count"] == user_count
    ]

    our_rows = load_summary[
        load_summary["algorithm"] == OUR_ALGORITHM
    ]

    if our_rows.empty:
        continue

    our_row = our_rows.iloc[0]

    for metric in available_metrics:

        mean_col = f"{metric}_mean"
        direction = METRIC_DIRECTIONS[metric]

        our_value = our_row[mean_col]

        baseline_rows = load_summary[
            load_summary["algorithm"].isin(BASELINES)
        ].dropna(subset=[mean_col])

        if pd.isna(our_value) or baseline_rows.empty:
            continue

        # RB allocation is descriptive rather than inherently
        # better when larger or smaller, so no ranking is assigned.
        if direction is None:
            continue

        if direction:
            # Lower is better: select the baseline with the lowest mean.
            best_idx = baseline_rows[mean_col].idxmin()
        else:
            # Higher is better: select the baseline with the highest mean.
            best_idx = baseline_rows[mean_col].idxmax()

        best_baseline = baseline_rows.loc[best_idx]
        baseline_value = float(best_baseline[mean_col])
        our_value = float(our_value)

        if abs(baseline_value) < 1e-12:
            improvement_pct = np.nan
        elif direction:
            improvement_pct = (
                (baseline_value - our_value)
                / abs(baseline_value)
            ) * 100.0
        else:
            improvement_pct = (
                (our_value - baseline_value)
                / abs(baseline_value)
            ) * 100.0

        improvement_rows.append({
            "user_count": int(user_count),
            "metric": metric,
            "our_algorithm": OUR_ALGORITHM,
            "our_mean": our_value,
            "best_baseline": best_baseline["algorithm"],
            "best_baseline_mean": baseline_value,
            "metric_direction": (
                "lower_is_better"
                if direction else "higher_is_better"
            ),
            "relative_improvement_percent": improvement_pct
        })

IMPROVEMENT_DF = pd.DataFrame(improvement_rows)

improvement_path = CSV_DIR / "relative_improvement_summary.csv"

IMPROVEMENT_DF.to_csv(
    improvement_path,
    index=False
)

# ------------------------------------------------------------
# 6. DISPLAY PERFORMANCE RESULTS
# ------------------------------------------------------------

print("\nMean performance by algorithm and user load:")

display_columns = [
    "algorithm",
    "user_count"
] + [
    f"{metric}_mean"
    for metric in available_metrics
]

print(
    PERFORMANCE_SUMMARY_DF[display_columns]
    .sort_values(["user_count", "algorithm"])
    .to_string(index=False)
)

print("\nRelative improvement of Ours over the best baseline:")

if not IMPROVEMENT_DF.empty:
    print(
        IMPROVEMENT_DF[
            [
                "user_count",
                "metric",
                "best_baseline",
                "relative_improvement_percent"
            ]
        ].to_string(index=False)
    )
else:
    print("No improvement comparisons could be calculated.")

# ------------------------------------------------------------
# 7. SAVE FINAL REPORT
# ------------------------------------------------------------

print("\n" + "=" * 72)
print("BLOCK 10 COMPLETED")
print("=" * 72)
print(f"Performance summary: {summary_path}")
print(f"Relative improvement summary: {improvement_path}")




